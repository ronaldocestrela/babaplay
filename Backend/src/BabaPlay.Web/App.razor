@namespace BabaPlay.Web

<AuthSessionInitializer>
    <CascadingAuthenticationState>
        <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                    <NotAuthorized>
                        <LayoutView Layout="@typeof(PublicLayout)">
                            <RedirectToLogin />
                        </LayoutView>
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
            <NotFound>
                <PageTitle>Não Encontrado</PageTitle>
                <LayoutView Layout="@typeof(PublicLayout)">
                    <div class="public-card">
                        <div class="public-brand">
                            <img src="babaplayOG.png" alt="Baba Play" class="public-brand__logo" />
                        </div>
                        <p class="public-not-found">Página não encontrada.</p>
                    </div>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingAuthenticationState>
</AuthSessionInitializer>
