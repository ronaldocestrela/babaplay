@page "/auth/forgot-password"
@attribute [AllowAnonymous]
@layout PublicLayout
@inject IAuthApiService AuthApiService
@inject NavigationManager NavigationManager

<PageTitle>Recuperar Senha - Baba Play</PageTitle>

<div class="auth-container min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 bg-slate-900 text-white">
    <div class="max-w-md w-full space-y-8 bg-slate-800/80 p-8 rounded-2xl border border-slate-700 shadow-2xl backdrop-blur-md">
        <div class="text-center">
            <h1 class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-200">
                Recuperação de Senha
            </h1>
            <p class="mt-2 text-sm text-slate-400">
                Informe o seu e-mail cadastrado para receber o link de redefinição de senha.
            </p>
        </div>

        @if (isSuccess)
        {
            <div id="forgot-success-alert" class="p-4 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-sm flex items-start gap-3">
                <svg class="w-6 h-6 shrink-0 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <div>
                    <h4 class="font-bold">E-mail enviado com sucesso!</h4>
                    <p class="mt-1">Se houver uma conta associada a este e-mail, você receberá as instruções para cadastrar uma nova senha.</p>
                </div>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div id="forgot-error-alert" class="p-4 rounded-lg bg-rose-500/10 border border-rose-500/30 text-rose-300 text-sm flex items-center gap-2">
                    <svg class="w-5 h-5 shrink-0 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>@errorMessage</span>
                </div>
            }

            <EditForm Model="@forgotModel" OnValidSubmit="HandleForgotPasswordAsync" id="forgot-password-form">
                <DataAnnotationsValidator />

                <div class="space-y-4">
                    <div>
                        <label for="email-input" class="block text-sm font-medium text-slate-300 mb-1">E-mail Cadastrado</label>
                        <InputText id="email-input" @bind-Value="forgotModel.Email" class="w-full px-4 py-2.5 bg-slate-900/90 border border-slate-700 rounded-lg text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all" placeholder="seu@email.com" />
                        <ValidationMessage For="@(() => forgotModel.Email)" class="text-rose-400 text-xs mt-1" />
                    </div>
                </div>

                <button type="submit" id="forgot-submit-button" disabled="@isLoading" class="w-full mt-6 py-3 px-4 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-slate-950 font-bold rounded-lg shadow-lg hover:shadow-emerald-500/25 transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2">
                    @if (isLoading)
                    {
                        <svg class="animate-spin h-5 w-5 text-slate-950" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Enviando...</span>
                    }
                    else
                    {
                        <span>Enviar Link de Recuperação</span>
                    }
                </button>
            </EditForm>
        }

        <div class="text-center pt-4 border-t border-slate-700/50">
            <a href="/auth/login" id="back-to-login-link" class="text-sm text-emerald-400 hover:text-emerald-300 font-medium transition-colors">Voltar para o Login</a>
        </div>
    </div>
</div>

@code {
    private ForgotPasswordDto forgotModel = new();
    private bool isLoading = false;
    private bool isSuccess = false;
    private string? errorMessage;

    private async Task HandleForgotPasswordAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            forgotModel.ResetLinkBaseUrl = $"{NavigationManager.BaseUri}auth/reset-password";
            var success = await AuthApiService.ForgotPasswordAsync(forgotModel);
            if (success)
            {
                isSuccess = true;
            }
            else
            {
                errorMessage = "Não foi possível processar a solicitação. Verifique o e-mail informado.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Erro inesperado ao solicitar recuperação de senha.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
