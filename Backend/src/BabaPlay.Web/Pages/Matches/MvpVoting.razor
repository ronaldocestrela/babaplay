@page "/matches/{matchId:guid}/mvp"
@page "/matches/mvp"
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@using BabaPlay.Web.Components.Matches
@inject IMatchApiService MatchApiService

<PageTitle>Votação Craque do Jogo (MVP) - Baba Play</PageTitle>

<div class="container-fluid py-4" data-testid="mvp-voting-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 mb-1 font-weight-bold text-gradient">Votação do Craque do Jogo (MVP) ⭐</h1>
            <p class="text-muted mb-0">Vote no atleta que mais se destacou na partida de hoje. Cada atleta tem direito a 1 voto.</p>
        </div>
        <button class="btn btn-outline-primary btn-sm" @onclick="LoadMvpDataAsync" data-testid="btn-refresh-mvp">
            <i class="bi bi-arrow-clockwise me-1"></i> Atualizar Votação
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(AlertMessage))
    {
        <div class="alert @(IsAlertError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-4" role="alert" data-testid="alert-banner">
            <i class="bi @(IsAlertError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>
            @AlertMessage
            <button type="button" class="btn-close" @onclick="() => AlertMessage = null"></button>
        </div>
    }

    @if (IsLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <LoadingSpinner Message="Carregando votação do Craque do Jogo..." />
        </div>
    }
    else if (ResultData == null || ResultData.Candidates.Count == 0)
    {
        <div class="card card-custom py-5 text-center my-4" data-testid="empty-mvp-state">
            <div class="card-body">
                <i class="bi bi-star display-4 text-muted mb-3 d-block"></i>
                <h4 class="h5 font-weight-bold">Votação Indisponível</h4>
                <p class="text-muted mb-0">Ainda não há estatísticas ou atletas elegíveis nesta partida.</p>
            </div>
        </div>
    }
    else
    {
        <MvpLeaderboardWidget Candidates="ResultData.Candidates" TotalVotes="ResultData.TotalVotes" />

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3" data-testid="candidates-grid">
            @foreach (var candidate in ResultData.Candidates)
            {
                <div class="col" key="@candidate.PlayerId">
                    <MvpCandidateCard Candidate="candidate"
                                      IsUserVoted="ResultData.UserVotedPlayerId.HasValue"
                                      IsUserChoice="ResultData.UserVotedPlayerId == candidate.PlayerId"
                                      OnVote="SubmitVoteAsync" />
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid MatchId { get; set; }

    private MvpResultDto? ResultData { get; set; }
    private Guid CurrentUserId { get; set; } = Guid.NewGuid();
    private bool IsLoading { get; set; } = true;
    private string? AlertMessage { get; set; }
    private bool IsAlertError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (MatchId == Guid.Empty)
        {
            var matches = await MatchApiService.GetMatchesAsync();
            if (matches.Count > 0)
            {
                MatchId = matches[0].Id;
            }
        }

        await LoadMvpDataAsync();
    }

    private async Task LoadMvpDataAsync()
    {
        IsLoading = true;
        try
        {
            if (MatchId != Guid.Empty)
            {
                ResultData = await MatchApiService.GetMvpResultsAsync(MatchId);
            }

            if (ResultData == null)
            {
                // Fallback mock data
                var candidates = new List<MvpCandidateDto>
                {
                    new(Guid.NewGuid(), "Zico Santos", null, "Meia", "Time Amarelo 🟡", 2, 1, 8, 40.0, false),
                    new(Guid.NewGuid(), "Romário Farias", null, "Atacante", "Time Azul 🔵", 1, 2, 6, 30.0, false),
                    new(Guid.NewGuid(), "Pelé Nascimento", null, "Atacante", "Time Amarelo 🟡", 1, 0, 4, 20.0, false),
                    new(CurrentUserId, "Usuário Logado", null, "Goleiro", "Time Azul 🔵", 0, 0, 2, 10.0, true)
                };

                ResultData = new MvpResultDto(MatchId, 20, true, null, "Zico Santos", candidates);
            }
        }
        catch (Exception ex)
        {
            SetAlert($"Erro ao carregar votação: {ex.Message}", isError: true);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SubmitVoteAsync(MvpCandidateDto candidate)
    {
        if (ResultData == null || MatchId == Guid.Empty) return;

        if (candidate.IsUserCandidate)
        {
            SetAlert("Você não pode votar em si mesmo para Craque do Jogo.", isError: true);
            return;
        }

        var dto = new SubmitMvpVoteDto(MatchId, CurrentUserId, candidate.PlayerId);
        var (success, error) = await MatchApiService.SubmitMvpVoteAsync(MatchId, dto);

        if (success)
        {
            // Atualizar contagem localmente
            candidate = candidate with { VotesCount = candidate.VotesCount + 1 };
            ResultData = ResultData with { UserVotedPlayerId = candidate.PlayerId, TotalVotes = ResultData.TotalVotes + 1 };
            SetAlert($"Seu voto para '{candidate.Name}' como Craque do Jogo foi registrado com sucesso! ⭐");
            await LoadMvpDataAsync();
        }
        else
        {
            SetAlert(error ?? "Falha ao computar seu voto.", isError: true);
        }
    }

    private void SetAlert(string message, bool isError = false)
    {
        AlertMessage = message;
        IsAlertError = isError;
    }
}
