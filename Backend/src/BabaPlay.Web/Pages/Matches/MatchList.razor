@page "/matches"
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@using BabaPlay.Web.Components.Matches
@inject IMatchApiService MatchApiService

<PageTitle>Calendário de Partidas & Babas - Baba Play</PageTitle>

<div class="container-fluid py-4" data-testid="match-list-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 mb-1 font-weight-bold text-gradient">Calendário de Partidas & Babas</h1>
            <p class="text-muted mb-0">Agende, acompanhe e gerencie os jogos e eventos esportivos da associação.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" @onclick="OpenCreateModal" data-testid="btn-add-match">
                <i class="bi bi-calendar-plus me-1"></i> Agendar Novo Baba
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(AlertMessage))
    {
        <div class="alert @(IsAlertError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-4" role="alert" data-testid="alert-banner">
            <i class="bi @(IsAlertError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>
            @AlertMessage
            <button type="button" class="btn-close" @onclick="() => AlertMessage = null"></button>
        </div>
    }

    <!-- Filtros de Status & Busca -->
    <div class="card card-custom p-3 mb-4 shadow-sm">
        <div class="row align-items-center g-3">
            <div class="col-md-6">
                <div class="nav nav-pills" data-testid="status-filter-tabs">
                    <button class="nav-link @(SelectedStatusFilter == null ? "active" : "") me-1" @onclick="SelectFilterAll">Todos</button>
                    <button class="nav-link @(SelectedStatusFilter == "Confirmed" ? "active" : "") me-1" @onclick="SelectFilterConfirmed">Agendados</button>
                    <button class="nav-link @(SelectedStatusFilter == "Completed" ? "active" : "") me-1" @onclick="SelectFilterCompleted">Concluídos</button>
                    <button class="nav-link @(SelectedStatusFilter == "Cancelled" ? "active" : "")" @onclick="SelectFilterCancelled">Cancelados</button>
                </div>


            </div>
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Buscar por nome do evento ou local..." @bind="SearchTerm" @bind:event="oninput" data-testid="input-search-match" />
                </div>
            </div>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <LoadingSpinner Message="Carregando calendário de partidas..." />
        </div>
    }
    else if (FilteredMatches.Count == 0)
    {
        <div class="card card-custom py-5 text-center my-4" data-testid="empty-matches-state">
            <div class="card-body">
                <i class="bi bi-calendar-x display-4 text-muted mb-3 d-block"></i>
                <h4 class="h5 font-weight-bold">Nenhum baba ou partida encontrada</h4>
                <p class="text-muted mb-3">Não há eventos esportivos cadastrados para o filtro selecionado.</p>
                <button class="btn btn-outline-primary" @onclick="OpenCreateModal">
                    <i class="bi bi-calendar-plus me-1"></i> Agendar Primeira Partida
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4" data-testid="matches-grid">
            @foreach (var match in FilteredMatches)
            {
                <div class="col" key="@match.Id">
                    <MatchCard Match="match"
                               OnEdit="OpenEditModal"
                               OnChangeStatus="ConfirmChangeStatusAsync"
                               OnDelete="ConfirmDeleteAsync" />
                </div>
            }
        </div>
    }
</div>

<MatchModal IsOpen="IsModalOpen"
            IsEditing="IsEditing"
            Model="ModalModel"
            OnSave="HandleSaveModalAsync"
            OnClose="CloseModal" />

@code {
    private List<MatchDto> Matches { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private string? AlertMessage { get; set; }
    private bool IsAlertError { get; set; }
    private string? SelectedStatusFilter { get; set; }
    private string SearchTerm { get; set; } = string.Empty;

    private bool IsModalOpen { get; set; }
    private bool IsEditing { get; set; }
    private Guid? SelectedGameDayId { get; set; }
    private ScheduleGameDayDto ModalModel { get; set; } = new();

    private IReadOnlyList<MatchDto> FilteredMatches => Matches
        .Where(m => string.IsNullOrWhiteSpace(SelectedStatusFilter) || string.Equals(m.Status, SelectedStatusFilter, StringComparison.OrdinalIgnoreCase))
        .Where(m => string.IsNullOrWhiteSpace(SearchTerm) ||
                    (m.GameDayName?.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (m.Location?.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
        .OrderByDescending(m => m.ScheduledAt)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadMatchesAsync();
    }

    private async Task LoadMatchesAsync()
    {
        IsLoading = true;
        try
        {
            var gameDays = await MatchApiService.GetGameDaysAsync();
            var result = new List<MatchDto>();

            foreach (var gd in gameDays)
            {
                result.Add(new MatchDto(
                    gd.Id,
                    gd.Id,
                    gd.Name,
                    gd.ScheduledAt,
                    gd.Location,
                    gd.Description,
                    null,
                    null,
                    gd.Status,
                    gd.MaxPlayers,
                    14
                ));
            }

            Matches = result;
        }
        catch (Exception ex)
        {
            SetAlert($"Erro ao carregar agendamentos: {ex.Message}", isError: true);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void FilterByStatus(string? status)
    {
        SelectedStatusFilter = status;
    }

    private void SelectFilterAll() => FilterByStatus(null);
    private void SelectFilterConfirmed() => FilterByStatus("Confirmed");
    private void SelectFilterCompleted() => FilterByStatus("Completed");
    private void SelectFilterCancelled() => FilterByStatus("Cancelled");


    private void OpenCreateModal()
    {
        IsEditing = false;
        SelectedGameDayId = null;
        ModalModel = new ScheduleGameDayDto
        {
            ScheduledAt = DateTime.Now.AddDays(1),
            MaxPlayers = 20
        };
        IsModalOpen = true;
    }

    private void OpenEditModal(MatchDto match)
    {
        IsEditing = true;
        SelectedGameDayId = match.GameDayId;
        ModalModel = new ScheduleGameDayDto
        {
            Name = match.GameDayName ?? string.Empty,
            ScheduledAt = match.ScheduledAt,
            Location = match.Location ?? string.Empty,
            Description = match.Description,
            MaxPlayers = match.MaxPlayers
        };
        IsModalOpen = true;
    }

    private void CloseModal()
    {
        IsModalOpen = false;
        SelectedGameDayId = null;
    }

    private async Task HandleSaveModalAsync(ScheduleGameDayDto dto)
    {
        if (IsEditing && SelectedGameDayId.HasValue)
        {
            var (success, error) = await MatchApiService.UpdateGameDayAsync(SelectedGameDayId.Value, dto);
            if (success)
            {
                CloseModal();
                SetAlert("Agendamento atualizado com sucesso!");
                await LoadMatchesAsync();
            }
            else
            {
                SetAlert(error ?? "Erro ao atualizar agendamento.", isError: true);
            }
        }
        else
        {
            var (success, error) = await MatchApiService.CreateGameDayAsync(dto);
            if (success)
            {
                CloseModal();
                SetAlert("Partida/Baba agendado com sucesso!");
                await LoadMatchesAsync();
            }
            else
            {
                SetAlert(error ?? "Erro ao agendar baba.", isError: true);
            }
        }
    }

    private async Task ConfirmChangeStatusAsync(MatchDto match)
    {
        var newStatus = match.Status == "Completed" ? "Confirmed" : "Completed";
        var (success, error) = await MatchApiService.ChangeMatchStatusAsync(match.Id, newStatus);
        if (success)
        {
            SetAlert($"Status do baba '{match.GameDayName}' alterado para {newStatus}.");
            await LoadMatchesAsync();
        }
        else
        {
            SetAlert(error ?? "Não foi possível alterar o status.", isError: true);
        }
    }

    private async Task ConfirmDeleteAsync(MatchDto match)
    {
        var (success, error) = await MatchApiService.DeleteGameDayAsync(match.GameDayId);
        if (success)
        {
            SetAlert($"Agendamento '{match.GameDayName}' excluído com sucesso.");
            await LoadMatchesAsync();
        }
        else
        {
            SetAlert(error ?? "Não foi possível excluir a partida.", isError: true);
        }
    }

    private void SetAlert(string message, bool isError = false)
    {
        AlertMessage = message;
        IsAlertError = isError;
    }
}
