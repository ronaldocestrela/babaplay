@page "/matches/{gameDayId:guid}/rsvp"
@page "/rsvp"
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@using BabaPlay.Web.Components.Matches
@inject ICheckinApiService CheckinApiService
@inject IMatchApiService MatchApiService

<PageTitle>RSVP & Check-in - Baba Play</PageTitle>

<div class="container-fluid py-4" data-testid="match-checkin-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 font-weight-bold text-gradient">Confirmação de Presença & Check-in</h1>
            <p class="text-muted mb-0">Confirme se você vai jogar no próximo baba ou faça o check-in presencial no campo.</p>
        </div>
        <button class="btn btn-outline-primary btn-sm" @onclick="LoadRsvpDataAsync" data-testid="btn-refresh-rsvp">
            <i class="bi bi-arrow-clockwise me-1"></i> Atualizar
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(AlertMessage))
    {
        <div class="alert @(IsAlertError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-4" role="alert" data-testid="alert-banner">
            <i class="bi @(IsAlertError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>
            @AlertMessage
            <button type="button" class="btn-close" @onclick="() => AlertMessage = null"></button>
        </div>
    }

    @if (IsLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <LoadingSpinner Message="Carregando informações de presença..." />
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-5 mb-4">
                <RsvpStatusWidget Summary="RsvpSummary" OnRsvpSubmitted="HandleRsvpSubmittedAsync" />

                <div class="card card-custom p-3 shadow-sm mb-4">
                    <h4 class="h6 font-weight-bold mb-2">📍 Check-in Presencial no Campo</h4>
                    <p class="small text-muted mb-3">No dia do jogo, confirme sua presença física via GPS para validação de frequência.</p>
                    <button class="btn btn-outline-primary w-100 font-weight-bold btn-geo-checkin" @onclick="PerformGeoCheckinAsync" data-testid="btn-geo-checkin">
                        <i class="bi bi-geo-alt-fill me-1"></i> Confirmar Presença Física via GPS
                    </button>
                </div>
            </div>

            <div class="col-lg-7 mb-4">
                <CheckinListWidget RsvpList="RsvpList" />
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid GameDayId { get; set; }

    private GameDayRsvpSummaryDto? RsvpSummary { get; set; }
    private List<PlayerRsvpDetailDto> RsvpList { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private string? AlertMessage { get; set; }
    private bool IsAlertError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (GameDayId == Guid.Empty)
        {
            var gameDays = await MatchApiService.GetGameDaysAsync("Confirmed");
            if (gameDays.Count > 0)
            {
                GameDayId = gameDays[0].Id;
            }
        }

        await LoadRsvpDataAsync();
    }

    private async Task LoadRsvpDataAsync()
    {
        IsLoading = true;
        try
        {
            if (GameDayId != Guid.Empty)
            {
                RsvpSummary = await CheckinApiService.GetGameDayRsvpSummaryAsync(GameDayId);
                var list = await CheckinApiService.GetRsvpListByGameDayAsync(GameDayId);
                RsvpList = list.ToList();
            }
            else
            {
                RsvpSummary = null;
                RsvpList = new List<PlayerRsvpDetailDto>();
            }
        }
        catch (Exception ex)
        {
            SetAlert($"Erro ao carregar RSVP: {ex.Message}", isError: true);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task HandleRsvpSubmittedAsync(bool isAttending)
    {
        if (GameDayId == Guid.Empty) return;

        var dto = new RsvpSubmissionDto(GameDayId, Guid.NewGuid(), isAttending);
        var (success, error, updatedSummary) = await CheckinApiService.SubmitRsvpAsync(dto);

        if (success)
        {
            RsvpSummary = updatedSummary;
            SetAlert(isAttending ? "Presença confirmada no baba!" : "Ausência registrada com sucesso.");
            await LoadRsvpDataAsync();
        }
        else
        {
            SetAlert(error ?? "Falha ao registrar confirmação.", isError: true);
        }
    }

    private async Task PerformGeoCheckinAsync()
    {
        if (GameDayId == Guid.Empty) return;

        var dto = new CreateCheckinDto(Guid.NewGuid(), GameDayId, DateTime.UtcNow, -12.9714, -38.5014);
        var (success, error) = await CheckinApiService.CreateCheckinAsync(dto);

        if (success)
        {
            SetAlert("Check-in presencial realizado com sucesso via GPS!");
            await LoadRsvpDataAsync();
        }
        else
        {
            SetAlert(error ?? "Falha ao realizar check-in presencial.", isError: true);
        }
    }

    private void SetAlert(string message, bool isError = false)
    {
        AlertMessage = message;
        IsAlertError = isError;
    }
}
