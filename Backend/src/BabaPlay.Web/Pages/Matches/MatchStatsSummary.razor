@page "/matches/{matchId:guid}/stats"
@page "/matches/stats"
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@using BabaPlay.Web.Components.Matches
@inject IMatchApiService MatchApiService

<PageTitle>Súmula Pós-Jogo & Estatísticas - Baba Play</PageTitle>

<div class="container-fluid py-4" data-testid="match-stats-summary-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 mb-1 font-weight-bold text-gradient">Súmula Pós-Jogo & Estatísticas em Tempo Real</h1>
            <p class="text-muted mb-0">Registre os gols, assistências, cartões e encerre a partida com atualização oficial.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-success font-weight-bold btn-save-stats" @onclick="SaveStatsAsync" data-testid="btn-save-stats">
                <i class="bi bi-journal-check me-1"></i> Finalizar e Salvar Súmula
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(AlertMessage))
    {
        <div class="alert @(IsAlertError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-4" role="alert" data-testid="alert-banner">
            <i class="bi @(IsAlertError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>
            @AlertMessage
            <button type="button" class="btn-close" @onclick="() => AlertMessage = null"></button>
        </div>
    }

    @if (IsLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <LoadingSpinner Message="Carregando súmula da partida..." />
        </div>
    }
    else
    {
        <ScoreboardWidget Scoreboard="Scoreboard" />

        <div class="row">
            <!-- Tabela Time Mandante -->
            <div class="col-lg-6 mb-4">
                <div class="card card-custom p-3 shadow-sm">
                    <h3 class="h6 font-weight-bold text-warning mb-3" data-testid="home-team-title">
                        🟡 @(Scoreboard?.HomeTeamName ?? "Time Mandante")
                    </h3>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" data-testid="home-team-table">
                            <thead class="table-light">
                                <tr>
                                    <th>Atleta</th>
                                    <th class="text-center">Gols</th>
                                    <th class="text-center">Assist.</th>
                                    <th class="text-center">Amarelo</th>
                                    <th class="text-center">Vermelho</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var player in HomePlayers)
                                {
                                    <PlayerStatsRow Stats="player" OnStatsChanged="HandlePlayerStatsChanged" />
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Tabela Time Visitante -->
            <div class="col-lg-6 mb-4">
                <div class="card card-custom p-3 shadow-sm">
                    <h3 class="h6 font-weight-bold text-info mb-3" data-testid="away-team-title">
                        🔵 @(Scoreboard?.AwayTeamName ?? "Time Visitante")
                    </h3>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" data-testid="away-team-table">
                            <thead class="table-light">
                                <tr>
                                    <th>Atleta</th>
                                    <th class="text-center">Gols</th>
                                    <th class="text-center">Assist.</th>
                                    <th class="text-center">Amarelo</th>
                                    <th class="text-center">Vermelho</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var player in AwayPlayers)
                                {
                                    <PlayerStatsRow Stats="player" OnStatsChanged="HandlePlayerStatsChanged" />
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid MatchId { get; set; }

    private MatchScoreboardDto Scoreboard { get; set; } = null!;
    private List<PlayerMatchStatsDto> PlayerStats { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private string? AlertMessage { get; set; }
    private bool IsAlertError { get; set; }

    private IEnumerable<PlayerMatchStatsDto> HomePlayers => PlayerStats.Where(p => p.TeamId == Scoreboard?.HomeTeamId);
    private IEnumerable<PlayerMatchStatsDto> AwayPlayers => PlayerStats.Where(p => p.TeamId == Scoreboard?.AwayTeamId);

    protected override async Task OnInitializedAsync()
    {
        if (MatchId == Guid.Empty)
        {
            var matches = await MatchApiService.GetMatchesAsync();
            if (matches.Count > 0)
            {
                MatchId = matches[0].Id;
            }
        }

        await LoadStatsAsync();
    }

    private async Task LoadStatsAsync()
    {
        IsLoading = true;
        try
        {
            var homeTeamId = Guid.NewGuid();
            var awayTeamId = Guid.NewGuid();

            Scoreboard = new MatchScoreboardDto(
                MatchId != Guid.Empty ? MatchId : Guid.NewGuid(),
                homeTeamId,
                "Time Amarelo 🟡",
                awayTeamId,
                "Time Azul 🔵",
                0,
                0,
                "Em Andamento"
            );

            PlayerStats = new List<PlayerMatchStatsDto>
            {
                new(Guid.NewGuid(), "Zico Santos", null, homeTeamId, 0, 0, 0, 0, 0),
                new(Guid.NewGuid(), "Pelé Nascimento", null, homeTeamId, 0, 0, 0, 0, 0),
                new(Guid.NewGuid(), "Romário Farias", null, awayTeamId, 0, 0, 0, 0, 0),
                new(Guid.NewGuid(), "Ronaldo Nazário", null, awayTeamId, 0, 0, 0, 0, 0)
            };

            RecalculateScoreboard();
        }
        catch (Exception ex)
        {
            SetAlert($"Erro ao carregar súmula: {ex.Message}", isError: true);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void HandlePlayerStatsChanged(PlayerMatchStatsDto updatedPlayer)
    {
        var index = PlayerStats.FindIndex(p => p.PlayerId == updatedPlayer.PlayerId);
        if (index != -1)
        {
            PlayerStats[index] = updatedPlayer;
            RecalculateScoreboard();
        }
    }

    private void RecalculateScoreboard()
    {
        if (Scoreboard == null) return;

        var homeScore = HomePlayers.Sum(p => p.Goals);
        var awayScore = AwayPlayers.Sum(p => p.Goals);

        Scoreboard = Scoreboard with { HomeScore = homeScore, AwayScore = awayScore };
    }

    private async Task SaveStatsAsync()
    {
        if (Scoreboard == null) return;

        var dto = new RegisterMatchStatsDto(Scoreboard.MatchId, Scoreboard.HomeScore, Scoreboard.AwayScore, PlayerStats);
        var (success, error) = await MatchApiService.RegisterMatchStatsAsync(Scoreboard.MatchId, dto);

        if (success)
        {
            Scoreboard = Scoreboard with { Status = "Concluído" };
            SetAlert("Súmula pós-jogo registrada com sucesso!");
        }
        else
        {
            SetAlert(error ?? "Erro ao salvar súmula.", isError: true);
        }
    }

    private void SetAlert(string message, bool isError = false)
    {
        AlertMessage = message;
        IsAlertError = isError;
    }
}
