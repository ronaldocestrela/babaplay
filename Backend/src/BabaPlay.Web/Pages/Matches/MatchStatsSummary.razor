@page "/matches/{matchId:guid}/stats"
@page "/matches/stats"
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@using BabaPlay.Web.Components.Matches
@inject IMatchApiService MatchApiService
@inject ITeamApiService TeamApiService
@inject ICheckinApiService CheckinApiService
@inject IPlayerApiService PlayerApiService

<PageTitle>Súmula Pós-Jogo & Estatísticas - Baba Play</PageTitle>

<div class="container-fluid py-4" data-testid="match-stats-summary-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 mb-1 font-weight-bold text-gradient">Súmula Pós-Jogo & Estatísticas em Tempo Real</h1>
            <p class="text-muted mb-0">Registre os gols, assistências, cartões e encerre a partida com atualização oficial.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-success font-weight-bold btn-save-stats" @onclick="SaveStatsAsync" data-testid="btn-save-stats">
                <i class="bi bi-journal-check me-1"></i> Finalizar e Salvar Súmula
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(AlertMessage))
    {
        <div class="alert @(IsAlertError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-4" role="alert" data-testid="alert-banner">
            <i class="bi @(IsAlertError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>
            @AlertMessage
            <button type="button" class="btn-close" @onclick="() => AlertMessage = null"></button>
        </div>
    }

    @if (IsLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <LoadingSpinner Message="Carregando súmula da partida..." />
        </div>
    }
    else
    {
        <ScoreboardWidget Scoreboard="Scoreboard" />

        <div class="row">
            <!-- Tabela Time Mandante -->
            <div class="col-lg-6 mb-4">
                <div class="card card-custom p-3 shadow-sm">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="h6 font-weight-bold text-warning mb-0" data-testid="home-team-title">
                            🟡 @(Scoreboard?.HomeTeamName ?? "Time Mandante")
                        </h3>
                        <span class="badge bg-warning text-dark">@HomePlayers.Count() atletas</span>
                    </div>

                    @if (AvailablePlayers.Count > 0)
                    {
                        <div class="input-group input-group-sm mb-3">
                            <select class="form-select form-select-sm" @bind="SelectedHomePlayerId" data-testid="select-add-home-player">
                                <option value="@Guid.Empty">-- Adicionar atleta ao time mandante --</option>
                                @foreach (var player in AvailablePlayers)
                                {
                                    <option value="@player.Id">@player.Name</option>
                                }
                            </select>
                            <button class="btn btn-outline-warning btn-sm"
                                    @onclick="() => AddPlayerToTeam(SelectedHomePlayerId, Scoreboard.HomeTeamId)"
                                    disabled="@(SelectedHomePlayerId == Guid.Empty)"
                                    data-testid="btn-add-home-player">
                                <i class="bi bi-person-plus-fill me-1"></i> Adicionar
                            </button>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" data-testid="home-team-table">
                            <thead class="table-light">
                                <tr>
                                    <th>Atleta</th>
                                    <th class="text-center">Gols</th>
                                    <th class="text-center">Assist.</th>
                                    <th class="text-center">Amarelo</th>
                                    <th class="text-center">Vermelho</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!HomePlayers.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-3">
                                            Nenhum atleta escalado neste time. Selecione acima para adicionar.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var player in HomePlayers)
                                    {
                                        <PlayerStatsRow Stats="player" OnStatsChanged="HandlePlayerStatsChanged" />
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Tabela Time Visitante -->
            <div class="col-lg-6 mb-4">
                <div class="card card-custom p-3 shadow-sm">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="h6 font-weight-bold text-info mb-0" data-testid="away-team-title">
                            🔵 @(Scoreboard?.AwayTeamName ?? "Time Visitante")
                        </h3>
                        <span class="badge bg-info text-dark">@AwayPlayers.Count() atletas</span>
                    </div>

                    @if (AvailablePlayers.Count > 0)
                    {
                        <div class="input-group input-group-sm mb-3">
                            <select class="form-select form-select-sm" @bind="SelectedAwayPlayerId" data-testid="select-add-away-player">
                                <option value="@Guid.Empty">-- Adicionar atleta ao time visitante --</option>
                                @foreach (var player in AvailablePlayers)
                                {
                                    <option value="@player.Id">@player.Name</option>
                                }
                            </select>
                            <button class="btn btn-outline-info btn-sm"
                                    @onclick="() => AddPlayerToTeam(SelectedAwayPlayerId, Scoreboard.AwayTeamId)"
                                    disabled="@(SelectedAwayPlayerId == Guid.Empty)"
                                    data-testid="btn-add-away-player">
                                <i class="bi bi-person-plus-fill me-1"></i> Adicionar
                            </button>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" data-testid="away-team-table">
                            <thead class="table-light">
                                <tr>
                                    <th>Atleta</th>
                                    <th class="text-center">Gols</th>
                                    <th class="text-center">Assist.</th>
                                    <th class="text-center">Amarelo</th>
                                    <th class="text-center">Vermelho</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!AwayPlayers.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-3">
                                            Nenhum atleta escalado neste time. Selecione acima para adicionar.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var player in AwayPlayers)
                                    {
                                        <PlayerStatsRow Stats="player" OnStatsChanged="HandlePlayerStatsChanged" />
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid MatchId { get; set; }

    private MatchScoreboardDto Scoreboard { get; set; } = null!;
    private List<PlayerMatchStatsDto> PlayerStats { get; set; } = new();
    private IReadOnlyList<PlayerDto> AllTenantPlayers { get; set; } = Array.Empty<PlayerDto>();
    private Guid SelectedHomePlayerId { get; set; } = Guid.Empty;
    private Guid SelectedAwayPlayerId { get; set; } = Guid.Empty;
    private bool IsLoading { get; set; } = true;
    private string? AlertMessage { get; set; }
    private bool IsAlertError { get; set; }

    private IEnumerable<PlayerMatchStatsDto> HomePlayers => PlayerStats.Where(p => p.TeamId == Scoreboard?.HomeTeamId);
    private IEnumerable<PlayerMatchStatsDto> AwayPlayers => PlayerStats.Where(p => p.TeamId == Scoreboard?.AwayTeamId);
    private List<PlayerDto> AvailablePlayers => AllTenantPlayers
        .Where(p => p.IsActive && !PlayerStats.Any(ps => ps.PlayerId == p.Id))
        .OrderBy(p => p.Name)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (MatchId == Guid.Empty)
        {
            var matches = await MatchApiService.GetMatchesAsync();
            if (matches.Count > 0)
            {
                MatchId = matches[0].Id;
            }
        }

        await LoadStatsAsync();
    }

    private async Task LoadStatsAsync()
    {
        IsLoading = true;
        try
        {
            try
            {
                AllTenantPlayers = (await PlayerApiService.GetPlayersAsync()) ?? Array.Empty<PlayerDto>();
            }
            catch
            {
                AllTenantPlayers = Array.Empty<PlayerDto>();
            }

            var homeTeamId = Guid.NewGuid();
            var awayTeamId = Guid.NewGuid();
            var homeTeamName = "Time Amarelo 🟡";
            var awayTeamName = "Time Azul 🔵";

            MatchDto? matchInfo = null;
            if (MatchId != Guid.Empty)
            {
                try
                {
                    matchInfo = await MatchApiService.GetMatchByIdAsync(MatchId);
                }
                catch
                {
                    matchInfo = null;
                }
            }

            if (matchInfo != null)
            {
                if (!string.IsNullOrWhiteSpace(matchInfo.HomeTeamName)) homeTeamName = matchInfo.HomeTeamName;
                if (!string.IsNullOrWhiteSpace(matchInfo.AwayTeamName)) awayTeamName = matchInfo.AwayTeamName;
            }

            var loadedPlayers = new List<PlayerMatchStatsDto>();

            RegisterMatchStatsDto? existingStats = null;
            if (MatchId != Guid.Empty)
            {
                try
                {
                    existingStats = await MatchApiService.GetMatchStatsAsync(MatchId);
                }
                catch
                {
                    existingStats = null;
                }
            }

            if (existingStats != null && existingStats.PlayerStats.Count > 0)
            {
                loadedPlayers = existingStats.PlayerStats.ToList();
                var firstTeamId = loadedPlayers.FirstOrDefault()?.TeamId ?? homeTeamId;
                var secondTeamId = loadedPlayers.FirstOrDefault(p => p.TeamId != firstTeamId)?.TeamId ?? awayTeamId;

                Scoreboard = new MatchScoreboardDto(
                    MatchId,
                    firstTeamId,
                    homeTeamName,
                    secondTeamId,
                    awayTeamName,
                    existingStats.HomeScore,
                    existingStats.AwayScore,
                    "Concluído"
                );
            }
            else
            {
                var gameDayId = matchInfo?.GameDayId ?? MatchId;

                DrawResultDto? drawnTeams = null;
                if (gameDayId != Guid.Empty)
                {
                    try
                    {
                        drawnTeams = await TeamApiService.GetTeamsByGameDayAsync(gameDayId);
                    }
                    catch
                    {
                        drawnTeams = null;
                    }
                }

                if (drawnTeams != null && drawnTeams.Teams.Count >= 2)
                {
                    var t1 = drawnTeams.Teams[0];
                    var t2 = drawnTeams.Teams[1];
                    homeTeamId = t1.TeamId;
                    homeTeamName = t1.Name;
                    awayTeamId = t2.TeamId;
                    awayTeamName = t2.Name;

                    foreach (var p in t1.Players)
                    {
                        loadedPlayers.Add(new PlayerMatchStatsDto(p.PlayerId, p.Name, p.PhotoUrl, homeTeamId));
                    }
                    foreach (var p in t2.Players)
                    {
                        loadedPlayers.Add(new PlayerMatchStatsDto(p.PlayerId, p.Name, p.PhotoUrl, awayTeamId));
                    }
                }
                else
                {
                    IReadOnlyList<CheckinDto> checkins = Array.Empty<CheckinDto>();
                    if (gameDayId != Guid.Empty)
                    {
                        try
                        {
                            checkins = (await CheckinApiService.GetCheckinsByGameDayAsync(gameDayId)) ?? Array.Empty<CheckinDto>();
                        }
                        catch
                        {
                            checkins = Array.Empty<CheckinDto>();
                        }
                    }

                    var realPlayersToAllocate = new List<(Guid Id, string Name, string? Photo)>();

                    if (checkins != null && checkins.Count > 0)
                    {
                        foreach (var c in checkins)
                        {
                            var athlete = AllTenantPlayers.FirstOrDefault(p => p.Id == c.PlayerId);
                            var name = athlete?.Name ?? (!string.IsNullOrWhiteSpace(c.PlayerName) ? c.PlayerName : "Atleta");
                            realPlayersToAllocate.Add((c.PlayerId, name, athlete?.PhotoUrl));
                        }
                    }
                    else if (AllTenantPlayers != null && AllTenantPlayers.Count > 0)
                    {
                        foreach (var athlete in AllTenantPlayers.Where(p => p.IsActive))
                        {
                            realPlayersToAllocate.Add((athlete.Id, athlete.Name, athlete.PhotoUrl));
                        }
                    }

                    for (int i = 0; i < realPlayersToAllocate.Count; i++)
                    {
                        var playerInfo = realPlayersToAllocate[i];
                        var targetTeamId = (i % 2 == 0) ? homeTeamId : awayTeamId;
                        loadedPlayers.Add(new PlayerMatchStatsDto(playerInfo.Id, playerInfo.Name, playerInfo.Photo, targetTeamId));
                    }
                }

                Scoreboard = new MatchScoreboardDto(
                    MatchId != Guid.Empty ? MatchId : Guid.NewGuid(),
                    homeTeamId,
                    homeTeamName,
                    awayTeamId,
                    awayTeamName,
                    0,
                    0,
                    "Pendente"
                );
            }

            PlayerStats = loadedPlayers;
            RecalculateScoreboard();
        }
        catch (Exception ex)
        {
            SetAlert($"Erro ao carregar súmula: {ex.Message}", isError: true);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void AddPlayerToTeam(Guid playerId, Guid teamId)
    {
        if (playerId == Guid.Empty || teamId == Guid.Empty) return;

        var player = AllTenantPlayers.FirstOrDefault(p => p.Id == playerId);
        if (player == null) return;

        PlayerStats.Add(new PlayerMatchStatsDto(player.Id, player.Name, player.PhotoUrl, teamId));

        if (teamId == Scoreboard?.HomeTeamId)
        {
            SelectedHomePlayerId = Guid.Empty;
        }
        else
        {
            SelectedAwayPlayerId = Guid.Empty;
        }

        RecalculateScoreboard();
    }

    private void RemovePlayer(Guid playerId)
    {
        var removed = PlayerStats.RemoveAll(p => p.PlayerId == playerId);
        if (removed > 0)
        {
            RecalculateScoreboard();
        }
    }

    private void HandlePlayerStatsChanged(PlayerMatchStatsDto updatedPlayer)
    {
        var index = PlayerStats.FindIndex(p => p.PlayerId == updatedPlayer.PlayerId);
        if (index != -1)
        {
            PlayerStats[index] = updatedPlayer;
            RecalculateScoreboard();
        }
    }

    private void RecalculateScoreboard()
    {
        if (Scoreboard == null) return;

        var homeScore = HomePlayers.Sum(p => p.Goals);
        var awayScore = AwayPlayers.Sum(p => p.Goals);

        Scoreboard = Scoreboard with { HomeScore = homeScore, AwayScore = awayScore };
    }

    private async Task SaveStatsAsync()
    {
        if (Scoreboard == null) return;

        var dto = new RegisterMatchStatsDto(Scoreboard.MatchId, Scoreboard.HomeScore, Scoreboard.AwayScore, PlayerStats);
        var (success, error) = await MatchApiService.RegisterMatchStatsAsync(Scoreboard.MatchId, dto);

        if (success)
        {
            Scoreboard = Scoreboard with { Status = "Concluído" };
            SetAlert("Súmula pós-jogo registrada com sucesso!");
        }
        else
        {
            SetAlert(error ?? "Erro ao salvar súmula.", isError: true);
        }
    }

    private void SetAlert(string message, bool isError = false)
    {
        AlertMessage = message;
        IsAlertError = isError;
    }
}
