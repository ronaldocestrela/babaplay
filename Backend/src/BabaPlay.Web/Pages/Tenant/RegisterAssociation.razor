@page "/tenant/register"
@layout PublicLayout
@inject ITenantApiService TenantApiService
@inject NavigationManager NavigationManager

<PageTitle>Cadastrar Associação - Baba Play</PageTitle>

<div class="min-h-screen bg-slate-900 text-white py-12 px-4 sm:px-6 lg:px-8 flex justify-center items-center">
    <div class="max-w-2xl w-full bg-slate-800/80 p-8 rounded-2xl border border-slate-700 shadow-2xl backdrop-blur-md space-y-6">
        <div class="text-center">
            <h1 class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-200">
                Nova Associação
            </h1>
            <p class="mt-2 text-sm text-slate-400">
                Cadastre sua liga ou time para começar a usar o Baba Play.
            </p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div id="register-error-alert" class="p-4 rounded-lg bg-rose-500/10 border border-rose-500/30 text-rose-300 text-sm flex items-center gap-2">
                <svg class="w-5 h-5 shrink-0 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>@errorMessage</span>
            </div>
        }

        <EditForm Model="@createModel" OnValidSubmit="HandleCreateTenantAsync" id="register-association-form">
            <DataAnnotationsValidator />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="md:col-span-2">
                    <label for="tenant-name" class="block text-sm font-medium text-slate-300 mb-1">Nome da Associação / Liga *</label>
                    <InputText id="tenant-name" @bind-Value="createModel.Name" @bind-Value:after="GenerateSlug" class="w-full px-4 py-2.5 bg-slate-900/90 border border-slate-700 rounded-lg text-slate-100 placeholder-slate-500 focus:ring-2 focus:ring-emerald-500 focus:outline-none" placeholder="Ex: Baba das Galáxias FC" />
                    <ValidationMessage For="@(() => createModel.Name)" class="text-rose-400 text-xs mt-1" />
                </div>

                <div>
                    <label for="tenant-slug" class="block text-sm font-medium text-slate-300 mb-1">Slug (Identificador da URL) *</label>
                    <InputText id="tenant-slug" @bind-Value="createModel.Slug" class="w-full px-4 py-2.5 bg-slate-900/90 border border-slate-700 rounded-lg text-slate-100 placeholder-slate-500 focus:ring-2 focus:ring-emerald-500 focus:outline-none" placeholder="baba-das-galaxias" />
                    <ValidationMessage For="@(() => createModel.Slug)" class="text-rose-400 text-xs mt-1" />
                </div>

                <div>
                    <label for="logo-file" class="block text-sm font-medium text-slate-300 mb-1">Escudo / Logotipo (Opcional)</label>
                    <InputFile id="logo-file" OnChange="OnLogoSelected" class="w-full px-3 py-2 bg-slate-900/90 border border-slate-700 rounded-lg text-slate-300 text-xs file:mr-4 file:py-1 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-emerald-500 file:text-slate-950 hover:file:bg-emerald-400" />
                </div>

                <div>
                    <label for="admin-email" class="block text-sm font-medium text-slate-300 mb-1">E-mail do Administrador *</label>
                    <InputText id="admin-email" @bind-Value="createModel.AdminEmail" class="w-full px-4 py-2.5 bg-slate-900/90 border border-slate-700 rounded-lg text-slate-100 placeholder-slate-500 focus:ring-2 focus:ring-emerald-500 focus:outline-none" placeholder="admin@baba.com" />
                    <ValidationMessage For="@(() => createModel.AdminEmail)" class="text-rose-400 text-xs mt-1" />
                </div>

                <div>
                    <label for="admin-password" class="block text-sm font-medium text-slate-300 mb-1">Senha do Administrador *</label>
                    <InputText id="admin-password" type="password" @bind-Value="createModel.AdminPassword" class="w-full px-4 py-2.5 bg-slate-900/90 border border-slate-700 rounded-lg text-slate-100 placeholder-slate-500 focus:ring-2 focus:ring-emerald-500 focus:outline-none" placeholder="••••••••" />
                    <ValidationMessage For="@(() => createModel.AdminPassword)" class="text-rose-400 text-xs mt-1" />
                </div>

                <div>
                    <label for="city-input" class="block text-sm font-medium text-slate-300 mb-1">Cidade *</label>
                    <InputText id="city-input" @bind-Value="createModel.City" class="w-full px-4 py-2.5 bg-slate-900/90 border border-slate-700 rounded-lg text-slate-100 placeholder-slate-500 focus:ring-2 focus:ring-emerald-500 focus:outline-none" placeholder="Salvador" />
                    <ValidationMessage For="@(() => createModel.City)" class="text-rose-400 text-xs mt-1" />
                </div>

                <div>
                    <label for="state-input" class="block text-sm font-medium text-slate-300 mb-1">Estado (UF) *</label>
                    <InputText id="state-input" @bind-Value="createModel.State" class="w-full px-4 py-2.5 bg-slate-900/90 border border-slate-700 rounded-lg text-slate-100 placeholder-slate-500 focus:ring-2 focus:ring-emerald-500 focus:outline-none" placeholder="BA" />
                    <ValidationMessage For="@(() => createModel.State)" class="text-rose-400 text-xs mt-1" />
                </div>
            </div>

            <button type="submit" id="register-association-submit" disabled="@isLoading" class="w-full mt-6 py-3 px-4 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-slate-950 font-bold rounded-lg shadow-lg hover:shadow-emerald-500/25 transition-all duration-200 disabled:opacity-50 flex items-center justify-center gap-2">
                @if (isLoading)
                {
                    <svg class="animate-spin h-5 w-5 text-slate-950" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span>Cadastrando...</span>
                }
                else
                {
                    <span>Criar Associação</span>
                }
            </button>
        </EditForm>
    </div>
</div>

@code {
    private CreateTenantDto createModel = new();
    private IBrowserFile? selectedLogoFile;
    private bool isLoading = false;
    private string? errorMessage;

    private void GenerateSlug()
    {
        if (!string.IsNullOrWhiteSpace(createModel.Name) && string.IsNullOrWhiteSpace(createModel.Slug))
        {
            createModel.Slug = createModel.Name
                .ToLowerInvariant()
                .Replace(" ", "-")
                .Replace("ç", "c")
                .Replace("ã", "a")
                .Replace("á", "a");
        }
    }

    private void OnLogoSelected(InputFileChangeEventArgs e)
    {
        selectedLogoFile = e.File;
    }

    private async Task HandleCreateTenantAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var result = await TenantApiService.CreateTenantAsync(createModel, selectedLogoFile);
            if (result is not null)
            {
                NavigationManager.NavigateTo("/auth/login");
            }
            else
            {
                errorMessage = "Não foi possível cadastrar a associação. O slug pode já estar em uso.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Erro inesperado ao criar a associação.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
