@page "/financial/invoices"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@using BabaPlay.Web.Components.Financial
@inject IFinancialApiService FinancialApiService
@inject IPlayerApiService PlayerApiService

<PageTitle>Faturas e Mensalidades - Baba Play</PageTitle>

<div class="container-fluid py-4" data-testid="invoices-list-page">
    <div class="page-header">
        <div>
            <h1 class="page-header__title text-gradient">Faturas & Mensalidades</h1>
            <p class="page-header__subtitle">Controle de cobranças recorrentes, status de pagamento e emissão avulsa.</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <button class="btn btn-outline-primary btn-sm"
                    @onclick="LoadInvoicesAsync"
                    disabled="@IsLoading"
                    data-testid="btn-refresh-invoices">
                @if (IsRefreshing)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Atualizando...</span>
                }
                else
                {
                    <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>
                    <span>Atualizar</span>
                }
            </button>
            <button class="btn btn-primary btn-sm font-weight-bold"
                    @onclick="() => IsModalOpen = true"
                    data-testid="btn-open-create-invoice-modal">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Emitir Cobrança
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" data-testid="invoices-error-banner">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
            @ErrorMessage
            <button type="button" class="btn-close" @onclick="() => ErrorMessage = null"></button>
        </div>
    }

    <div class="widget-card filters-toolbar mb-4" data-testid="invoices-filter-bar">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label filters-toolbar__label" for="filter-status">Status da Fatura</label>
                <select id="filter-status" class="form-select form-select-sm" value="@SelectedStatusFilter" @onchange="OnStatusFilterChanged" data-testid="filter-status">
                    <option value="-1">Todos os Status</option>
                    <option value="0">Pendente (Aberta)</option>
                    <option value="1">Pago</option>
                    <option value="2">Atrasado</option>
                    <option value="4">Cancelado</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label filters-toolbar__label" for="filter-month">Mês Competência</label>
                <select id="filter-month" class="form-select form-select-sm" value="@SelectedMonthFilter" @onchange="OnMonthFilterChanged" data-testid="filter-month">
                    <option value="0">Todos os Meses</option>
                    <option value="1">Janeiro</option>
                    <option value="2">Fevereiro</option>
                    <option value="3">Março</option>
                    <option value="4">Abril</option>
                    <option value="5">Maio</option>
                    <option value="6">Junho</option>
                    <option value="7">Julho</option>
                    <option value="8">Agosto</option>
                    <option value="9">Setembro</option>
                    <option value="10">Outubro</option>
                    <option value="11">Novembro</option>
                    <option value="12">Dezembro</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label filters-toolbar__label" for="filter-year">Ano Competência</label>
                <select id="filter-year" class="form-select form-select-sm" value="@SelectedYearFilter" @onchange="OnYearFilterChanged" data-testid="filter-year">
                    <option value="0">Todos os Anos</option>
                    @for (int y = DateTime.UtcNow.Year - 2; y <= DateTime.UtcNow.Year + 1; y++)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label filters-toolbar__label" for="filter-player">Atleta</label>
                <select id="filter-player" class="form-select form-select-sm" value="@SelectedPlayerFilter" @onchange="OnPlayerFilterChanged" data-testid="filter-player">
                    <option value="@Guid.Empty">Todos os Atletas</option>
                    @if (Players != null)
                    {
                        @foreach (var player in Players)
                        {
                            <option value="@player.Id">@player.Name</option>
                        }
                    }
                </select>
            </div>
        </div>
    </div>

    @if (IsInitialLoading)
    {
        <div data-testid="invoices-loading">
            <LoadingSpinner Message="Carregando faturas..." />
        </div>
    }
    else if (Invoices == null || Invoices.Count == 0)
    {
        <EmptyState IsPageLevel="true"
                    IconClass="bi-receipt"
                    Title="Nenhuma fatura encontrada"
                    Hint="Não foram encontradas faturas para os filtros selecionados."
                    TestId="invoices-empty-state">
            <button class="btn btn-outline-primary" @onclick="() => IsModalOpen = true">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Emitir Primeira Cobrança
            </button>
        </EmptyState>
    }
    else
    {
        <div class="list-content @(IsRefreshing ? "list-content--refreshing" : null)">
            <div class="widget-card overflow-hidden p-0" data-testid="invoices-table-card">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 financial-table">
                        <thead>
                            <tr>
                                <th>Atleta</th>
                                <th class="d-none d-md-table-cell">Competência</th>
                                <th class="d-none d-lg-table-cell">Vencimento</th>
                                <th class="text-end">Valor Total</th>
                                <th class="d-none d-md-table-cell text-end">Valor Pago</th>
                                <th class="d-none d-md-table-cell text-end">Valor Aberto</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Invoices)
                            {
                                var player = Players?.FirstOrDefault(p => p.Id == item.PlayerId);
                                var playerName = player?.Name ?? "Atleta";
                                var canPay = item.Status == 0 || item.Status == 2;
                                <tr data-testid="invoice-row">
                                    <td class="font-weight-bold">
                                        @playerName
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <div class="text-muted small font-weight-normal">@item.Description</div>
                                        }
                                    </td>
                                    <td class="d-none d-md-table-cell text-muted">
                                        @item.Month.ToString("D2")/@item.Year
                                    </td>
                                    <td class="d-none d-lg-table-cell text-muted">
                                        @item.DueDateUtc.ToLocalTime().ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="text-end font-weight-bold">
                                        @FormatCurrency(item.Amount)
                                    </td>
                                    <td class="d-none d-md-table-cell text-end amount-income">
                                        @FormatCurrency(item.PaidAmount)
                                    </td>
                                    <td class="d-none d-md-table-cell text-end font-weight-bold @(item.OpenAmount > 0 ? "amount-expense" : "text-muted")">
                                        @FormatCurrency(item.OpenAmount)
                                    </td>
                                    <td class="text-center">
                                        <InvoiceStatusBadge Status="item.Status" />
                                    </td>
                                    <td class="text-center">
                                        @if (canPay)
                                        {
                                            <button class="btn btn-outline-success btn-sm font-weight-bold"
                                                    @onclick="() => OpenPixModal(item)"
                                                    data-testid="btn-pay-pix">
                                                <i class="bi bi-qr-code me-1" aria-hidden="true"></i> Pagar via Pix
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <CreateInvoiceModal IsOpen="IsModalOpen"
                        Players="Players"
                        OnClose="() => IsModalOpen = false"
                        OnInvoiceCreated="HandleInvoiceCreated" />

    <PixPaymentModal IsOpen="IsPixModalOpen"
                     Invoice="SelectedInvoiceForPix"
                     OnClose="() => IsPixModalOpen = false"
                     OnPaymentConfirmed="HandlePixPaymentConfirmed" />
</div>

@code {
    private List<InvoiceDto>? Invoices { get; set; }
    private List<PlayerDto>? Players { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool HasLoadedOnce { get; set; }
    private bool IsModalOpen { get; set; }
    private bool IsPixModalOpen { get; set; }
    private InvoiceDto? SelectedInvoiceForPix { get; set; }
    private string? ErrorMessage { get; set; }

    private int SelectedStatusFilter { get; set; } = -1;
    private int SelectedMonthFilter { get; set; } = 0;
    private int SelectedYearFilter { get; set; } = 0;
    private Guid SelectedPlayerFilter { get; set; } = Guid.Empty;

    private bool IsInitialLoading => IsLoading && !HasLoadedOnce;
    private bool IsRefreshing => IsLoading && HasLoadedOnce;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlayersAsync();
        await LoadInvoicesAsync();
    }

    private async Task LoadPlayersAsync()
    {
        try
        {
            var result = await PlayerApiService.GetPlayersAsync();
            Players = result != null ? new List<PlayerDto>(result) : new List<PlayerDto>();
        }
        catch
        {
            Players = new List<PlayerDto>();
        }
    }

    private async Task LoadInvoicesAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            int? statusParam = SelectedStatusFilter >= 0 ? SelectedStatusFilter : null;
            int? monthParam = SelectedMonthFilter > 0 ? SelectedMonthFilter : null;
            int? yearParam = SelectedYearFilter > 0 ? SelectedYearFilter : null;
            Guid? playerParam = SelectedPlayerFilter != Guid.Empty ? SelectedPlayerFilter : null;

            Invoices = await FinancialApiService.GetInvoicesAsync(yearParam, monthParam, playerParam, statusParam);
            if (Invoices == null)
            {
                ErrorMessage = "Não foi possível carregar a lista de faturas. Verifique a conexão com a API.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao carregar faturas: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            HasLoadedOnce = true;
        }
    }

    private async Task OnStatusFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int status))
        {
            SelectedStatusFilter = status;
            await LoadInvoicesAsync();
        }
    }

    private async Task OnMonthFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int month))
        {
            SelectedMonthFilter = month;
            await LoadInvoicesAsync();
        }
    }

    private async Task OnYearFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int year))
        {
            SelectedYearFilter = year;
            await LoadInvoicesAsync();
        }
    }

    private async Task OnPlayerFilterChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out Guid playerId))
        {
            SelectedPlayerFilter = playerId;
            await LoadInvoicesAsync();
        }
    }

    private async Task HandleInvoiceCreated(InvoiceDto newInvoice)
    {
        await LoadInvoicesAsync();
    }

    private void OpenPixModal(InvoiceDto item)
    {
        SelectedInvoiceForPix = item;
        IsPixModalOpen = true;
    }

    private async Task HandlePixPaymentConfirmed()
    {
        await LoadInvoicesAsync();
    }

    private static string FormatCurrency(decimal val) => val.ToString("C2", new System.Globalization.CultureInfo("pt-BR"));
}
