@page "/financial/defaulters"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Financial
@using BabaPlay.Web.Components.Common
@inject IFinancialApiService FinancialApiService

<PageTitle>Controle de Inadimplência - Baba Play</PageTitle>

<div class="container-fluid py-4" data-testid="defaulters-report-page">
    <div class="page-header">
        <div>
            <h1 class="page-header__title text-gradient">Controle de Inadimplência</h1>
            <p class="page-header__subtitle">Relatório gerencial de membros em atraso e cobrança ativa.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-warning btn-sm font-weight-bold"
                    @onclick="RemindAllAsync"
                    disabled="@(FilteredDefaulters.Count == 0 || IsBulkSending)"
                    data-testid="btn-remind-all">
                @if (IsBulkSending)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Enviando Cobranças...</span>
                }
                else
                {
                    <i class="bi bi-megaphone-fill me-1" aria-hidden="true"></i>
                    <span>Cobrar Todos (@FilteredDefaulters.Count)</span>
                }
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" data-testid="success-toast">
            <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>
            @SuccessMessage
            <button type="button" class="btn-close" @onclick="() => SuccessMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger mb-4" data-testid="error-alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
            @ErrorMessage
        </div>
    }

    @if (IsLoading)
    {
        <div data-testid="defaulters-loading">
            <LoadingSpinner Message="Carregando relatório de inadimplência..." />
        </div>
    }
    else
    {
        <div class="row g-3 mb-4" data-testid="defaulters-kpi-row">
            <div class="col-12 col-md-4">
                <div class="stat-card financial-kpi-accent financial-kpi-accent--danger" data-testid="kpi-defaulters-count">
                    <div class="stat-card__label text-uppercase">Total Inadimplentes</div>
                    <div class="stat-card__value amount-expense">@ReportData?.TotalDefaultersCount</div>
                    <div class="stat-card__subtitle">Atletas com faturas vencidas</div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="stat-card financial-kpi-accent financial-kpi-accent--warning" data-testid="kpi-total-overdue-amount">
                    <div class="stat-card__label text-uppercase">Montante Total em Atraso</div>
                    <div class="stat-card__value financial-kpi-card__value--warning">
                        @FormatCurrency(ReportData?.TotalOverdueAmount ?? 0m)
                    </div>
                    <div class="stat-card__subtitle">Total de mensalidades abertas</div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="stat-card financial-kpi-accent financial-kpi-accent--info" data-testid="kpi-avg-days-overdue">
                    <div class="stat-card__label text-uppercase">Média de Atraso</div>
                    <div class="stat-card__value">
                        @(Math.Round(ReportData?.AverageDaysOverdue ?? 0, 1)) dias
                    </div>
                    <div class="stat-card__subtitle">Tempo médio por atleta</div>
                </div>
            </div>
        </div>

        <div class="widget-card filters-toolbar mb-4" data-testid="defaulters-filter-bar">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-6">
                    <label class="form-label filters-toolbar__label" for="input-search-defaulter">Buscar</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                        <input id="input-search-defaulter"
                               type="text"
                               class="form-control form-control-sm"
                               placeholder="Nome do atleta..."
                               value="@SearchTerm"
                               @oninput="OnSearchInput"
                               data-testid="input-search-defaulter" />
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label filters-toolbar__label" for="select-risk-filter">Nível de Risco</label>
                    <select id="select-risk-filter"
                            class="form-select form-select-sm"
                            value="@RiskFilter"
                            @onchange="OnRiskFilterChanged"
                            data-testid="select-risk-filter">
                        <option value="all">Todos os Níveis de Risco</option>
                        <option value="critico">Crítico (&gt; 60 dias)</option>
                        <option value="medio">Médio (31-60 dias)</option>
                        <option value="leve">Leve (&lt;= 30 dias)</option>
                    </select>
                </div>
            </div>
        </div>

        @if (FilteredDefaulters.Count == 0)
        {
            <EmptyState IsPageLevel="true"
                        IconClass="bi-emoji-smile"
                        Title="Nenhum Atleta Inadimplente!"
                        Hint="Todas as mensalidades estão em dia ou os filtros aplicados não retornaram resultados."
                        TestId="empty-defaulters" />
        }
        else
        {
            <div class="widget-card overflow-hidden p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 financial-table">
                        <thead>
                            <tr>
                                <th>Atleta</th>
                                <th class="d-none d-md-table-cell text-center">Faturas Pendentes</th>
                                <th class="text-end">Total Devendo</th>
                                <th class="d-none d-lg-table-cell text-center">Nível de Risco</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in FilteredDefaulters)
                            {
                                <DefaulterRowWidget Member="member" OnSendReminder="HandleSendReminder" />
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private DefaultersListDto? ReportData { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsBulkSending { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }

    private string SearchTerm { get; set; } = string.Empty;
    private string RiskFilter { get; set; } = "all";

    protected override async Task OnInitializedAsync()
    {
        await LoadDefaultersReportAsync();
    }

    private async Task LoadDefaultersReportAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            ReportData = await FinancialApiService.GetDefaultersAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao carregar inadimplência: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private List<DefaulterMemberDto> FilteredDefaulters
    {
        get
        {
            if (ReportData?.Items == null) return new List<DefaulterMemberDto>();

            var query = ReportData.Items.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                query = query.Where(x => x.PlayerName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));
            }

            if (RiskFilter == "critico")
            {
                query = query.Where(x => x.MaxDaysOverdue > 60);
            }
            else if (RiskFilter == "medio")
            {
                query = query.Where(x => x.MaxDaysOverdue > 30 && x.MaxDaysOverdue <= 60);
            }
            else if (RiskFilter == "leve")
            {
                query = query.Where(x => x.MaxDaysOverdue <= 30);
            }

            return query.ToList();
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? string.Empty;
    }

    private void OnRiskFilterChanged(ChangeEventArgs e)
    {
        RiskFilter = e.Value?.ToString() ?? "all";
    }

    private async Task HandleSendReminder(Guid playerId)
    {
        SuccessMessage = null;
        var success = await FinancialApiService.SendPaymentReminderAsync(playerId);
        if (success)
        {
            var member = ReportData?.Items.FirstOrDefault(p => p.PlayerId == playerId);
            SuccessMessage = $"Lembrete de cobrança enviado com sucesso para {member?.PlayerName ?? "o atleta"}!";
        }
        else
        {
            ErrorMessage = "Não foi possível enviar o lembrete de cobrança.";
        }
    }

    private async Task RemindAllAsync()
    {
        if (FilteredDefaulters.Count == 0) return;

        IsBulkSending = true;
        SuccessMessage = null;
        int sentCount = 0;

        foreach (var member in FilteredDefaulters)
        {
            var ok = await FinancialApiService.SendPaymentReminderAsync(member.PlayerId);
            if (ok) sentCount++;
        }

        IsBulkSending = false;
        SuccessMessage = $"Lembretes de cobrança disparados com sucesso para {sentCount} atleta(s)!";
    }

    private static string FormatCurrency(decimal val) => val.ToString("C2", new System.Globalization.CultureInfo("pt-BR"));
}
