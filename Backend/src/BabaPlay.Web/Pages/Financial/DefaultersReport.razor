@page "/financial/defaulters"
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Financial
@using BabaPlay.Web.Components.Common
@inject IFinancialApiService FinancialApiService

<div class="container-fluid p-4" data-testid="defaulters-report-page">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="font-weight-bold mb-1" style="color: var(--text-main);">
                🚨 Controle de Inadimplência
            </h3>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">
                Relatório gerencial de membros em atraso e cobrança ativa
            </p>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-warning font-weight-bold" @onclick="RemindAllAsync" disabled="@(FilteredDefaulters.Count == 0 || IsBulkSending)" data-testid="btn-remind-all">
                @if (IsBulkSending)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Enviando Cobranças...</span>
                }
                else
                {
                    <span>📣 Cobrar Todos (@FilteredDefaulters.Count)</span>
                }
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" data-testid="success-toast">
            ✓ @SuccessMessage
            <button type="button" class="btn-close" @onclick="() => SuccessMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger mb-4" data-testid="error-alert">
            @ErrorMessage
        </div>
    }

    @if (IsLoading)
    {
        <div class="py-5" data-testid="defaulters-loading">
            <LoadingSpinner Message="Carregando relatório de inadimplência..." />
        </div>
    }
    else
    {
        <!-- KPI Cards Summary -->
        <div class="row g-3 mb-4" data-testid="defaulters-kpi-row">
            <div class="col-12 col-md-4">
                <div class="card p-3 shadow-sm" style="border-radius: 10px; border-left: 4px solid #ef4444;" data-testid="kpi-defaulters-count">
                    <div class="text-muted font-weight-bold text-uppercase" style="font-size: 0.75rem;">Total Inadimplentes</div>
                    <div class="h3 font-weight-bold text-danger mb-0">@ReportData?.TotalDefaultersCount</div>
                    <div style="font-size: 0.75rem; color: var(--text-muted);">Atletas com faturas vencidas</div>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="card p-3 shadow-sm" style="border-radius: 10px; border-left: 4px solid #f59e0b;" data-testid="kpi-total-overdue-amount">
                    <div class="text-muted font-weight-bold text-uppercase" style="font-size: 0.75rem;">Montante Total em Atraso</div>
                    <div class="h3 font-weight-bold text-warning mb-0" style="color: #d97706 !important;">
                        @FormatCurrency(ReportData?.TotalOverdueAmount ?? 0m)
                    </div>
                    <div style="font-size: 0.75rem; color: var(--text-muted);">Total de mensalidades abertas</div>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="card p-3 shadow-sm" style="border-radius: 10px; border-left: 4px solid #3b82f6;" data-testid="kpi-avg-days-overdue">
                    <div class="text-muted font-weight-bold text-uppercase" style="font-size: 0.75rem;">Média de Atraso</div>
                    <div class="h3 font-weight-bold text-primary mb-0">
                        @(Math.Round(ReportData?.AverageDaysOverdue ?? 0, 1)) dias
                    </div>
                    <div style="font-size: 0.75rem; color: var(--text-muted);">Tempo médio por atleta</div>
                </div>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="card p-3 mb-4 shadow-sm" style="border-radius: 10px;" data-testid="defaulters-filter-bar">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-6">
                    <input type="text" class="form-control form-control-sm" placeholder="🔍 Buscar por nome do atleta..." value="@SearchTerm" @oninput="OnSearchInput" data-testid="input-search-defaulter" />
                </div>
                <div class="col-12 col-md-6 d-flex gap-2 justify-content-md-end">
                    <select class="form-select form-select-sm style-select" value="@RiskFilter" @onchange="OnRiskFilterChanged" data-testid="select-risk-filter" style="max-width: 220px;">
                        <option value="all">Todos os Níveis de Risco</option>
                        <option value="critico">🚨 Crítico (> 60 dias)</option>
                        <option value="medio">📙 Médio (31-60 dias)</option>
                        <option value="leve">⚠️ Leve (&lt;= 30 dias)</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Defaulters Table -->
        @if (FilteredDefaulters.Count == 0)
        {
            <div class="card p-5 text-center shadow-sm" style="border-radius: 12px; background: var(--bg-surface, #ffffff);" data-testid="empty-defaulters">
                <div style="font-size: 3rem; color: #10b981;">🎉</div>
                <h5 class="font-weight-bold mt-2" style="color: var(--text-main);">Nenhum Atleta Inadimplente!</h5>
                <p class="text-muted mb-0" style="font-size: 0.875rem;">Todas as mensalidades estão em dia ou os filtros aplicados não retornaram resultados.</p>
            </div>
        }
        else
        {
            <div class="card shadow-sm" style="border-radius: 12px; overflow: hidden; border: none;">
                <div class="table-responsive">
                    <table class="table align-middle mb-0" style="background: var(--bg-surface, #ffffff);">
                        <thead style="background: var(--bg-muted, #f8fafc); border-bottom: 2px solid var(--border-color, #e2e8f0); font-size: 0.75rem;" class="text-uppercase font-weight-bold text-muted">
                            <tr>
                                <th style="padding: 0.75rem 1rem;">Atleta</th>
                                <th class="d-none d-md-table-cell" style="padding: 0.75rem 1rem; text-align: center;">Faturas Pendentes</th>
                                <th style="padding: 0.75rem 1rem; text-align: right;">Total Devendo</th>
                                <th class="d-none d-lg-table-cell" style="padding: 0.75rem 1rem; text-align: center;">Nível de Risco</th>
                                <th style="padding: 0.75rem 1rem; text-align: center;">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in FilteredDefaulters)
                            {
                                <DefaulterRowWidget Member="member" OnSendReminder="HandleSendReminder" />
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private DefaultersListDto? ReportData { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsBulkSending { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }

    private string SearchTerm { get; set; } = string.Empty;
    private string RiskFilter { get; set; } = "all";

    protected override async Task OnInitializedAsync()
    {
        await LoadDefaultersReportAsync();
    }

    private async Task LoadDefaultersReportAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            ReportData = await FinancialApiService.GetDefaultersAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao carregar inadimplência: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private List<DefaulterMemberDto> FilteredDefaulters
    {
        get
        {
            if (ReportData?.Items == null) return new List<DefaulterMemberDto>();

            var query = ReportData.Items.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                query = query.Where(x => x.PlayerName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));
            }

            if (RiskFilter == "critico")
            {
                query = query.Where(x => x.MaxDaysOverdue > 60);
            }
            else if (RiskFilter == "medio")
            {
                query = query.Where(x => x.MaxDaysOverdue > 30 && x.MaxDaysOverdue <= 60);
            }
            else if (RiskFilter == "leve")
            {
                query = query.Where(x => x.MaxDaysOverdue <= 30);
            }

            return query.ToList();
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? string.Empty;
    }

    private void OnRiskFilterChanged(ChangeEventArgs e)
    {
        RiskFilter = e.Value?.ToString() ?? "all";
    }

    private async Task HandleSendReminder(Guid playerId)
    {
        SuccessMessage = null;
        var success = await FinancialApiService.SendPaymentReminderAsync(playerId);
        if (success)
        {
            var member = ReportData?.Items.FirstOrDefault(p => p.PlayerId == playerId);
            SuccessMessage = $"Lembrete de cobrança enviado com sucesso para {member?.PlayerName ?? "o atleta"}!";
        }
        else
        {
            ErrorMessage = "Não foi possível enviar o lembrete de cobrança.";
        }
    }

    private async Task RemindAllAsync()
    {
        if (FilteredDefaulters.Count == 0) return;

        IsBulkSending = true;
        SuccessMessage = null;
        int sentCount = 0;

        foreach (var member in FilteredDefaulters)
        {
            var ok = await FinancialApiService.SendPaymentReminderAsync(member.PlayerId);
            if (ok) sentCount++;
        }

        IsBulkSending = false;
        SuccessMessage = $"Lembretes de cobrança disparados com sucesso para {sentCount} atleta(s)!";
    }

    private static string FormatCurrency(decimal val) => val.ToString("C2", new System.Globalization.CultureInfo("pt-BR"));
}
