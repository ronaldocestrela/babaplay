@page "/financial/statement"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Financial
@using BabaPlay.Web.Components.Common
@inject IFinancialApiService FinancialApiService
@inject IJSRuntime JSRuntime

<PageTitle>Balancete & Prestação de Contas - Baba Play</PageTitle>

<div class="container-fluid py-4" data-testid="financial-statement-page">
    <div class="page-header">
        <div>
            <h1 class="page-header__title text-gradient">Balancete & Prestação de Contas</h1>
            <p class="page-header__subtitle">Transparência financeira pública para sócios e atletas da associação.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-secondary btn-sm font-weight-bold"
                    @onclick="PrintStatementAsync"
                    data-testid="btn-print-statement">
                <i class="bi bi-printer me-1" aria-hidden="true"></i> Imprimir Balancete
            </button>
        </div>
    </div>

    <div class="widget-card filters-toolbar mb-4" data-testid="statement-period-filter-bar">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label filters-toolbar__label" for="select-statement-month">Mês da Competência</label>
                <select id="select-statement-month" class="form-select form-select-sm" value="@SelectedMonth" @onchange="OnMonthChanged" data-testid="select-statement-month">
                    <option value="1">Janeiro</option>
                    <option value="2">Fevereiro</option>
                    <option value="3">Março</option>
                    <option value="4">Abril</option>
                    <option value="5">Maio</option>
                    <option value="6">Junho</option>
                    <option value="7">Julho</option>
                    <option value="8">Agosto</option>
                    <option value="9">Setembro</option>
                    <option value="10">Outubro</option>
                    <option value="11">Novembro</option>
                    <option value="12">Dezembro</option>
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label filters-toolbar__label" for="select-statement-year">Ano</label>
                <select id="select-statement-year" class="form-select form-select-sm" value="@SelectedYear" @onchange="OnYearChanged" data-testid="select-statement-year">
                    @for (int y = DateTime.UtcNow.Year - 2; y <= DateTime.UtcNow.Year + 1; y++)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label filters-toolbar__label" for="select-type-filter">Filtrar Tipo</label>
                <select id="select-type-filter" class="form-select form-select-sm" value="@TypeFilter" @onchange="OnTypeFilterChanged" data-testid="select-type-filter">
                    <option value="all">Todos os Lançamentos</option>
                    <option value="income">Somente Receitas</option>
                    <option value="expense">Somente Despesas</option>
                </select>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger mb-4" data-testid="statement-error-alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
            @ErrorMessage
        </div>
    }

    @if (IsLoading)
    {
        <div data-testid="statement-loading">
            <LoadingSpinner Message="Carregando balancete de prestação de contas..." />
        </div>
    }
    else if (StatementData != null)
    {
        <FinancialStatementSummaryCard TotalIncomes="StatementData.TotalIncomes"
                                        TotalExpenses="StatementData.TotalExpenses"
                                        NetBalance="StatementData.NetBalance" />

        @if (FilteredItems.Count == 0)
        {
            <EmptyState IsPageLevel="true"
                        IconClass="bi-journal-x"
                        Title="Nenhum lançamento no período"
                        Hint="Não foram registradas movimentações para o mês selecionado."
                        TestId="empty-statement" />
        }
        else
        {
            <div class="widget-card overflow-hidden p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 financial-table">
                        <thead>
                            <tr>
                                <th>Data</th>
                                <th class="d-none d-md-table-cell">Categoria</th>
                                <th>Descrição / Origem</th>
                                <th class="d-none d-lg-table-cell">Membro / Fornecedor</th>
                                <th class="text-end">Valor R$</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in FilteredItems)
                            {
                                var isIncome = item.Type == 0;
                                <tr data-testid="statement-row">
                                    <td class="text-muted small">
                                        @item.OccurredOnUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="d-none d-md-table-cell">
                                        <span class="badge badge-secondary" data-testid="item-category">
                                            @item.Category
                                        </span>
                                    </td>
                                    <td class="font-weight-bold" data-testid="item-description">
                                        @item.Description
                                    </td>
                                    <td class="d-none d-lg-table-cell text-muted">
                                        @(string.IsNullOrEmpty(item.PlayerName) ? "Diretoria / Associação" : item.PlayerName)
                                    </td>
                                    <td class="text-end font-weight-bold @(isIncome ? "amount-income" : "amount-expense")" data-testid="item-amount">
                                        @(isIncome ? "+" : "-") @FormatCurrency(item.Amount)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private FinancialStatementDto? StatementData { get; set; }
    private bool IsLoading { get; set; } = true;
    private string? ErrorMessage { get; set; }

    private int SelectedMonth { get; set; } = DateTime.UtcNow.Month;
    private int SelectedYear { get; set; } = DateTime.UtcNow.Year;
    private string TypeFilter { get; set; } = "all";

    protected override async Task OnInitializedAsync()
    {
        await LoadStatementAsync();
    }

    private async Task LoadStatementAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            StatementData = await FinancialApiService.GetFinancialStatementAsync(SelectedYear, SelectedMonth);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao carregar prestação de contas: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private List<FinancialStatementItemDto> FilteredItems
    {
        get
        {
            if (StatementData?.Items == null) return new List<FinancialStatementItemDto>();

            if (TypeFilter == "income")
                return StatementData.Items.Where(x => x.Type == 0).ToList();
            if (TypeFilter == "expense")
                return StatementData.Items.Where(x => x.Type == 1).ToList();

            return StatementData.Items;
        }
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int month))
        {
            SelectedMonth = month;
            await LoadStatementAsync();
        }
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int year))
        {
            SelectedYear = year;
            await LoadStatementAsync();
        }
    }

    private void OnTypeFilterChanged(ChangeEventArgs e)
    {
        TypeFilter = e.Value?.ToString() ?? "all";
    }

    private async Task PrintStatementAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("window.print");
        }
        catch
        {
            // Fallback for non-interactive test environments
        }
    }

    private static string FormatCurrency(decimal val) => val.ToString("C2", new System.Globalization.CultureInfo("pt-BR"));
}
