@page "/financial"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@using BabaPlay.Web.Components.Financial
@inject IFinancialApiService FinancialApiService

<PageTitle>Dashboard Financeiro - Baba Play</PageTitle>

<div class="container-fluid py-4" data-testid="financial-dashboard-page">
    <div class="page-header">
        <div>
            <h1 class="page-header__title text-gradient">Dashboard Financeiro</h1>
            <p class="page-header__subtitle">Visão consolidada do fluxo de caixa, mensalidades e arrecadação do Tenant.</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <select class="form-select form-select-sm financial-period-select"
                    value="@SelectedMonth"
                    @onchange="OnMonthChanged"
                    aria-label="Mês"
                    data-testid="select-month">
                <option value="1">Janeiro</option>
                <option value="2">Fevereiro</option>
                <option value="3">Março</option>
                <option value="4">Abril</option>
                <option value="5">Maio</option>
                <option value="6">Junho</option>
                <option value="7">Julho</option>
                <option value="8">Agosto</option>
                <option value="9">Setembro</option>
                <option value="10">Outubro</option>
                <option value="11">Novembro</option>
                <option value="12">Dezembro</option>
            </select>
            <select class="form-select form-select-sm financial-period-select financial-period-select--year"
                    value="@SelectedYear"
                    @onchange="OnYearChanged"
                    aria-label="Ano"
                    data-testid="select-year">
                @for (int y = DateTime.UtcNow.Year - 2; y <= DateTime.UtcNow.Year + 1; y++)
                {
                    <option value="@y">@y</option>
                }
            </select>
            <button class="btn btn-outline-primary btn-sm"
                    @onclick="LoadOverviewAsync"
                    disabled="@IsLoading"
                    data-testid="btn-refresh-financial">
                @if (IsRefreshing)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Atualizando...</span>
                }
                else
                {
                    <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>
                    <span>Atualizar</span>
                }
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" data-testid="financial-error-banner">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
            @ErrorMessage
            <button type="button" class="btn-close" @onclick="() => ErrorMessage = null"></button>
        </div>
    }

    @if (IsInitialLoading)
    {
        <div data-testid="financial-loading">
            <LoadingSpinner Message="Carregando resumo financeiro..." />
        </div>
    }
    else if (Overview != null)
    {
        <div class="list-content @(IsRefreshing ? "list-content--refreshing" : null)">
            <div class="row g-3 mb-4" data-testid="kpi-cards-grid">
                <div class="col-12 col-sm-6 col-xl-3">
                    <FinancialKpiCard Title="Saldo da Caixinha"
                                      Amount="Overview.NetBalance"
                                      Icon="bi-wallet2"
                                      Subtitle="Balanço acumulado do período"
                                      BadgeText="@(Overview.NetBalance >= 0 ? "Superávit" : "Déficit")"
                                      BadgeColorClass="@(Overview.NetBalance >= 0 ? "badge-success" : "badge-danger")"
                                      ValueColor="@(Overview.NetBalance >= 0 ? "success" : "danger")" />
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <FinancialKpiCard Title="Entradas (Receitas)"
                                      Amount="Overview.TotalIncome"
                                      Icon="bi-graph-up-arrow"
                                      Subtitle="Recebimentos no mês"
                                      BadgeText="Entradas"
                                      BadgeColorClass="badge-success"
                                      ValueColor="success" />
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <FinancialKpiCard Title="Saídas (Despesas)"
                                      Amount="Overview.TotalExpense"
                                      Icon="bi-graph-down-arrow"
                                      Subtitle="Gastos no mês"
                                      BadgeText="Saídas"
                                      BadgeColorClass="badge-danger"
                                      ValueColor="danger" />
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <FinancialKpiCard Title="Mensalidades Pendentes"
                                      Amount="Overview.PendingMonthlyFeesAmount"
                                      Icon="bi-exclamation-triangle"
                                      Subtitle="@($"{Overview.DelinquentPlayersCount} atletas em atraso")"
                                      BadgeText="@(Overview.DelinquentPlayersCount > 0 ? "Atenção" : "Em dia")"
                                      BadgeColorClass="@(Overview.DelinquentPlayersCount > 0 ? "badge-warning" : "badge-success")"
                                      ValueColor="@(Overview.PendingMonthlyFeesAmount > 0 ? "warning" : "success")" />
                </div>
            </div>

            <div class="widget-card mb-4" data-testid="collection-rate-widget">
                <div class="widget-card__header">
                    <h2 class="widget-card__title">
                        <i class="bi bi-pie-chart-fill" aria-hidden="true"></i>
                        Taxa de Arrecadação de Mensalidades
                    </h2>
                    <span class="font-weight-bold text-primary-light" data-testid="collection-rate-value">
                        @Overview.CollectionRatePercentage%
                    </span>
                </div>
                <div class="progress financial-collection-progress">
                    <div class="progress-bar financial-collection-progress__bar financial-collection-progress__bar--@GetProgressTone(Overview.CollectionRatePercentage)"
                         role="progressbar"
                         style="width: @Overview.CollectionRatePercentage%"
                         aria-valuenow="@Overview.CollectionRatePercentage"
                         aria-valuemin="0"
                         aria-valuemax="100"></div>
                </div>
            </div>

            <RecentTransactionsWidget Transactions="Overview.RecentTransactions" />
        </div>
    }
</div>

@code {
    private FinancialOverviewDto? Overview { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool HasLoadedOnce { get; set; }
    private string? ErrorMessage { get; set; }

    private int SelectedYear { get; set; } = DateTime.UtcNow.Year;
    private int SelectedMonth { get; set; } = DateTime.UtcNow.Month;

    private bool IsInitialLoading => IsLoading && !HasLoadedOnce;
    private bool IsRefreshing => IsLoading && HasLoadedOnce;

    protected override async Task OnInitializedAsync()
    {
        await LoadOverviewAsync();
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int month))
        {
            SelectedMonth = month;
            await LoadOverviewAsync();
        }
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int year))
        {
            SelectedYear = year;
            await LoadOverviewAsync();
        }
    }

    private async Task LoadOverviewAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var result = await FinancialApiService.GetFinancialOverviewAsync(SelectedYear, SelectedMonth);
            if (!result.IsSuccess || result.Data is null)
            {
                ErrorMessage = string.IsNullOrWhiteSpace(result.ErrorMessage)
                    ? "Não foi possível carregar os dados financeiros. Verifique sua conexão ou permissões."
                    : result.ErrorMessage;
                Overview = null;
            }
            else
            {
                Overview = result.Data;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao carregar dados financeiros: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            HasLoadedOnce = true;
        }
    }

    private static string GetProgressTone(decimal percentage) => percentage switch
    {
        >= 80m => "success",
        >= 50m => "warning",
        _ => "danger"
    };
}
