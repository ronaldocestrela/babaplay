@page "/reports/rankings"
@page "/rankings"
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@using BabaPlay.Web.Components.Reports
@inject IRankingApiService RankingApiService

<PageTitle>Rankings da Temporada - Baba Play</PageTitle>

<div class="container-fluid py-4" data-testid="season-rankings-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 mb-1 font-weight-bold text-gradient">Rankings da Temporada & Histórico</h1>
            <p class="text-muted mb-0">Acompanhe a classificação geral da associação, artilharia, assistências e assiduidade.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" @onclick="RebuildRankingAsync" data-testid="btn-rebuild-ranking">
                <i class="bi bi-arrow-repeat me-1"></i> Recalcular Ranking
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(AlertMessage))
    {
        <div class="alert @(IsAlertError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-4" role="alert" data-testid="alert-banner">
            <i class="bi @(IsAlertError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>
            @AlertMessage
            <button type="button" class="btn-close" @onclick="() => AlertMessage = null"></button>
        </div>
    }

    <!-- Abas de Navegação & Filtro -->
    <div class="card card-custom p-3 mb-4 shadow-sm">
        <div class="row align-items-center g-3">
            <div class="col-md-7">
                <div class="nav nav-pills" data-testid="ranking-tabs">
                    <button class="nav-link @(ActiveTab == "General" ? "active" : "") me-1" @onclick="SelectGeneralTab">⭐ Ranking Geral</button>
                    <button class="nav-link @(ActiveTab == "Scorers" ? "active" : "") me-1" @onclick="SelectScorersTab">⚽ Artilharia</button>
                    <button class="nav-link @(ActiveTab == "Assists" ? "active" : "") me-1" @onclick="SelectAssistsTab">👟 Assistências</button>
                    <button class="nav-link @(ActiveTab == "Attendance" ? "active" : "")" @onclick="SelectAttendanceTab">📅 Assiduidade</button>
                </div>
            </div>
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Buscar atleta no ranking..." @bind="SearchTerm" @bind:event="oninput" data-testid="input-search-ranking" />
                </div>
            </div>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <LoadingSpinner Message="Carregando estatísticas e ranking da temporada..." />
        </div>
    }
    else if (ActiveTab == "Scorers" || ActiveTab == "Assists")
    {
        <TopScorersWidget Scorers="FilteredScorers" />
    }
    else if (ActiveTab == "Attendance")
    {
        <AttendanceWidget AttendanceList="FilteredAttendance" />
    }
    else
    {
        <!-- Tabela do Ranking Geral -->
        <div class="card card-custom p-4 mb-4 shadow-sm" data-testid="general-ranking-widget">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="h5 font-weight-bold mb-0 text-dark">⭐ Ranking Geral de Pontuação</h3>
                <span class="badge bg-primary">@FilteredGeneralRanking.Count Atletas Classificados</span>
            </div>

            @if (FilteredGeneralRanking.Count == 0)
            {
                <div class="text-center py-4 text-muted" data-testid="empty-general-ranking">
                    Nenhum atleta encontrado para os critérios selecionados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" data-testid="general-ranking-table">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;">Pos</th>
                                <th>Atleta</th>
                                <th class="text-center">Pontos</th>
                                <th class="d-none d-md-table-cell text-center">Jogos</th>
                                <th class="d-none d-md-table-cell text-center">Vitórias</th>
                                <th class="d-none d-lg-table-cell text-center">Empates</th>
                                <th class="d-none d-lg-table-cell text-center">Derrotas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var player in FilteredGeneralRanking)
                            {
                                <tr data-testid="ranking-row-@player.PlayerId">
                                    <td class="fw-bold">
                                        @if (player.RankPosition == 1) { <span>🥇</span> }
                                        else if (player.RankPosition == 2) { <span>🥈</span> }
                                        else if (player.RankPosition == 3) { <span>🥉</span> }
                                        else { <span class="text-muted">#@player.RankPosition</span> }
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle bg-dark text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                                @GetInitials(player.PlayerName)
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark" data-testid="ranking-player-name">@player.PlayerName</div>
                                                @if (!string.IsNullOrWhiteSpace(player.Nickname))
                                                {
                                                    <small class="text-muted italic">"@player.Nickname"</small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center fw-bold text-warning" data-testid="ranking-points">@player.TotalPoints pts</td>
                                    <td class="d-none d-md-table-cell text-center">@player.MatchesPlayed</td>
                                    <td class="d-none d-md-table-cell text-center text-success">@player.Victories</td>
                                    <td class="d-none d-lg-table-cell text-center text-muted">@player.Draws</td>
                                    <td class="d-none d-lg-table-cell text-center text-danger">@player.Losses</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<RankingEntryDto> GeneralRanking { get; set; } = new();
    private List<TopScorerEntryDto> ScorersList { get; set; } = new();
    private List<AttendanceEntryDto> AttendanceList { get; set; } = new();

    private string ActiveTab { get; set; } = "General";
    private string SearchTerm { get; set; } = string.Empty;
    private bool IsLoading { get; set; } = true;
    private string? AlertMessage { get; set; }
    private bool IsAlertError { get; set; }

    private IReadOnlyList<RankingEntryDto> FilteredGeneralRanking => GeneralRanking
        .Where(p => string.IsNullOrWhiteSpace(SearchTerm) || p.PlayerName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
        .OrderBy(p => p.RankPosition)
        .ToList();

    private IReadOnlyList<TopScorerEntryDto> FilteredScorers => ActiveTab == "Assists"
        ? ScorersList
            .Where(p => string.IsNullOrWhiteSpace(SearchTerm) || p.PlayerName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(p => p.Assists)
            .ToList()
        : ScorersList
            .Where(p => string.IsNullOrWhiteSpace(SearchTerm) || p.PlayerName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(p => p.Goals)
            .ToList();

    private IReadOnlyList<AttendanceEntryDto> FilteredAttendance => AttendanceList
        .Where(p => string.IsNullOrWhiteSpace(SearchTerm) || p.PlayerName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(p => p.AttendancePercentage)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAllDataAsync();
    }

    private async Task LoadAllDataAsync()
    {
        IsLoading = true;
        try
        {
            var general = await RankingApiService.GetRankingAsync();
            var scorers = await RankingApiService.GetTopScorersAsync();
            var attendance = await RankingApiService.GetAttendanceAsync();

            GeneralRanking = general.ToList();
            ScorersList = scorers.ToList();
            AttendanceList = attendance.ToList();

            if (GeneralRanking.Count == 0)
            {
                // Mock data fallback se API vazia
                GeneralRanking = new List<RankingEntryDto>
                {
                    new(Guid.NewGuid(), "Zico Santos", "Galinho", null, 42, 14, 12, 1, 1, 1),
                    new(Guid.NewGuid(), "Pelé Nascimento", "Rei", null, 38, 14, 11, 2, 1, 2),
                    new(Guid.NewGuid(), "Romário Farias", "Baixinho", null, 35, 13, 10, 2, 1, 3)
                };

                ScorersList = new List<TopScorerEntryDto>
                {
                    new(Guid.NewGuid(), "Zico Santos", "Galinho", null, 18, 9, 14, 1.28),
                    new(Guid.NewGuid(), "Romário Farias", "Baixinho", null, 15, 6, 13, 1.15),
                    new(Guid.NewGuid(), "Pelé Nascimento", "Rei", null, 12, 11, 14, 0.85)
                };

                AttendanceList = new List<AttendanceEntryDto>
                {
                    new(Guid.NewGuid(), "Zico Santos", "Galinho", null, 14, 14, 100.0),
                    new(Guid.NewGuid(), "Pelé Nascimento", "Rei", null, 14, 14, 100.0),
                    new(Guid.NewGuid(), "Romário Farias", "Baixinho", null, 13, 14, 92.8)
                };
            }
        }
        catch (Exception ex)
        {
            SetAlert($"Erro ao carregar estatísticas: {ex.Message}", isError: true);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void SelectGeneralTab() => ActiveTab = "General";
    private void SelectScorersTab() => ActiveTab = "Scorers";
    private void SelectAssistsTab() => ActiveTab = "Assists";
    private void SelectAttendanceTab() => ActiveTab = "Attendance";

    private async Task RebuildRankingAsync()
    {
        var (success, error) = await RankingApiService.RebuildRankingAsync();
        if (success)
        {
            SetAlert("Ranking recalculado e atualizado com sucesso!");
            await LoadAllDataAsync();
        }
        else
        {
            SetAlert(error ?? "Erro ao recalcular ranking.", isError: true);
        }
    }

    private void SetAlert(string message, bool isError = false)
    {
        AlertMessage = message;
        IsAlertError = isError;
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "A";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..1].ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }
}
