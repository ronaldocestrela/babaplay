@page "/communication/team-chat"
@attribute [Authorize]
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.SignalR
@using BabaPlay.Web.Services.State
@using BabaPlay.Web.Components.Common
@using Microsoft.AspNetCore.SignalR.Client
@inject ISignalRChatService ChatService
@inject TenantState TenantState
@inject UserSessionState UserSessionState
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>Chat da Turma | Baba Play</PageTitle>

<div class="container-fluid py-4 d-flex flex-column team-chat-page" data-testid="team-chat-page">
    <div class="page-header mb-3">
        <div>
            <h1 class="page-header__title text-gradient">Chat da Turma</h1>
            <p class="page-header__subtitle">Espaço exclusivo de resenha e avisos em tempo real da associação.</p>
        </div>
        <div class="team-chat-status" data-testid="connection-status">
            @if (ChatService.IsConnected)
            {
                <span class="team-chat-status__dot team-chat-status__dot--online" aria-hidden="true"></span>
                <small class="team-chat-status__label amount-income">Ao Vivo (Conectado)</small>
            }
            else if (ChatService.State == HubConnectionState.Connecting || ChatService.State == HubConnectionState.Reconnecting)
            {
                <span class="team-chat-status__dot team-chat-status__dot--pending" aria-hidden="true"></span>
                <small class="team-chat-status__label text-muted">
                    @(ChatService.State == HubConnectionState.Reconnecting ? "Reconectando..." : "Conectando...")
                </small>
            }
            else
            {
                <span class="team-chat-status__dot team-chat-status__dot--offline" aria-hidden="true"></span>
                <small class="team-chat-status__label amount-expense">Desconectado</small>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        @onclick="RetryConnectionAsync"
                        data-testid="btn-retry-connection">
                    Tentar novamente
                </button>
            }
        </div>
    </div>

    <div class="widget-card team-chat-panel flex-grow-1 d-flex flex-column mb-0 p-0 overflow-hidden">
        <div class="team-chat-messages flex-grow-1 overflow-auto" id="chat-message-container" data-testid="chat-messages-list">
            @if (_isLoading)
            {
                <div class="my-auto text-center" data-testid="chat-loading">
                    <LoadingSpinner Message="Carregando mensagens do chat..." />
                </div>
            }
            else if (_messages.Count == 0)
            {
                <div class="my-auto">
                    <EmptyState IconClass="bi-chat-dots"
                                Title="Nenhuma mensagem por aqui ainda"
                                Hint="Mande a primeira mensagem para esquentar o baba!"
                                TestId="chat-empty" />
                </div>
            }
            else
            {
                @foreach (var msg in _messages)
                {
                    var isMine = IsUserMessage(msg);
                    <div class="team-chat-bubble @(isMine ? "team-chat-bubble--mine" : "team-chat-bubble--theirs")"
                         data-testid="chat-message-item">
                        <div class="team-chat-bubble__meta">
                            <span class="team-chat-bubble__sender">@(isMine ? "Você" : msg.SenderName)</span>
                            <span class="team-chat-bubble__time">@msg.SentAtUtc.ToLocalTime().ToString("HH:mm")</span>
                        </div>
                        <div class="team-chat-bubble__content">
                            @msg.Content
                        </div>
                    </div>
                }
            }
        </div>

        <div class="team-chat-composer">
            <div class="input-group">
                <input type="text"
                       class="form-control"
                       placeholder="Escreva sua mensagem..."
                       @bind="_newMessageText"
                       @bind:event="oninput"
                       @onkeyup="HandleKeyUp"
                       disabled="@_isSending"
                       aria-label="Mensagem do chat"
                       data-testid="input-chat-message" />
                <button class="btn btn-primary font-weight-bold d-flex align-items-center gap-2"
                        @onclick="SendMessageAsync"
                        disabled="@(string.IsNullOrWhiteSpace(_newMessageText) || _isSending)"
                        data-testid="btn-send-message">
                    @if (_isSending)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    }
                    else
                    {
                        <span>Enviar</span>
                        <i class="bi bi-send-fill" aria-hidden="true"></i>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ChatMessageDto> _messages = [];
    private string _newMessageText = string.Empty;
    private bool _isLoading = true;
    private bool _isSending = false;

    protected override async Task OnInitializedAsync()
    {
        ChatService.OnMessageReceived += HandleMessageReceived;
        ChatService.OnStateChanged += HandleStateChanged;

        await LoadHistoryAsync();
        await InitializeSignalRAsync();
    }

    private async Task LoadHistoryAsync()
    {
        _isLoading = true;
        try
        {
            _messages = await ChatService.GetRecentMessagesAsync();
        }
        catch
        {
            // Graceful handling
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task InitializeSignalRAsync()
    {
        var tenantId = TenantState.CurrentTenantId ?? Guid.Empty;
        var tenantSlug = TenantState.CurrentTenantSlug;
        var token = UserSessionState.JwtToken ?? string.Empty;
        await ChatService.ConnectAsync(token, tenantSlug, tenantId);
    }

    private async Task RetryConnectionAsync()
    {
        await InitializeSignalRAsync();
    }

    private void HandleMessageReceived(ChatMessageDto message)
    {
        InvokeAsync(() =>
        {
            if (!_messages.Any(m => m.Id == message.Id))
            {
                _messages.Add(message);
                StateHasChanged();
                ScrollToBottom();
            }
        });
    }

    private void HandleStateChanged(Microsoft.AspNetCore.SignalR.Client.HubConnectionState state)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(_newMessageText) || _isSending)
            return;

        _isSending = true;
        var textToSend = _newMessageText;
        _newMessageText = string.Empty;

        try
        {
            var success = await ChatService.SendMessageAsync(textToSend);
            if (!success)
            {
                _newMessageText = textToSend;
            }
        }
        finally
        {
            _isSending = false;
            StateHasChanged();
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessageAsync();
        }
    }

    private bool IsUserMessage(ChatMessageDto msg)
    {
        if (UserSessionState.UserId != null && Guid.TryParse(UserSessionState.UserId, out var myUserId))
        {
            return msg.SenderId == myUserId;
        }
        return false;
    }

    private void ScrollToBottom()
    {
        try
        {
            _ = JSRuntime.InvokeVoidAsync("eval", "var el = document.getElementById('chat-message-container'); if(el) el.scrollTop = el.scrollHeight;");
        }
        catch
        {
            // Ignore JS interop failure in test environments
        }
    }

    public async ValueTask DisposeAsync()
    {
        ChatService.OnMessageReceived -= HandleMessageReceived;
        ChatService.OnStateChanged -= HandleStateChanged;
        await ChatService.DisconnectAsync();
    }
}
