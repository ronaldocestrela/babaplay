@page "/communication/notifications"
@attribute [Authorize]
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@using BabaPlay.Web.Components.Auth
@using BabaPlay.Web.Components.Communication
@inject INotificationApiService NotificationApiService

<PageTitle>Central de Notificações | Baba Play</PageTitle>

<div class="container-fluid py-4" data-testid="notifications-page">
    <div class="page-header">
        <div>
            <h1 class="page-header__title text-gradient">
                Central de Notificações
                @if (UnreadCount > 0)
                {
                    <span class="badge badge-danger ms-2" data-testid="unread-badge">
                        @UnreadCount não lida(s)
                    </span>
                }
            </h1>
            <p class="page-header__subtitle">Histórico completo de alertas, avisos, cobranças e convocações.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <CommunicationWriteView>
                <button class="btn btn-success btn-sm font-weight-bold"
                        @onclick="OpenCreateModal"
                        data-testid="btn-new-notification">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Enviar Alerta
                </button>
            </CommunicationWriteView>
            @if (UnreadCount > 0)
            {
                <button class="btn btn-outline-primary btn-sm font-weight-bold"
                        @onclick="MarkAllAsReadAsync"
                        data-testid="btn-mark-all-read-page">
                    <i class="bi bi-check2-all me-1" aria-hidden="true"></i> Marcar todas como lidas
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success mb-4" role="alert" data-testid="notifications-success-alert">
            <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>
            @SuccessMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger mb-4" role="alert" data-testid="notifications-error-alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
            @ErrorMessage
        </div>
    }

    <div class="widget-card filters-toolbar mb-4" data-testid="notifications-filter-bar">
        <div class="nav nav-pills match-list-filters flex-wrap gap-1" role="group" aria-label="Filtro de notificações">
            <button type="button"
                    class="nav-link @(ReadFilter == "all" ? "active" : "")"
                    @onclick='() => SetFilter("all")'
                    data-testid="filter-all">
                Todas (@(_allNotifications?.Count ?? 0))
            </button>
            <button type="button"
                    class="nav-link @(ReadFilter == "unread" ? "active" : "")"
                    @onclick='() => SetFilter("unread")'
                    data-testid="filter-unread">
                Não Lidas (@UnreadCount)
            </button>
        </div>
    </div>

    @if (IsLoading)
    {
        <div data-testid="notifications-loading">
            <LoadingSpinner Message="Carregando notificações..." />
        </div>
    }
    else if (FilteredNotifications.Count == 0)
    {
        <EmptyState IsPageLevel="true"
                    IconClass="bi-bell"
                    Title="Nenhuma notificação encontrada"
                    Hint="@(ReadFilter == "unread" ? "Você já leu todas as suas notificações!" : "Você ainda não possui alertas registrados.")"
                    TestId="empty-notifications-page" />
    }
    else
    {
        <div class="widget-card overflow-hidden p-0" data-testid="notifications-list">
            <div class="list-group list-group-flush notifications-list">
                @foreach (var item in FilteredNotifications)
                {
                    <div class="list-group-item notification-item @(item.IsRead ? "notification-item--read" : "notification-item--unread")"
                         data-testid="notification-card-item">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                            <h2 class="notification-item__title mb-0">
                                <i class="bi @GetNotificationIcon(item.Type) me-1" aria-hidden="true"></i>
                                @item.Title
                            </h2>
                            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                <small class="text-muted">
                                    @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </small>
                                @if (!item.IsRead)
                                {
                                    <button class="btn btn-sm btn-outline-success"
                                            @onclick="() => HandleMarkReadAsync(item)"
                                            data-testid="btn-mark-read-item">
                                        <i class="bi bi-check-lg me-1" aria-hidden="true"></i> Lido
                                    </button>
                                }
                            </div>
                        </div>
                        <p class="notification-item__message mb-0">
                            @item.Message
                        </p>
                    </div>
                }
            </div>
        </div>
    }
</div>

<CreateNotificationModal IsOpen="_isCreateModalOpen"
                         OnClose="CloseCreateModal"
                         OnSent="HandleNotificationSentAsync" />

@code {
    private List<NotificationDto>? _allNotifications;
    private bool IsLoading = true;
    private bool _isCreateModalOpen;
    private string? ErrorMessage;
    private string? SuccessMessage;
    private string ReadFilter = "all";
    private int UnreadCount = 0;

    private List<NotificationDto> FilteredNotifications
    {
        get
        {
            if (_allNotifications is null) return [];

            return ReadFilter switch
            {
                "unread" => _allNotifications.Where(n => !n.IsRead).ToList(),
                _ => _allNotifications,
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadNotificationsAsync();
    }

    private async Task LoadNotificationsAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var summary = await NotificationApiService.GetNotificationsAsync(onlyUnread: false, limit: 50);
            if (summary is null)
            {
                ErrorMessage = "Não foi possível carregar as notificações. Verifique sua conexão.";
            }
            else
            {
                UnreadCount = summary.UnreadCount;
                _allNotifications = summary.Notifications ?? [];
            }
        }
        catch
        {
            ErrorMessage = "Erro inesperado ao carregar notificações.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task HandleMarkReadAsync(NotificationDto item)
    {
        var success = await NotificationApiService.MarkAsReadAsync(item.Id);
        if (success && _allNotifications != null)
        {
            UnreadCount = Math.Max(0, UnreadCount - 1);
            var idx = _allNotifications.IndexOf(item);
            if (idx >= 0)
            {
                _allNotifications[idx] = item with { IsRead = true };
            }
            StateHasChanged();
        }
    }

    private async Task MarkAllAsReadAsync()
    {
        var success = await NotificationApiService.MarkAllAsReadAsync();
        if (success && _allNotifications != null)
        {
            UnreadCount = 0;
            _allNotifications = _allNotifications.Select(n => n with { IsRead = true }).ToList();
            StateHasChanged();
        }
    }

    private void SetFilter(string filter) => ReadFilter = filter;

    private void OpenCreateModal()
    {
        SuccessMessage = null;
        _isCreateModalOpen = true;
    }

    private void CloseCreateModal() => _isCreateModalOpen = false;

    private async Task HandleNotificationSentAsync(int createdCount)
    {
        SuccessMessage = createdCount == 1
            ? "Alerta enviado para 1 membro."
            : $"Alerta enviado para {createdCount} membros.";
        await LoadNotificationsAsync();
    }

    private static string GetNotificationIcon(int type) => type switch
    {
        1 => "bi-calendar-event",
        2 => "bi-person-check",
        3 => "bi-dribbble",
        4 => "bi-cash-coin",
        5 => "bi-megaphone",
        _ => "bi-bell"
    };
}
