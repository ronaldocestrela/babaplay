@page "/communication/polls"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Auth
@using BabaPlay.Web.Components.Communication
@using BabaPlay.Web.Components.Common
@inject ICommunicationApiService CommunicationApiService

<PageTitle>Enquetes Interativas | Baba Play</PageTitle>

<div class="container-fluid py-4" data-testid="polls-page">
    <div class="page-header">
        <div>
            <h1 class="page-header__title text-gradient">
                Enquetes Interativas
                @if (PendingCount > 0)
                {
                    <span class="badge badge-warning ms-2" data-testid="pending-badge">
                        @PendingCount pendente(s)
                    </span>
                }
            </h1>
            <p class="page-header__subtitle">Votações oficiais da associação para decisões em equipe.</p>
        </div>
        <CommunicationWriteView>
            <button class="btn btn-success btn-sm font-weight-bold"
                    @onclick="OpenCreateModal"
                    data-testid="btn-new-poll">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Nova Enquete
            </button>
        </CommunicationWriteView>
    </div>

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" data-testid="success-toast">
            <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>
            @SuccessMessage
            <button type="button" class="btn-close" @onclick="() => SuccessMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger mb-4" role="alert" data-testid="polls-error-alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
            @ErrorMessage
        </div>
    }

    <div class="widget-card filters-toolbar mb-4" data-testid="polls-filter-bar">
        <div class="nav nav-pills match-list-filters flex-wrap gap-1" role="group" aria-label="Filtro de enquetes">
            <button type="button"
                    class="nav-link @(StatusFilter == "all" ? "active" : "")"
                    @onclick='() => SetFilter("all")'
                    data-testid="filter-all">
                Todas (@(_allPolls?.Count ?? 0))
            </button>
            <button type="button"
                    class="nav-link @(StatusFilter == "pending" ? "active" : "")"
                    @onclick='() => SetFilter("pending")'
                    data-testid="filter-pending">
                Pendentes de Voto (@PendingCount)
            </button>
            <button type="button"
                    class="nav-link @(StatusFilter == "closed" ? "active" : "")"
                    @onclick='() => SetFilter("closed")'
                    data-testid="filter-closed">
                Encerradas (@(_allPolls?.Count(p => p.IsClosed) ?? 0))
            </button>
        </div>
    </div>

    @if (IsLoading)
    {
        <div data-testid="polls-loading">
            <LoadingSpinner Message="Carregando enquetes da associação..." />
        </div>
    }
    else if (FilteredPolls.Count == 0)
    {
        <EmptyState IsPageLevel="true"
                    IconClass="bi-bar-chart"
                    Title="Nenhuma enquete por aqui"
                    Hint="@(StatusFilter == "pending" ? "Você já votou em todas as enquetes ativas!" : "A diretoria ainda não criou enquetes.")"
                    TestId="empty-polls" />
    }
    else
    {
        <div data-testid="polls-list">
            @foreach (var poll in FilteredPolls)
            {
                <PollCard Poll="poll"
                          OnVoteSubmitted="(optId) => HandleVoteAsync(poll, optId)"
                          OnPollClosed="() => HandleClosePollAsync(poll)" />
            }
        </div>
    }
</div>

<CreatePollModal IsOpen="IsCreateModalOpen"
                 OnClose="CloseCreateModal"
                 OnCreated="HandlePollCreated" />

@code {
    private List<PollDto>? _allPolls;
    private bool IsLoading = true;
    private string? ErrorMessage;
    private string? SuccessMessage;
    private bool IsCreateModalOpen = false;
    private string StatusFilter = "all";

    private int PendingCount => _allPolls?.Count(p => !p.IsClosed && !p.HasVoted) ?? 0;

    private List<PollDto> FilteredPolls
    {
        get
        {
            if (_allPolls is null) return [];

            return StatusFilter switch
            {
                "pending" => _allPolls.Where(p => !p.IsClosed && !p.HasVoted).ToList(),
                "closed" => _allPolls.Where(p => p.IsClosed).ToList(),
                _ => _allPolls,
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPollsAsync();
    }

    private async Task LoadPollsAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            _allPolls = await CommunicationApiService.GetPollsAsync(onlyActive: false);
            if (_allPolls is null)
                ErrorMessage = "Não foi possível carregar as enquetes. Verifique sua conexão.";
        }
        catch
        {
            ErrorMessage = "Erro inesperado ao carregar enquetes.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task HandleVoteAsync(PollDto poll, Guid optionId)
    {
        try
        {
            var updated = await CommunicationApiService.SubmitPollVoteAsync(poll.Id, new SubmitPollVoteDto { OptionId = optionId });
            if (updated != null && _allPolls != null)
            {
                var idx = _allPolls.FindIndex(p => p.Id == poll.Id);
                if (idx >= 0)
                {
                    _allPolls[idx] = updated;
                }
                SuccessMessage = "Voto computado com sucesso!";
                StateHasChanged();
            }
            else
            {
                ErrorMessage = "Não foi possível registrar o voto.";
            }
        }
        catch
        {
            ErrorMessage = "Erro ao registrar voto na enquete.";
        }
    }

    private async Task HandleClosePollAsync(PollDto poll)
    {
        try
        {
            var success = await CommunicationApiService.ClosePollAsync(poll.Id);
            if (success && _allPolls != null)
            {
                var idx = _allPolls.FindIndex(p => p.Id == poll.Id);
                if (idx >= 0)
                {
                    _allPolls[idx] = _allPolls[idx] with { IsClosed = true };
                }
                SuccessMessage = $"Enquete \"{poll.Title}\" encerrada.";
                StateHasChanged();
            }
        }
        catch
        {
            ErrorMessage = "Erro ao encerrar enquete.";
        }
    }

    private void HandlePollCreated(PollDto created)
    {
        _allPolls ??= [];
        _allPolls.Insert(0, created);
        SuccessMessage = $"Enquete \"{created.Title}\" criada com sucesso!";
    }

    private void SetFilter(string filter)
    {
        StatusFilter = filter;
    }

    private void OpenCreateModal() => IsCreateModalOpen = true;

    private void CloseCreateModal() => IsCreateModalOpen = false;
}
