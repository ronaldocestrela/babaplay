@page "/communication/announcements"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Auth
@using BabaPlay.Web.Components.Communication
@using BabaPlay.Web.Components.Common
@inject ICommunicationApiService CommunicationApiService

<PageTitle>Comunicados | Baba Play</PageTitle>

<div class="container-fluid py-4" data-testid="announcements-page">
    <div class="page-header">
        <div>
            <h1 class="page-header__title text-gradient">
                Mural de Avisos
                @if (UnreadCount > 0)
                {
                    <span class="badge badge-danger ms-2" data-testid="unread-badge">
                        @UnreadCount não lido(s)
                    </span>
                }
            </h1>
            <p class="page-header__subtitle">Comunicados oficiais da associação para todos os membros.</p>
        </div>
        <CommunicationWriteView>
            <button class="btn btn-success btn-sm font-weight-bold"
                    @onclick="OpenCreateModal"
                    data-testid="btn-new-announcement">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Novo Comunicado
            </button>
        </CommunicationWriteView>
    </div>

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" data-testid="success-toast">
            <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>
            @SuccessMessage
            <button type="button" class="btn-close" @onclick="() => SuccessMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger mb-4" role="alert" data-testid="announcements-error-alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
            @ErrorMessage
        </div>
    }

    <div class="widget-card filters-toolbar mb-4" data-testid="announcements-filter-bar">
        <div class="nav nav-pills match-list-filters flex-wrap gap-1" role="group" aria-label="Filtro de leitura">
            <button type="button"
                    class="nav-link @(ReadFilter == "all" ? "active" : "")"
                    @onclick='() => SetFilter("all")'
                    data-testid="filter-all">
                Todos (@(_allAnnouncements?.Count ?? 0))
            </button>
            <button type="button"
                    class="nav-link @(ReadFilter == "unread" ? "active" : "")"
                    @onclick='() => SetFilter("unread")'
                    data-testid="filter-unread">
                Não Lidos (@UnreadCount)
            </button>
        </div>
    </div>

    @if (IsLoading)
    {
        <div data-testid="announcements-loading">
            <LoadingSpinner Message="Carregando comunicados da associação..." />
        </div>
    }
    else if (FilteredAnnouncements.Count == 0)
    {
        <EmptyState IsPageLevel="true"
                    IconClass="bi-mailbox"
                    Title="Nenhum comunicado por aqui"
                    Hint="@(ReadFilter == "unread" ? "Você leu todos os comunicados disponíveis!" : "A diretoria ainda não publicou comunicados.")"
                    TestId="empty-announcements" />
    }
    else
    {
        <div data-testid="announcements-list">
            @foreach (var item in FilteredAnnouncements)
            {
                <AnnouncementCard Announcement="item"
                                  OnRead="() => HandleMarkReadAsync(item)" />
            }
        </div>
    }
</div>

<CreateAnnouncementModal IsOpen="IsCreateModalOpen"
                         OnClose="CloseCreateModal"
                         OnCreated="HandleAnnouncementCreated" />

@code {
    private List<AnnouncementDto>? _allAnnouncements;
    private bool IsLoading = true;
    private string? ErrorMessage;
    private string? SuccessMessage;
    private bool IsCreateModalOpen = false;
    private string ReadFilter = "all";

    private int UnreadCount => _allAnnouncements?.Count(a => !a.IsRead) ?? 0;

    private List<AnnouncementDto> FilteredAnnouncements
    {
        get
        {
            if (_allAnnouncements is null) return [];

            return ReadFilter switch
            {
                "unread" => _allAnnouncements.Where(a => !a.IsRead).ToList(),
                _ => _allAnnouncements,
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAnnouncementsAsync();
    }

    private async Task LoadAnnouncementsAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            _allAnnouncements = await CommunicationApiService.GetAnnouncementsAsync();
            if (_allAnnouncements is null)
                ErrorMessage = "Não foi possível carregar os comunicados. Verifique sua conexão.";
        }
        catch
        {
            ErrorMessage = "Erro inesperado ao carregar comunicados.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task HandleMarkReadAsync(AnnouncementDto item)
    {
        var success = await CommunicationApiService.MarkAnnouncementReadAsync(item.Id);
        if (success)
        {
            var idx = _allAnnouncements!.IndexOf(item);
            if (idx >= 0)
                _allAnnouncements[idx] = item with { IsRead = true };

            StateHasChanged();
        }
    }

    private void HandleAnnouncementCreated(AnnouncementDto created)
    {
        _allAnnouncements ??= [];
        _allAnnouncements.Insert(0, created);
        SuccessMessage = $"Comunicado \"{created.Title}\" publicado com sucesso!";
    }

    private void SetFilter(string filter)
    {
        ReadFilter = filter;
    }

    private void OpenCreateModal() => IsCreateModalOpen = true;

    private void CloseCreateModal() => IsCreateModalOpen = false;
}
