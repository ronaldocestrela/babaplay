@page "/complete-profile"
@attribute [Authorize]
@inject IPlayerApiService PlayerApiService
@inject NavigationManager NavigationManager

<PageTitle>Conclusão de Perfil do Atleta - Baba Play</PageTitle>

<div class="min-h-screen bg-slate-900 text-white py-12 px-4 sm:px-6 lg:px-8 flex justify-center items-center">
    <div class="max-w-xl w-full bg-slate-800/80 p-8 rounded-2xl border border-slate-700 shadow-2xl backdrop-blur-md space-y-6">
        <div class="text-center">
            <h1 class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-200">
                Complete Seu Perfil de Atleta
            </h1>
            <p class="mt-2 text-sm text-slate-400">
                Informe seus dados para que a comissão técnica e o algoritmo de sorteio possam escalá-lo corretamente.
            </p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div id="profile-error-alert" class="p-4 rounded-lg bg-rose-500/10 border border-rose-500/30 text-rose-300 text-sm flex items-center gap-2">
                <svg class="w-5 h-5 shrink-0 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>@errorMessage</span>
            </div>
        }

        <EditForm Model="@profileModel" OnValidSubmit="HandleCompleteProfileAsync" id="complete-profile-form">
            <DataAnnotationsValidator />

            <div class="space-y-4">
                <div>
                    <label for="player-name" class="block text-sm font-medium text-slate-300 mb-1">Nome Completo *</label>
                    <InputText id="player-name" @bind-Value="profileModel.Name" class="w-full px-4 py-2.5 bg-slate-900/90 border border-slate-700 rounded-lg text-slate-100 placeholder-slate-500 focus:ring-2 focus:ring-emerald-500 focus:outline-none" placeholder="Ex: Ronaldo Cestrela" />
                    <ValidationMessage For="@(() => profileModel.Name)" class="text-rose-400 text-xs mt-1" />
                </div>

                <div>
                    <label for="player-nickname" class="block text-sm font-medium text-slate-300 mb-1">Apelido (Como é chamado no baba) *</label>
                    <InputText id="player-nickname" @bind-Value="profileModel.Nickname" class="w-full px-4 py-2.5 bg-slate-900/90 border border-slate-700 rounded-lg text-slate-100 placeholder-slate-500 focus:ring-2 focus:ring-emerald-500 focus:outline-none" placeholder="Ex: Rony" />
                    <ValidationMessage For="@(() => profileModel.Nickname)" class="text-rose-400 text-xs mt-1" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label for="preferred-foot" class="block text-sm font-medium text-slate-300 mb-1">Pé Preferido *</label>
                        <InputSelect id="preferred-foot" @bind-Value="profileModel.PreferredFoot" class="w-full px-4 py-2.5 bg-slate-900/90 border border-slate-700 rounded-lg text-slate-100 focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                            <option value="Right">Destro</option>
                            <option value="Left">Canhoto</option>
                            <option value="Both">Ambidestro</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => profileModel.PreferredFoot)" class="text-rose-400 text-xs mt-1" />
                    </div>

                    <div>
                        <label for="jersey-number" class="block text-sm font-medium text-slate-300 mb-1">Nº da Camisa (Opcional)</label>
                        <InputNumber id="jersey-number" @bind-Value="profileModel.JerseyNumber" class="w-full px-4 py-2.5 bg-slate-900/90 border border-slate-700 rounded-lg text-slate-100 focus:ring-2 focus:ring-emerald-500 focus:outline-none" placeholder="10" />
                        <ValidationMessage For="@(() => profileModel.JerseyNumber)" class="text-rose-400 text-xs mt-1" />
                    </div>
                </div>

                <div>
                    <label for="primary-position" class="block text-sm font-medium text-slate-300 mb-1">Posição Principal *</label>
                    @if (isLoadingPositions)
                    {
                        <div class="text-xs text-slate-400">Carregando posições...</div>
                    }
                    else
                    {
                        <InputSelect id="primary-position" @bind-Value="profileModel.PrimaryPositionId" class="w-full px-4 py-2.5 bg-slate-900/90 border border-slate-700 rounded-lg text-slate-100 focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                            <option value="@Guid.Empty">Selecione uma posição...</option>
                            @foreach (var pos in positions)
                            {
                                <option value="@pos.Id">@pos.Name (@pos.Abbreviation)</option>
                            }
                        </InputSelect>
                    }
                    <ValidationMessage For="@(() => profileModel.PrimaryPositionId)" class="text-rose-400 text-xs mt-1" />
                </div>

                <div>
                    <label for="photo-file" class="block text-sm font-medium text-slate-300 mb-1">Foto de Perfil (Opcional)</label>
                    <InputFile id="photo-file" OnChange="OnPhotoSelected" class="w-full px-3 py-2 bg-slate-900/90 border border-slate-700 rounded-lg text-slate-300 text-xs file:mr-4 file:py-1 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-emerald-500 file:text-slate-950 hover:file:bg-emerald-400" />
                </div>
            </div>

            <button type="submit" id="complete-profile-submit" disabled="@isSubmitting" class="w-full mt-6 py-3 px-4 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-slate-950 font-bold rounded-lg shadow-lg hover:shadow-emerald-500/25 transition-all duration-200 disabled:opacity-50 flex items-center justify-center gap-2">
                @if (isSubmitting)
                {
                    <svg class="animate-spin h-5 w-5 text-slate-950" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span>Salvando...</span>
                }
                else
                {
                    <span>Concluir Perfil</span>
                }
            </button>
        </EditForm>
    </div>
</div>

@code {
    private CompleteProfileDto profileModel = new();
    private IReadOnlyList<PositionDto> positions = new List<PositionDto>();
    private IBrowserFile? selectedPhotoFile;
    private bool isLoadingPositions = true;
    private bool isSubmitting = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        isLoadingPositions = true;
        try
        {
            positions = await PlayerApiService.GetPositionsAsync();
            if (positions.Count > 0 && profileModel.PrimaryPositionId == Guid.Empty)
            {
                profileModel.PrimaryPositionId = positions[0].Id;
            }
        }
        finally
        {
            isLoadingPositions = false;
        }
    }

    private void OnPhotoSelected(InputFileChangeEventArgs e)
    {
        selectedPhotoFile = e.File;
    }

    private async Task HandleCompleteProfileAsync()
    {
        if (profileModel.PrimaryPositionId == Guid.Empty)
        {
            errorMessage = "Selecione uma posição válida.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var result = await PlayerApiService.CompleteProfileAsync(profileModel, selectedPhotoFile);
            if (result is not null)
            {
                NavigationManager.NavigateTo("/");
            }
            else
            {
                errorMessage = "Não foi possível salvar os dados do perfil. Tente novamente.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Erro inesperado ao salvar o perfil.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
