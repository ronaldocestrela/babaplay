@page "/players"
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@using BabaPlay.Web.Components.Players
@inject IPlayerApiService PlayerApiService

<PageTitle>Atletas & Membros - Baba Play</PageTitle>

<div class="container-fluid py-4" data-testid="player-list-page">
    <div class="page-header">
        <div>
            <h1 class="page-header__title text-gradient">Gestão de Atletas e Membros</h1>
            <p class="page-header__subtitle">Gerencie a lista de associados, posições esportivas e funções administrativas do time.</p>
        </div>
        <button class="btn btn-outline-primary btn-sm"
                @onclick="LoadDataAsync"
                disabled="@IsLoading"
                data-testid="btn-refresh-players">
            @if (IsRefreshing)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                <span>Atualizando...</span>
            }
            else
            {
                <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>
                <span>Atualizar</span>
            }
        </button>
    </div>

    @if (HasError)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" data-testid="player-list-error">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
            <strong>Erro ao carregar dados:</strong> @ErrorMessage
            <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="LoadDataAsync">Tentar novamente</button>
        </div>
    }

    <div class="widget-card filters-toolbar mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-4">
                <label class="form-label filters-toolbar__label" for="player-search-input">Buscar</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                    <input id="player-search-input"
                           type="text"
                           class="form-control"
                           placeholder="Nome ou apelido..."
                           @bind="SearchTerm"
                           @bind:event="oninput"
                           data-testid="search-input" />
                    @if (!string.IsNullOrWhiteSpace(SearchTerm))
                    {
                        <button class="btn btn-outline-secondary"
                                type="button"
                                aria-label="Limpar busca"
                                @onclick="() => SearchTerm = string.Empty">
                            <i class="bi bi-x" aria-hidden="true"></i>
                        </button>
                    }
                </div>
            </div>

            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label filters-toolbar__label" for="player-position-filter">Posição</label>
                <select id="player-position-filter" class="form-select" @bind="SelectedPositionId" data-testid="position-filter">
                    <option value="">Todas as posições</option>
                    @foreach (var pos in Positions)
                    {
                        <option value="@pos.Id">@pos.Name</option>
                    }
                </select>
            </div>

            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label filters-toolbar__label" for="player-status-filter">Status</label>
                <select id="player-status-filter" class="form-select" @bind="SelectedStatus" data-testid="status-filter">
                    <option value="All">Todos</option>
                    <option value="Active">Ativos</option>
                    <option value="Inactive">Inativos</option>
                </select>
            </div>

            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label filters-toolbar__label" for="player-sort-filter">Ordenar</label>
                <select id="player-sort-filter" class="form-select" @bind="SortBy">
                    <option value="Name">Nome (A-Z)</option>
                    <option value="JerseyNumber">Camisa (#)</option>
                    <option value="Position">Posição</option>
                </select>
            </div>

            <div class="col-12 col-sm-6 col-md-1">
                <label class="form-label filters-toolbar__label">Visualização</label>
                <div class="btn-group w-100 view-mode-toggle" role="group" aria-label="Modo de visualização">
                    <button type="button"
                            class="btn btn-sm @(ViewMode == "grid" ? "btn-outline-primary active" : "btn-outline-secondary")"
                            @onclick='() => ViewMode = "grid"'
                            title="Grade"
                            aria-pressed="@(ViewMode == "grid")">
                        <i class="bi bi-grid-fill" aria-hidden="true"></i>
                    </button>
                    <button type="button"
                            class="btn btn-sm @(ViewMode == "table" ? "btn-outline-primary active" : "btn-outline-secondary")"
                            @onclick='() => ViewMode = "table"'
                            title="Tabela"
                            aria-pressed="@(ViewMode == "table")">
                        <i class="bi bi-list-ul" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (IsInitialLoading)
    {
        <PlayerListSkeleton />
    }
    else if (FilteredPlayers.Count == 0)
    {
        <EmptyState IsPageLevel="true"
                    IconClass="bi-person-x"
                    Title="Nenhum atleta encontrado"
                    Hint="Tente ajustar os filtros ou a busca acima para encontrar o atleta desejado."
                    TestId="empty-state" />
    }
    else
    {
        <div class="list-content @(IsRefreshing ? "list-content--refreshing" : null)">
            <p class="list-summary text-muted small mb-3">
                Exibindo <strong>@FilteredPlayers.Count</strong> de <strong>@Players.Count</strong> atletas.
            </p>

            @if (ViewMode == "grid")
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
                    @foreach (var player in FilteredPlayers)
                    {
                        <div class="col">
                            <PlayerCard Player="player" OnEdit="OpenEditModal" />
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="widget-card overflow-hidden p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 players-table" data-testid="player-table">
                            <thead>
                                <tr>
                                    <th class="d-none d-md-table-cell players-table__col-jersey">#</th>
                                    <th>Atleta</th>
                                    <th>Posição</th>
                                    <th class="d-none d-md-table-cell">Telefone</th>
                                    <th class="d-none d-lg-table-cell">Perfil</th>
                                    <th>Status</th>
                                    <th class="text-end">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var player in FilteredPlayers)
                                {
                                    <tr>
                                        <td class="font-weight-bold d-none d-md-table-cell">
                                            @(player.JerseyNumber.HasValue ? $"#{player.JerseyNumber}" : "-")
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="player-avatar-sm me-2">@GetInitials(player.Name)</div>
                                                <div>
                                                    <div class="font-weight-bold">@player.Name</div>
                                                    @if (!string.IsNullOrWhiteSpace(player.Nickname))
                                                    {
                                                        <small class="text-muted">"@player.Nickname"</small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge badge-secondary">
                                                @(string.IsNullOrWhiteSpace(player.PrimaryPositionName) ? "Não definida" : player.PrimaryPositionName)
                                            </span>
                                        </td>
                                        <td class="d-none d-md-table-cell text-muted">
                                            @(string.IsNullOrWhiteSpace(player.Phone) ? "-" : player.Phone)
                                        </td>
                                        <td class="d-none d-lg-table-cell">
                                            <span class="badge @GetRoleBadgeClass(player.RoleName)">
                                                @(string.IsNullOrWhiteSpace(player.RoleName) ? "Atleta" : player.RoleName)
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge @(player.IsActive ? "badge-success" : "badge-secondary")">
                                                @(player.IsActive ? "Ativo" : "Inativo")
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditModal(player)">
                                                <i class="bi bi-pencil me-1" aria-hidden="true"></i> Editar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }
</div>

<EditPlayerModal IsOpen="IsEditModalOpen"
                 Player="SelectedPlayer"
                 Positions="Positions"
                 Roles="Roles"
                 OnSave="SavePlayerAsync"
                 OnClose="CloseEditModal" />

@code {
    private List<PlayerDto> Players { get; set; } = new();
    private List<PositionDto> Positions { get; set; } = new();
    private List<RoleDto> Roles { get; set; } = new();

    private bool IsLoading { get; set; } = true;
    private bool IsInitialLoading => IsLoading && Players.Count == 0;
    private bool IsRefreshing => IsLoading && Players.Count > 0;
    private bool HasError { get; set; }
    private string? ErrorMessage { get; set; }

    private string SearchTerm { get; set; } = string.Empty;
    private string SelectedPositionId { get; set; } = string.Empty;
    private string SelectedStatus { get; set; } = "All";
    private string SortBy { get; set; } = "Name";
    private string ViewMode { get; set; } = "grid";

    private bool IsEditModalOpen { get; set; }
    private PlayerDto? SelectedPlayer { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        HasError = false;
        ErrorMessage = null;
        try
        {
            var playersTask = PlayerApiService.GetPlayersAsync();
            var positionsTask = PlayerApiService.GetPositionsAsync();
            var rolesTask = PlayerApiService.GetRolesAsync();

            await Task.WhenAll(playersTask, positionsTask, rolesTask);

            Players = (await playersTask).ToList();
            Positions = (await positionsTask).ToList();
            Roles = (await rolesTask).ToList();
        }
        catch (Exception ex)
        {
            HasError = true;
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private List<PlayerDto> FilteredPlayers
    {
        get
        {
            IEnumerable<PlayerDto> result = Players;

            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                var term = SearchTerm.Trim();
                result = result.Where(p =>
                    p.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrWhiteSpace(p.Nickname) && p.Nickname.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            if (!string.IsNullOrWhiteSpace(SelectedPositionId) && Guid.TryParse(SelectedPositionId, out var posGuid))
            {
                result = result.Where(p => p.PrimaryPositionId == posGuid);
            }

            if (SelectedStatus == "Active")
            {
                result = result.Where(p => p.IsActive);
            }
            else if (SelectedStatus == "Inactive")
            {
                result = result.Where(p => !p.IsActive);
            }

            result = SortBy switch
            {
                "JerseyNumber" => result.OrderBy(p => p.JerseyNumber ?? int.MaxValue).ThenBy(p => p.Name),
                "Position" => result.OrderBy(p => p.PrimaryPositionName ?? "ZZZ").ThenBy(p => p.Name),
                _ => result.OrderBy(p => p.Name)
            };

            return result.ToList();
        }
    }

    private void OpenEditModal(PlayerDto player)
    {
        SelectedPlayer = player;
        IsEditModalOpen = true;
    }

    private void CloseEditModal()
    {
        IsEditModalOpen = false;
        SelectedPlayer = null;
    }

    private async Task SavePlayerAsync(UpdatePlayerAdminDto dto)
    {
        if (SelectedPlayer is null) return;

        var success = await PlayerApiService.UpdatePlayerAdminAsync(SelectedPlayer.Id, dto);

        if (dto.RoleId.HasValue && dto.RoleId != SelectedPlayer.RoleId)
        {
            await PlayerApiService.UpdatePlayerRoleAsync(SelectedPlayer.UserId, dto.RoleId.Value);
        }

        if (success)
        {
            CloseEditModal();
            await LoadDataAsync();
        }
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "AP";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private static string GetRoleBadgeClass(string? roleName) => roleName?.ToLower() switch
    {
        "admin" or "administrador" => "badge-warning",
        "treinador" or "coach" => "badge-info",
        _ => "badge-primary"
    };
}
