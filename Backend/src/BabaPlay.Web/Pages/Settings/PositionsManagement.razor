@page "/settings/positions"
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@using BabaPlay.Web.Components.Settings
@inject IPositionApiService PositionApiService

<PageTitle>Posições & Categorias - Baba Play</PageTitle>

<div class="container-fluid py-4" data-testid="positions-management-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 mb-1 font-weight-bold text-gradient">Posições & Categorias Esportivas</h1>
            <p class="text-muted mb-0">Configure as posições jogadas nos babas da sua associação (ex: Goleiro, Fixo, Ala, Pivô, Atacante).</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" @onclick="OpenCreateModal" data-testid="btn-add-position">
                <i class="bi bi-plus-lg me-1"></i> Nova Posição
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(AlertMessage))
    {
        <div class="alert @(IsAlertError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-4" role="alert" data-testid="alert-banner">
            <i class="bi @(IsAlertError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>
            @AlertMessage
            <button type="button" class="btn-close" @onclick="() => AlertMessage = null"></button>
        </div>
    }

    @if (IsLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <LoadingSpinner Message="Carregando posições da associação..." />
        </div>
    }
    else if (Positions.Count == 0)
    {
        <div class="card card-custom py-5 text-center my-4" data-testid="empty-positions-state">
            <div class="card-body">
                <i class="bi bi-shield-x display-4 text-muted mb-3 d-block"></i>
                <h4 class="h5 font-weight-bold">Nenhuma posição cadastrada</h4>
                <p class="text-muted mb-3">Cadastre as posições esportivas para permitir a escalação e o sorteio de times.</p>
                <button class="btn btn-outline-primary" @onclick="OpenCreateModal">
                    <i class="bi bi-plus-lg me-1"></i> Cadastrar Primeira Posição
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="card card-custom shadow-sm overflow-hidden mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" data-testid="positions-table">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 90px;">Sigla</th>
                            <th>Nome da Posição</th>
                            <th>Descrição</th>
                            <th style="width: 100px;">Status</th>
                            <th class="text-end" style="width: 160px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pos in Positions)
                        {
                            <tr data-testid="position-row-@pos.Id">
                                <td>
                                    <span class="badge bg-dark font-weight-bold fs-6">@pos.Code</span>
                                </td>
                                <td>
                                    <span class="font-weight-bold text-dark">@pos.Name</span>
                                </td>
                                <td>
                                    <span class="text-muted">@(string.IsNullOrWhiteSpace(pos.Description) ? "-" : pos.Description)</span>
                                </td>
                                <td>
                                    <span class="badge @(pos.IsActive ? "bg-success" : "bg-secondary")">
                                        @(pos.IsActive ? "Ativa" : "Inativa")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-1 btn-edit-position" @onclick="() => OpenEditModal(pos)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger btn-delete-position" @onclick="() => ConfirmDeleteAsync(pos)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<PositionModal IsOpen="IsModalOpen"
               Position="SelectedPosition"
               OnCreate="HandleCreateAsync"
               OnUpdate="HandleUpdateAsync"
               OnClose="CloseModal" />

@code {
    private List<PositionDto> Positions { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private string? AlertMessage { get; set; }
    private bool IsAlertError { get; set; }

    private bool IsModalOpen { get; set; }
    private PositionDto? SelectedPosition { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadPositionsAsync();
    }

    private async Task LoadPositionsAsync()
    {
        IsLoading = true;
        try
        {
            var result = await PositionApiService.GetPositionsAsync();
            Positions = result.ToList();
        }
        catch (Exception ex)
        {
            SetAlert($"Erro ao carregar posições: {ex.Message}", isError: true);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        SelectedPosition = null;
        IsModalOpen = true;
    }

    private void OpenEditModal(PositionDto position)
    {
        SelectedPosition = position;
        IsModalOpen = true;
    }

    private void CloseModal()
    {
        IsModalOpen = false;
        SelectedPosition = null;
    }

    private async Task HandleCreateAsync(CreatePositionDto dto)
    {
        var (success, error) = await PositionApiService.CreatePositionAsync(dto);
        if (success)
        {
            CloseModal();
            SetAlert("Posição criada com sucesso!");
            await LoadPositionsAsync();
        }
        else
        {
            SetAlert(error ?? "Erro ao criar posição.", isError: true);
        }
    }

    private async Task HandleUpdateAsync(UpdatePositionDto dto)
    {
        if (SelectedPosition is null) return;

        var (success, error) = await PositionApiService.UpdatePositionAsync(SelectedPosition.Id, dto);
        if (success)
        {
            CloseModal();
            SetAlert("Posição atualizada com sucesso!");
            await LoadPositionsAsync();
        }
        else
        {
            SetAlert(error ?? "Erro ao atualizar posição.", isError: true);
        }
    }

    private async Task ConfirmDeleteAsync(PositionDto position)
    {
        var (success, error) = await PositionApiService.DeletePositionAsync(position.Id);
        if (success)
        {
            SetAlert($"Posição '{position.Name}' excluída com sucesso.");
            await LoadPositionsAsync();
        }
        else
        {
            SetAlert(error ?? "Não foi possível excluir a posição.", isError: true);
        }
    }

    private void SetAlert(string message, bool isError = false)
    {
        AlertMessage = message;
        IsAlertError = isError;
    }
}
