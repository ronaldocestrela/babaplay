@page "/settings/tenant"
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@using BabaPlay.Web.Components.Settings
@inject ITenantApiService TenantApiService

<PageTitle>Configurações da Associação - Baba Play</PageTitle>

<div class="container-fluid py-4" data-testid="tenant-settings-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 mb-1 font-weight-bold text-gradient">Configurações da Associação</h1>
            <p class="text-muted mb-0">Gerencie as preferências gerais, escudo, regras de sorteio e agendamento dos babas.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" data-testid="settings-page-error">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @ErrorMessage
            <button type="button" class="btn-close" @onclick="() => ErrorMessage = null"></button>
        </div>
    }

    @if (IsLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <LoadingSpinner Message="Carregando configurações da associação..." />
        </div>
    }
    else
    {
        <!-- Navegação por Abas -->
        <ul class="nav nav-tabs border-bottom mb-4" role="tablist" data-testid="settings-tabs">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(ActiveTab == "general" ? "active font-weight-bold" : "")"
                        @onclick='() => ActiveTab = "general"'
                        data-testid="tab-general">
                    <i class="bi bi-sliders me-2"></i> Geral & Identidade
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(ActiveTab == "gamedays" ? "active font-weight-bold" : "")"
                        @onclick='() => ActiveTab = "gamedays"'
                        data-testid="tab-gamedays">
                    <i class="bi bi-calendar-week me-2"></i> Dias Fixos do Baba
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(ActiveTab == "invite" ? "active font-weight-bold" : "")"
                        @onclick='() => ActiveTab = "invite"'
                        data-testid="tab-invite">
                    <i class="bi bi-share me-2"></i> Link de Convite
                </button>
            </li>
        </ul>

        <div class="tab-content">
            @if (ActiveTab == "general")
            {
                <TenantGeneralSettingsWidget InitialSettings="Settings" OnSettingsUpdated="HandleSettingsUpdated" />
            }
            else if (ActiveTab == "gamedays")
            {
                <TenantGameDayOptionsWidget />
            }
            else if (ActiveTab == "invite")
            {
                <TenantInviteLinkWidget Slug="@Settings?.Slug" />
            }
        </div>
    }
</div>

@code {
    private TenantSettingsDto? Settings { get; set; }
    private string ActiveTab { get; set; } = "general";
    private bool IsLoading { get; set; } = true;
    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadSettingsAsync();
    }

    private async Task LoadSettingsAsync()
    {
        IsLoading = true;
        try
        {
            Settings = await TenantApiService.GetSettingsAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao carregar configurações: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void HandleSettingsUpdated(TenantSettingsDto updated)
    {
        Settings = updated;
    }
}
