@page "/settings/tenant"
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@using BabaPlay.Web.Components.Settings
@inject ITenantApiService TenantApiService

<PageTitle>Configurações da Associação - Baba Play</PageTitle>

<div class="container-fluid py-4" data-testid="tenant-settings-page">
    <div class="page-header">
        <div>
            <h1 class="page-header__title text-gradient">Configurações da Associação</h1>
            <p class="page-header__subtitle">Gerencie as preferências gerais, escudo, regras de sorteio e agendamento dos babas.</p>
        </div>
        <button class="btn btn-outline-primary btn-sm"
                @onclick="LoadSettingsAsync"
                disabled="@IsLoading"
                data-testid="btn-refresh-settings">
            @if (IsRefreshing)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                <span>Atualizando...</span>
            }
            else
            {
                <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>
                <span>Atualizar</span>
            }
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" data-testid="settings-page-error">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
            @ErrorMessage
            <button type="button" class="btn-close" @onclick="() => ErrorMessage = null"></button>
        </div>
    }

    @if (IsInitialLoading)
    {
        <LoadingSpinner Message="Carregando configurações da associação..." />
    }
    else
    {
        <div class="widget-card filters-toolbar mb-4 p-2" data-testid="settings-tabs">
            <div class="nav nav-pills match-list-filters flex-wrap gap-1" role="tablist">
                <button type="button"
                        class="nav-link @(ActiveTab == "general" ? "active" : "")"
                        @onclick='() => ActiveTab = "general"'
                        data-testid="tab-general">
                    <i class="bi bi-sliders me-1" aria-hidden="true"></i> Geral & Identidade
                </button>
                <button type="button"
                        class="nav-link @(ActiveTab == "gamedays" ? "active" : "")"
                        @onclick='() => ActiveTab = "gamedays"'
                        data-testid="tab-gamedays">
                    <i class="bi bi-calendar-week me-1" aria-hidden="true"></i> Dias Fixos do Baba
                </button>
                <button type="button"
                        class="nav-link @(ActiveTab == "invite" ? "active" : "")"
                        @onclick='() => ActiveTab = "invite"'
                        data-testid="tab-invite">
                    <i class="bi bi-share me-1" aria-hidden="true"></i> Link de Convite
                </button>
            </div>
        </div>

        <div class="list-content @(IsRefreshing ? "list-content--refreshing" : null)">
            @if (ActiveTab == "general")
            {
                <TenantGeneralSettingsWidget InitialSettings="Settings" OnSettingsUpdated="HandleSettingsUpdated" />
            }
            else if (ActiveTab == "gamedays")
            {
                <TenantGameDayOptionsWidget />
            }
            else if (ActiveTab == "invite")
            {
                <TenantInviteLinkWidget Slug="@Settings?.Slug" />
            }
        </div>
    }
</div>

@code {
    private TenantSettingsDto? Settings { get; set; }
    private string ActiveTab { get; set; } = "general";
    private bool IsLoading { get; set; } = true;
    private bool HasLoadedOnce { get; set; }
    private string? ErrorMessage { get; set; }

    private bool IsInitialLoading => IsLoading && !HasLoadedOnce;
    private bool IsRefreshing => IsLoading && HasLoadedOnce;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettingsAsync();
    }

    private async Task LoadSettingsAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            Settings = await TenantApiService.GetSettingsAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao carregar configurações: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            HasLoadedOnce = true;
        }
    }

    private void HandleSettingsUpdated(TenantSettingsDto updated)
    {
        Settings = updated;
    }
}
