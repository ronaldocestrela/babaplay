@page "/dashboard"
@page "/"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@using BabaPlay.Web.Components.Dashboard
@inject IDashboardApiService DashboardApiService

<PageTitle>Dashboard - Baba Play</PageTitle>

<div class="container-fluid py-4" data-testid="dashboard-page">
    <div class="page-header">
        <div>
            <h1 class="page-header__title text-gradient">Painel de Controle</h1>
            <p class="page-header__subtitle">Visão geral do seu Baba e métricas da associação.</p>
        </div>
        <button class="btn btn-outline-primary btn-sm"
                @onclick="LoadDashboardDataAsync"
                disabled="@IsLoading"
                data-testid="btn-refresh-dashboard">
            @if (IsRefreshing)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                <span>Atualizando...</span>
            }
            else
            {
                <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>
                <span>Atualizar</span>
            }
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" data-testid="dashboard-error-banner">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
            @ErrorMessage
            <button type="button" class="btn-close" @onclick="() => ErrorMessage = null"></button>
        </div>
    }

    @if (IsInitialLoading)
    {
        <DashboardSkeleton />
    }
    else if (Summary != null)
    {
        <div class="dashboard-content @(IsRefreshing ? "dashboard-content--refreshing" : null)">
            <div class="row">
                <div class="col-lg-8 mb-4">
                    <NextMatchWidget NextMatch="Summary.NextMatch" OnRsvpStatusChanged="HandleRsvpChanged" />
                    <QuickStatsWidget Stats="Summary.Stats" />
                </div>
                <div class="col-lg-4 mb-4">
                    <RecentAnnouncementsWidget Announcements="Summary.Announcements" />
                </div>
            </div>
        </div>
    }
</div>

@code {
    private DashboardSummaryDto? Summary { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsInitialLoading => IsLoading && Summary is null;
    private bool IsRefreshing => IsLoading && Summary is not null;
    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardDataAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var result = await DashboardApiService.GetDashboardSummaryAsync();
            Summary = result.Summary;
            if (Summary == null)
            {
                ErrorMessage = result.ErrorMessage
                    ?? "Não foi possível carregar os dados do dashboard. Verifique sua conexão ou tente novamente mais tarde.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro de carregamento: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void HandleRsvpChanged(bool isAttending)
    {
        if (Summary?.NextMatch != null)
        {
            var updatedRsvp = isAttending ? "Confirmed" : "Declined";
            var countDelta = isAttending ? 1 : (Summary.NextMatch.UserRsvpStatus == "Confirmed" ? -1 : 0);

            var updatedNextMatch = Summary.NextMatch with
            {
                UserRsvpStatus = updatedRsvp,
                ConfirmedCount = Math.Max(0, Summary.NextMatch.ConfirmedCount + countDelta)
            };

            Summary = Summary with { NextMatch = updatedNextMatch };
        }
    }
}
