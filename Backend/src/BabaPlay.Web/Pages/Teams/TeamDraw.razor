@page "/teams"
@page "/matches/{gameDayId:guid}/draw"
@page "/teams/draw"
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@using BabaPlay.Web.Components.Teams
@inject ITeamApiService TeamApiService
@inject IMatchApiService MatchApiService

<PageTitle>Sorteio de Times & Coletes - Baba Play</PageTitle>

<div class="container-fluid py-4" data-testid="team-draw-page">
    <div class="page-header">
        <div>
            <h1 class="page-header__title text-gradient">Sorteio de Times & Coletes</h1>
            <p class="page-header__subtitle">Formação de equipes equilibradas por rating e posições com ajuste manual.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-success btn-sm font-weight-bold btn-draw-teams"
                    @onclick="GenerateTeamsAsync"
                    disabled="@IsLoading"
                    data-testid="btn-draw-teams">
                @if (IsLoading)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Sorteando...</span>
                }
                else
                {
                    <i class="bi bi-dice-5-fill me-1" aria-hidden="true"></i>
                    <span>Sortear Coletes</span>
                }
            </button>
            <button class="btn btn-outline-primary btn-sm btn-save-composition"
                    @onclick="SaveCompositionAsync"
                    disabled="@(IsLoading || DrawResult == null || DrawResult.Teams.Count == 0)"
                    data-testid="btn-save-composition">
                <i class="bi bi-check-lg me-1" aria-hidden="true"></i> Salvar Composição
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(AlertMessage))
    {
        <div class="alert @(IsAlertError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-4" role="alert" data-testid="alert-banner">
            <i class="bi @(IsAlertError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2" aria-hidden="true"></i>
            @AlertMessage
            <button type="button" class="btn-close" @onclick="() => AlertMessage = null"></button>
        </div>
    }

    <div class="widget-card filters-toolbar mb-4">
        <div class="row align-items-end g-3">
            <div class="col-md-4">
                <label class="form-label filters-toolbar__label" for="select-num-teams">Quantidade de Coletes/Times</label>
                <select id="select-num-teams" class="form-select" @bind="NumberOfTeams" data-testid="select-num-teams">
                    <option value="2">2 Times (Amarelo vs Azul)</option>
                    <option value="3">3 Times (Amarelo, Azul, Vermelho)</option>
                    <option value="4">4 Times (Amarelo, Azul, Vermelho, Verde)</option>
                </select>
            </div>
            <div class="col-md-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" @bind="BalanceByPosition" id="balancePosCheck" data-testid="checkbox-balance-pos" />
                    <label class="form-check-label fw-bold" for="balancePosCheck">
                        Equilibrar por Posição (Goleiros/Linha)
                    </label>
                </div>
            </div>
            <div class="col-md-4 text-md-end">
                <span class="badge badge-secondary p-2" data-testid="total-players-badge">
                    Total: @(DrawResult?.TotalPlayersCount ?? 0) Atletas no Baba
                </span>
            </div>
        </div>
    </div>

    @if (IsLoading && DrawResult == null)
    {
        <LoadingSpinner Message="Calculando balanceamento de equipes..." />
    }
    else if (DrawResult == null || DrawResult.Teams.Count == 0)
    {
        <EmptyState IsPageLevel="true"
                    IconClass="bi-dice-3"
                    Title="Nenhum sorteio realizado ainda"
                    Hint="Clique no botão acima para acionar o algoritmo de balanceamento de times."
                    TestId="empty-draw-state">
            <button class="btn btn-outline-primary" @onclick="GenerateTeamsAsync" disabled="@IsLoading">
                <i class="bi bi-dice-5-fill me-1" aria-hidden="true"></i> Executar Sorteio Agora
            </button>
        </EmptyState>
    }
    else
    {
        <div class="list-content @(IsLoading ? "list-content--refreshing" : null)">
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-@DrawResult.Teams.Count g-3" data-testid="teams-columns-grid">
                @for (int i = 0; i < DrawResult.Teams.Count; i++)
                {
                    var teamIndex = i;
                    var team = DrawResult.Teams[teamIndex];
                    <div class="col" key="@team.TeamId">
                        <TeamColumn Team="team"
                                    CanMoveLeft="teamIndex > 0"
                                    CanMoveRight="teamIndex < DrawResult.Teams.Count - 1"
                                    OnMovePlayer="args => MovePlayer(args.Player, teamIndex, args.Direction)" />
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid GameDayId { get; set; }

    private DrawResultDto? DrawResult { get; set; }
    private int NumberOfTeams { get; set; } = 2;
    private bool BalanceByPosition { get; set; } = true;
    private bool IsLoading { get; set; } = false;
    private string? AlertMessage { get; set; }
    private bool IsAlertError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (GameDayId == Guid.Empty)
        {
            var gameDays = await MatchApiService.GetGameDaysAsync();
            if (gameDays.Count > 0)
            {
                GameDayId = gameDays[0].Id;
            }
        }

        if (GameDayId != Guid.Empty)
        {
            await GenerateTeamsAsync();
        }
    }

    private async Task GenerateTeamsAsync()
    {
        IsLoading = true;
        AlertMessage = null;
        try
        {
            var dto = new GenerateBalancedTeamsDto(GameDayId, NumberOfTeams, BalanceByPosition);
            DrawResult = await TeamApiService.GenerateBalancedTeamsAsync(dto);
            if (DrawResult == null)
            {
                SetAlert("Não foi possível gerar os times. Verifique se há atletas cadastrados.", isError: true);
            }
        }
        catch (Exception ex)
        {
            SetAlert($"Erro ao sortear times: {ex.Message}", isError: true);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void MovePlayer(DrawnPlayerDto player, int currentTeamIdx, int direction)
    {
        if (DrawResult == null) return;
        var targetTeamIdx = currentTeamIdx + direction;
        if (targetTeamIdx < 0 || targetTeamIdx >= DrawResult.Teams.Count) return;

        var sourceTeam = DrawResult.Teams[currentTeamIdx];
        var targetTeam = DrawResult.Teams[targetTeamIdx];

        sourceTeam.Players.Remove(player);
        var updatedPlayer = player with { TeamId = targetTeam.TeamId };
        targetTeam.Players.Add(updatedPlayer);

        RecalculateTeamAverages();
    }

    private void RecalculateTeamAverages()
    {
        if (DrawResult == null) return;

        for (int i = 0; i < DrawResult.Teams.Count; i++)
        {
            var team = DrawResult.Teams[i];
            var avg = team.Players.Count > 0 ? Math.Round(team.Players.Average(p => p.RatingStars), 1) : 0.0;
            DrawResult.Teams[i] = team with { AverageRating = avg };
        }
    }

    private async Task SaveCompositionAsync()
    {
        if (DrawResult == null) return;

        var (success, error) = await TeamApiService.SaveTeamCompositionAsync(DrawResult);
        if (success)
        {
            SetAlert("Composição dos times salva com sucesso para a partida!");
        }
        else
        {
            SetAlert(error ?? "Erro ao salvar composição dos times.", isError: true);
        }
    }

    private void SetAlert(string message, bool isError = false)
    {
        AlertMessage = message;
        IsAlertError = isError;
    }
}
