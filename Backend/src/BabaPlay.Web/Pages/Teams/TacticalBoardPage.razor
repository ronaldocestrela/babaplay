@page "/matches/{gameDayId:guid}/tactical"
@page "/tactical"
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@using BabaPlay.Web.Components.Teams
@inject ITeamApiService TeamApiService
@inject IMatchApiService MatchApiService

<PageTitle>Prancheta Tática - Baba Play</PageTitle>

<div class="container-fluid py-4" data-testid="tactical-board-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 mb-1 font-weight-bold text-gradient">Prancheta Tática & Escalação Visual</h1>
            <p class="text-muted mb-0">Visualize a formação tática do time e ajuste o posicionamento dos atletas no campo.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm" @onclick="ResetFormation" data-testid="btn-reset-formation">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Resetar Posições
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(AlertMessage))
    {
        <div class="alert @(IsAlertError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-4" role="alert" data-testid="alert-banner">
            <i class="bi @(IsAlertError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>
            @AlertMessage
            <button type="button" class="btn-close" @onclick="() => AlertMessage = null"></button>
        </div>
    }

    <!-- Controles da Prancheta -->
    <div class="card card-custom p-3 mb-4 shadow-sm">
        <div class="row align-items-center g-3">
            <div class="col-md-4">
                <label class="form-label font-weight-bold mb-1">Time Escalado</label>
                <select class="form-select" @bind="SelectedTeamName" @bind:after="OnTeamChanged" data-testid="select-team">
                    <option value="Time Amarelo 🟡">Time Amarelo 🟡</option>
                    <option value="Time Azul 🔵">Time Azul 🔵</option>
                    <option value="Time Vermelho 🔴">Time Vermelho 🔴</option>
                    <option value="Time Verde 🟢">Time Verde 🟢</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label font-weight-bold mb-1">Esquema Tático</label>
                <select class="form-select" @bind="SelectedPresetId" @bind:after="ApplySelectedPreset" data-testid="select-preset">
                    <option value="futsal-2-2">Futsal 2-2 (Quadrado)</option>
                    <option value="futsal-3-1">Futsal 3-1 (Pivô Fixo)</option>
                    <option value="futsal-1-2-1">Futsal 1-2-1 (Losango)</option>
                    <option value="campo-4-4-2">Campo 4-4-2 (Clássico)</option>
                    <option value="campo-4-3-3">Campo 4-3-3 (Ofensivo)</option>
                </select>
            </div>
            <div class="col-md-4">
                <div class="alert alert-info py-2 px-3 mb-0 small" data-testid="swap-instruction">
                    <i class="bi bi-info-circle-fill me-1"></i> Clique em 2 jogadores para inverter suas posições no campo.
                </div>
            </div>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <LoadingSpinner Message="Carregando prancheta tática..." />
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7 mb-4">
                <TacticalBoard Formation="CurrentFormation" OnPinClick="HandlePinClick" />
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid GameDayId { get; set; }

    private TacticalFormationDto CurrentFormation { get; set; } = null!;
    private string SelectedTeamName { get; set; } = "Time Amarelo 🟡";
    private string SelectedPresetId { get; set; } = "futsal-2-2";
    private PlayerTacticalPositionDto? SelectedPlayerForSwap { get; set; }
    private bool IsLoading { get; set; } = false;
    private string? AlertMessage { get; set; }
    private bool IsAlertError { get; set; }

    protected override void OnInitialized()
    {
        LoadDefaultFormation();
    }

    private void LoadDefaultFormation()
    {
        var positions = new List<PlayerTacticalPositionDto>
        {
            new(Guid.NewGuid(), "Goleiro Bruno", "Goleiro", 1, 50, 90, "#f59e0b"),
            new(Guid.NewGuid(), "Fixo Zico", "Zagueiro", 4, 30, 68, "#f59e0b"),
            new(Guid.NewGuid(), "Fixo Pelé", "Zagueiro", 5, 70, 68, "#f59e0b"),
            new(Guid.NewGuid(), "Ala Romário", "Meia", 10, 30, 32, "#f59e0b"),
            new(Guid.NewGuid(), "Pivô Bebeto", "Atacante", 9, 70, 32, "#f59e0b")
        };

        CurrentFormation = new TacticalFormationDto("Futsal 2-2", "Futsal", positions);
    }

    private void OnTeamChanged()
    {
        var color = SelectedTeamName switch
        {
            "Time Azul 🔵" => "#3b82f6",
            "Time Vermelho 🔴" => "#ef4444",
            "Time Verde 🟢" => "#10b981",
            _ => "#f59e0b"
        };

        var updatedPositions = CurrentFormation.Positions
            .Select(p => p with { ColorHex = color })
            .ToList();

        CurrentFormation = CurrentFormation with { Positions = updatedPositions };
    }

    private void ApplySelectedPreset()
    {
        var color = CurrentFormation.Positions.FirstOrDefault()?.ColorHex ?? "#f59e0b";
        List<PlayerTacticalPositionDto> newPositions;

        switch (SelectedPresetId)
        {
            case "futsal-3-1":
                newPositions = new List<PlayerTacticalPositionDto>
                {
                    new(Guid.NewGuid(), "Goleiro 1", "Goleiro", 1, 50, 92, color),
                    new(Guid.NewGuid(), "Ala Esquerdo", "Meia", 2, 20, 65, color),
                    new(Guid.NewGuid(), "Fixo Central", "Zagueiro", 3, 50, 72, color),
                    new(Guid.NewGuid(), "Ala Direito", "Meia", 4, 80, 65, color),
                    new(Guid.NewGuid(), "Pivô", "Atacante", 9, 50, 25, color)
                };
                CurrentFormation = new TacticalFormationDto("Futsal 3-1", "Futsal", newPositions);
                break;

            case "futsal-1-2-1":
                newPositions = new List<PlayerTacticalPositionDto>
                {
                    new(Guid.NewGuid(), "Goleiro 1", "Goleiro", 1, 50, 92, color),
                    new(Guid.NewGuid(), "Fixo", "Zagueiro", 3, 50, 75, color),
                    new(Guid.NewGuid(), "Ala Esquerda", "Meia", 7, 25, 50, color),
                    new(Guid.NewGuid(), "Ala Direita", "Meia", 8, 75, 50, color),
                    new(Guid.NewGuid(), "Pivô", "Atacante", 9, 50, 25, color)
                };
                CurrentFormation = new TacticalFormationDto("Futsal 1-2-1 (Losango)", "Futsal", newPositions);
                break;

            case "campo-4-4-2":
                newPositions = new List<PlayerTacticalPositionDto>
                {
                    new(Guid.NewGuid(), "Goleiro 1", "Goleiro", 1, 50, 94, color),
                    new(Guid.NewGuid(), "Lat. Esquerdo", "Zagueiro", 2, 15, 78, color),
                    new(Guid.NewGuid(), "Zagueiro 1", "Zagueiro", 3, 38, 80, color),
                    new(Guid.NewGuid(), "Zagueiro 2", "Zagueiro", 4, 62, 80, color),
                    new(Guid.NewGuid(), "Lat. Direito", "Zagueiro", 5, 85, 78, color),
                    new(Guid.NewGuid(), "Volante 1", "Meia", 6, 35, 58, color),
                    new(Guid.NewGuid(), "Volante 2", "Meia", 8, 65, 58, color),
                    new(Guid.NewGuid(), "Meia Esquerdo", "Meia", 7, 20, 42, color),
                    new(Guid.NewGuid(), "Meia Direito", "Meia", 10, 80, 42, color),
                    new(Guid.NewGuid(), "Atacante 1", "Atacante", 9, 38, 22, color),
                    new(Guid.NewGuid(), "Atacante 2", "Atacante", 11, 62, 22, color)
                };
                CurrentFormation = new TacticalFormationDto("Campo 4-4-2", "Campo", newPositions);
                break;

            default:
                LoadDefaultFormation();
                OnTeamChanged();
                break;
        }
    }

    private void HandlePinClick(PlayerTacticalPositionDto player)
    {
        if (SelectedPlayerForSwap == null)
        {
            // Selecionar o primeiro jogador
            SelectedPlayerForSwap = player;
            UpdateSelectionState(player.PlayerId, isSelected: true);
            SetAlert($"Jogador '{player.Name}' selecionado. Clique em outro para inverter posições.");
        }
        else if (SelectedPlayerForSwap.PlayerId == player.PlayerId)
        {
            // Deselecionar
            UpdateSelectionState(player.PlayerId, isSelected: false);
            SelectedPlayerForSwap = null;
            AlertMessage = null;
        }
        else
        {
            // Inverter coordenadas X/Y entre os dois jogadores
            SwapPlayers(SelectedPlayerForSwap, player);
            SelectedPlayerForSwap = null;
            SetAlert("Posições táticas invertidas com sucesso!");
        }
    }

    private void SwapPlayers(PlayerTacticalPositionDto playerA, PlayerTacticalPositionDto playerB)
    {
        var positions = CurrentFormation.Positions.ToList();
        var indexA = positions.FindIndex(p => p.PlayerId == playerA.PlayerId);
        var indexB = positions.FindIndex(p => p.PlayerId == playerB.PlayerId);

        if (indexA != -1 && indexB != -1)
        {
            var updatedA = positions[indexA] with
            {
                XPercent = playerB.XPercent,
                YPercent = playerB.YPercent,
                IsSelected = false
            };

            var updatedB = positions[indexB] with
            {
                XPercent = playerA.XPercent,
                YPercent = playerA.YPercent,
                IsSelected = false
            };

            positions[indexA] = updatedA;
            positions[indexB] = updatedB;

            CurrentFormation = CurrentFormation with { Positions = positions };
        }
    }

    private void UpdateSelectionState(Guid playerId, bool isSelected)
    {
        var positions = CurrentFormation.Positions
            .Select(p => p.PlayerId == playerId ? p with { IsSelected = isSelected } : p with { IsSelected = false })
            .ToList();

        CurrentFormation = CurrentFormation with { Positions = positions };
    }

    private void ResetFormation()
    {
        SelectedPlayerForSwap = null;
        ApplySelectedPreset();
        SetAlert("Posições táticas resetadas.");
    }

    private void SetAlert(string message, bool isError = false)
    {
        AlertMessage = message;
        IsAlertError = isError;
    }
}
