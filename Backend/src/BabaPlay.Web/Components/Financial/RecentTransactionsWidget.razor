@namespace BabaPlay.Web.Components.Financial
@using BabaPlay.Web.Models
@using BabaPlay.Web.Components.Common

<div class="widget-card recent-transactions-widget" data-testid="recent-transactions-widget">
    <div class="widget-card__header">
        <h3 class="widget-card__title">
            <i class="bi bi-cash-stack" aria-hidden="true"></i>
            Movimentações Recentes do Caixa
        </h3>
        <span class="badge badge-primary">
            Últimas @(Transactions?.Count ?? 0)
        </span>
    </div>

    @if (Transactions == null || Transactions.Count == 0)
    {
        <EmptyState IconClass="bi-cash-stack"
                    Title="Nenhuma movimentação registrada no período."
                    TestId="empty-transactions" />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 financial-table">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Descrição</th>
                        <th class="d-none d-sm-table-cell">Tipo</th>
                        <th class="text-end">Valor</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Transactions)
                    {
                        var isIncome = item.Type == 1;
                        <tr>
                            <td class="text-muted">
                                @item.OccurredOnUtc.ToLocalTime().ToString("dd/MM/yyyy")
                            </td>
                            <td class="font-weight-medium">
                                @item.Description
                            </td>
                            <td class="d-none d-sm-table-cell">
                                @if (isIncome)
                                {
                                    <span class="badge badge-success">Entrada</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Saída</span>
                                }
                            </td>
                            <td class="text-end font-weight-bold @(isIncome ? "amount-income" : "amount-expense")">
                                @(isIncome ? "+" : "-")@item.Amount.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public List<RecentTransactionDto>? Transactions { get; set; }
}
