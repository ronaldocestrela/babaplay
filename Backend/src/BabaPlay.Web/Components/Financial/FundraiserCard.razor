@namespace BabaPlay.Web.Components.Financial
@using BabaPlay.Web.Models

@if (Fundraiser != null)
{
    var isCompleted = Fundraiser.Status == 1 || Fundraiser.CollectedAmount >= Fundraiser.TargetAmount;
    var isActive = Fundraiser.Status == 0 && !isCompleted;

    <div class="widget-card fundraiser-card h-100 mb-0" data-testid="fundraiser-card">
        <div class="d-flex flex-column h-100">
            <div class="flex-grow-1">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <h3 class="widget-card__title mb-0" data-testid="fundraiser-title">
                        <i class="bi bi-bullseye" aria-hidden="true"></i>
                        @Fundraiser.Title
                    </h3>
                    @if (isCompleted)
                    {
                        <span class="badge badge-success flex-shrink-0" data-testid="status-badge-completed">Meta Atingida</span>
                    }
                    else if (isActive)
                    {
                        <span class="badge badge-primary flex-shrink-0" data-testid="status-badge-active">Em Andamento</span>
                    }
                    else
                    {
                        <span class="badge badge-secondary flex-shrink-0" data-testid="status-badge-cancelled">Encerrada</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Fundraiser.Description))
                {
                    <p class="text-muted small mb-3" data-testid="fundraiser-desc">
                        @Fundraiser.Description
                    </p>
                }

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1 small">
                        <span class="font-weight-bold">Progresso de Arrecadação</span>
                        <span class="font-weight-bold text-primary-light" data-testid="progress-percentage">@Fundraiser.ProgressPercentage%</span>
                    </div>
                    <div class="progress financial-collection-progress" data-testid="progress-bar-container">
                        <div class="progress-bar progress-bar-striped progress-bar-animated @(isCompleted ? "financial-collection-progress__bar--success" : "financial-collection-progress__bar--primary")"
                             role="progressbar"
                             style="width: @(Math.Min(100, Fundraiser.ProgressPercentage))%"
                             aria-valuenow="@Fundraiser.ProgressPercentage"
                             aria-valuemin="0"
                             aria-valuemax="100"
                             data-testid="progress-bar-fill">
                        </div>
                    </div>
                </div>

                <div class="fundraiser-card__metrics mb-3">
                    <div>
                        <span class="text-muted small d-block">Arrecadado</span>
                        <strong class="amount-income" data-testid="collected-amount">
                            @FormatCurrency(Fundraiser.CollectedAmount)
                        </strong>
                    </div>
                    <div class="text-end">
                        <span class="text-muted small d-block">Meta</span>
                        <strong data-testid="target-amount">
                            @FormatCurrency(Fundraiser.TargetAmount)
                        </strong>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                <span class="text-muted small" data-testid="contributions-count">
                    <i class="bi bi-people me-1" aria-hidden="true"></i>
                    @Fundraiser.ContributionsCount @(Fundraiser.ContributionsCount == 1 ? "contribuição" : "contribuições")
                </span>

                @if (isActive)
                {
                    <button class="btn btn-success btn-sm font-weight-bold" @onclick="ContributeAsync" data-testid="btn-contribute">
                        <i class="bi bi-cash-coin me-1" aria-hidden="true"></i> Contribuir
                    </button>
                }
                else
                {
                    <button class="btn btn-outline-secondary btn-sm" disabled>
                        <i class="bi bi-check-lg me-1" aria-hidden="true"></i> Concluída
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public FundraiserDto Fundraiser { get; set; } = default!;
    [Parameter] public EventCallback<FundraiserDto> OnContribute { get; set; }

    private async Task ContributeAsync()
    {
        if (OnContribute.HasDelegate)
        {
            await OnContribute.InvokeAsync(Fundraiser);
        }
    }

    private static string FormatCurrency(decimal val) => val.ToString("C2", new System.Globalization.CultureInfo("pt-BR"));
}
