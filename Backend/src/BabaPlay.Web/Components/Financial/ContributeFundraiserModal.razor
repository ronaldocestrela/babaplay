@namespace BabaPlay.Web.Components.Financial
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@inject IFinancialApiService FinancialApiService

@if (IsOpen && Fundraiser != null)
{
    <div class="modal-backdrop fade show app-modal-backdrop" data-testid="contribute-fundraiser-backdrop"></div>
    <div class="modal fade show d-block app-modal" tabindex="-1" data-testid="contribute-fundraiser-modal">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold">
                        <i class="bi bi-cash-coin me-2" aria-hidden="true"></i>
                        Contribuir na Vaquinha: @Fundraiser.Title
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseAsync" aria-label="Fechar"></button>
                </div>

                <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync">
                    <DataAnnotationsValidator />

                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger p-2 small mb-3" role="alert" data-testid="modal-error-alert">
                                <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>
                                @ErrorMessage
                            </div>
                        }

                        <div class="alert alert-info py-2 mb-3 small">
                            <i class="bi bi-bullseye me-1" aria-hidden="true"></i>
                            <strong>Meta:</strong> @FormatCurrency(Fundraiser.TargetAmount)
                            <span class="mx-1">|</span>
                            <i class="bi bi-check-circle me-1" aria-hidden="true"></i>
                            <strong>Já Arrecadado:</strong> @FormatCurrency(Fundraiser.CollectedAmount)
                        </div>

                        <div class="mb-3">
                            <label class="form-label filters-toolbar__label" for="input-contribution-amount">Valor da Contribuição (R$) *</label>
                            <InputNumber id="input-contribution-amount" class="form-control" @bind-Value="Model.Amount" data-testid="input-contribution-amount" />
                            <ValidationMessage For="() => Model.Amount" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label filters-toolbar__label" for="input-contributor-name">Nome do Contribuidor / Identificação</label>
                            <InputText id="input-contributor-name" class="form-control" placeholder="Ex: Carlos Silva, Anônimo" @bind-Value="Model.ContributorName" data-testid="input-contributor-name" />
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseAsync">Cancelar</button>
                        <button type="submit" class="btn btn-success font-weight-bold" disabled="@IsSubmitting" data-testid="btn-submit-contribution">
                            @if (IsSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Processando...</span>
                            }
                            else
                            {
                                <i class="bi bi-cash-coin me-1" aria-hidden="true"></i>
                                <span>Confirmar Contribuição</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public FundraiserDto? Fundraiser { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<FundraiserDto> OnContributionMade { get; set; }

    private ContributeFundraiserDto Model { get; set; } = new();
    private bool IsSubmitting { get; set; }
    private string? ErrorMessage { get; set; }

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            Model = new ContributeFundraiserDto();
            ErrorMessage = null;
        }
    }

    private async Task HandleSubmitAsync()
    {
        if (Fundraiser == null) return;

        IsSubmitting = true;
        ErrorMessage = null;

        try
        {
            var result = await FinancialApiService.ContributeToFundraiserAsync(Fundraiser.Id, Model);
            if (result != null)
            {
                if (OnContributionMade.HasDelegate)
                {
                    await OnContributionMade.InvokeAsync(result);
                }
                await CloseAsync();
            }
            else
            {
                ErrorMessage = "Não foi possível registrar a contribuição. Tente novamente.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao registrar contribuição: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task CloseAsync()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private static string FormatCurrency(decimal val) => val.ToString("C2", new System.Globalization.CultureInfo("pt-BR"));
}
