@namespace BabaPlay.Web.Components.Financial
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@inject IFinancialApiService FinancialApiService

@if (IsOpen && Fundraiser != null)
{
    <div class="modal-backdrop fade show" style="display: block; background: rgba(0,0,0,0.5);" data-testid="contribute-fundraiser-backdrop"></div>
    <div class="modal fade show" tabindex="-1" style="display: block;" data-testid="contribute-fundraiser-modal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 12px; border: none; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
                <div class="modal-header" style="border-bottom: 1px solid var(--border-color, #e2e8f0);">
                    <h5 class="modal-title font-weight-bold" style="color: var(--text-main);">
                        💰 Contribuir na Vaquinha: @Fundraiser.Title
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseAsync" aria-label="Close"></button>
                </div>

                <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync">
                    <DataAnnotationsValidator />

                    <div class="modal-body p-4">
                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger mb-3" data-testid="modal-error-alert">
                                @ErrorMessage
                            </div>
                        }

                        <div class="alert alert-info py-2 mb-3" style="font-size: 0.8rem;">
                            🎯 <strong>Meta:</strong> @FormatCurrency(Fundraiser.TargetAmount) |
                            🟢 <strong>Já Arrecadado:</strong> @FormatCurrency(Fundraiser.CollectedAmount)
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-weight-bold" style="font-size: 0.85rem;">Valor da Contribuição (R$) *</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="Model.Amount" data-testid="input-contribution-amount" />
                            <ValidationMessage For="() => Model.Amount" class="text-danger" style="font-size: 0.75rem;" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-weight-bold" style="font-size: 0.85rem;">Nome do Contribuidor / Identificação</label>
                            <InputText class="form-control form-control-sm" placeholder="Ex: Carlos Silva, Anônimo" @bind-Value="Model.ContributorName" data-testid="input-contributor-name" />
                        </div>
                    </div>

                    <div class="modal-footer" style="border-top: 1px solid var(--border-color, #e2e8f0);">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseAsync">Cancelar</button>
                        <button type="submit" class="btn btn-success btn-sm font-weight-bold" disabled="@IsSubmitting" data-testid="btn-submit-contribution">
                            @if (IsSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Processando...</span>
                            }
                            else
                            {
                                <span>💰 Confirmar Contribuição</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public FundraiserDto? Fundraiser { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<FundraiserDto> OnContributionMade { get; set; }

    private ContributeFundraiserDto Model { get; set; } = new();
    private bool IsSubmitting { get; set; }
    private string? ErrorMessage { get; set; }

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            Model = new ContributeFundraiserDto();
            ErrorMessage = null;
        }
    }

    private async Task HandleSubmitAsync()
    {
        if (Fundraiser == null) return;

        IsSubmitting = true;
        ErrorMessage = null;

        try
        {
            var result = await FinancialApiService.ContributeToFundraiserAsync(Fundraiser.Id, Model);
            if (result != null)
            {
                if (OnContributionMade.HasDelegate)
                {
                    await OnContributionMade.InvokeAsync(result);
                }
                await CloseAsync();
            }
            else
            {
                ErrorMessage = "Não foi possível registrar a contribuição. Tente novamente.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao registrar contribuição: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task CloseAsync()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private static string FormatCurrency(decimal val) => val.ToString("C2", new System.Globalization.CultureInfo("pt-BR"));
}
