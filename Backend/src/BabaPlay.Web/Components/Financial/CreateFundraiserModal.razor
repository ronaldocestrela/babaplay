@namespace BabaPlay.Web.Components.Financial
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@inject IFinancialApiService FinancialApiService

@if (IsOpen)
{
    <div class="modal-backdrop fade show app-modal-backdrop" data-testid="create-fundraiser-backdrop"></div>
    <div class="modal fade show d-block app-modal" tabindex="-1" data-testid="create-fundraiser-modal">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold">
                        <i class="bi bi-bullseye me-2" aria-hidden="true"></i>
                        Criar Nova Vaquinha do Time
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseAsync" aria-label="Fechar"></button>
                </div>

                <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync">
                    <DataAnnotationsValidator />

                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger p-2 small mb-3" role="alert" data-testid="modal-error-alert">
                                <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>
                                @ErrorMessage
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label filters-toolbar__label" for="input-fundraiser-title">Título da Arrecadação *</label>
                            <InputText id="input-fundraiser-title" class="form-control" placeholder="Ex: Churrasco de Fim de Ano, Compra de Coletes" @bind-Value="Model.Title" data-testid="input-fundraiser-title" />
                            <ValidationMessage For="() => Model.Title" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label filters-toolbar__label" for="input-fundraiser-desc">Descrição / Objetivo</label>
                            <InputTextArea id="input-fundraiser-desc" class="form-control" rows="3" placeholder="Descreva os detalhes do evento ou meta..." @bind-Value="Model.Description" data-testid="input-fundraiser-desc" />
                        </div>

                        <div class="row g-3 mb-1">
                            <div class="col-12 col-md-6">
                                <label class="form-label filters-toolbar__label" for="input-fundraiser-target">Meta de Arrecadação (R$) *</label>
                                <InputNumber id="input-fundraiser-target" class="form-control" @bind-Value="Model.TargetAmount" data-testid="input-fundraiser-target" />
                                <ValidationMessage For="() => Model.TargetAmount" class="text-danger small" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label filters-toolbar__label" for="input-fundraiser-deadline">Data Limite (Opcional)</label>
                                <InputDate id="input-fundraiser-deadline" class="form-control" @bind-Value="Model.DeadlineUtc" data-testid="input-fundraiser-deadline" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseAsync">Cancelar</button>
                        <button type="submit" class="btn btn-success font-weight-bold" disabled="@IsSubmitting" data-testid="btn-submit-fundraiser">
                            @if (IsSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Criando...</span>
                            }
                            else
                            {
                                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                                <span>Criar Arrecadação</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<FundraiserDto> OnFundraiserCreated { get; set; }

    private CreateFundraiserDto Model { get; set; } = new();
    private bool IsSubmitting { get; set; }
    private string? ErrorMessage { get; set; }

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            Model = new CreateFundraiserDto();
            ErrorMessage = null;
        }
    }

    private async Task HandleSubmitAsync()
    {
        IsSubmitting = true;
        ErrorMessage = null;

        try
        {
            var result = await FinancialApiService.CreateFundraiserAsync(Model);
            if (result != null)
            {
                if (OnFundraiserCreated.HasDelegate)
                {
                    await OnFundraiserCreated.InvokeAsync(result);
                }
                await CloseAsync();
            }
            else
            {
                ErrorMessage = "Não foi possível criar a arrecadação. Verifique os dados.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao criar vaquinha: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task CloseAsync()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
}
