@namespace BabaPlay.Web.Components.Financial
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@inject IFinancialApiService FinancialApiService

@if (IsOpen)
{
    <div class="modal-backdrop fade show" style="display: block; background: rgba(0,0,0,0.5);" data-testid="create-fundraiser-backdrop"></div>
    <div class="modal fade show" tabindex="-1" style="display: block;" data-testid="create-fundraiser-modal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 12px; border: none; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
                <div class="modal-header" style="border-bottom: 1px solid var(--border-color, #e2e8f0);">
                    <h5 class="modal-title font-weight-bold" style="color: var(--text-main);">
                        🎯 Criar Nova Vaquinha do Time
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseAsync" aria-label="Close"></button>
                </div>

                <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync">
                    <DataAnnotationsValidator />

                    <div class="modal-body p-4">
                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger mb-3" data-testid="modal-error-alert">
                                @ErrorMessage
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label font-weight-bold" style="font-size: 0.85rem;">Título da Arrecadação *</label>
                            <InputText class="form-control form-control-sm" placeholder="Ex: Churrasco de Fim de Ano, Compra de Coletes" @bind-Value="Model.Title" data-testid="input-fundraiser-title" />
                            <ValidationMessage For="() => Model.Title" class="text-danger" style="font-size: 0.75rem;" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-weight-bold" style="font-size: 0.85rem;">Descrição / Objetivo</label>
                            <InputTextArea class="form-control form-control-sm" rows="3" placeholder="Descreva os detalhes do evento ou meta..." @bind-Value="Model.Description" data-testid="input-fundraiser-desc" />
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label font-weight-bold" style="font-size: 0.85rem;">Meta de Arrecadação (R$) *</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="Model.TargetAmount" data-testid="input-fundraiser-target" />
                                <ValidationMessage For="() => Model.TargetAmount" class="text-danger" style="font-size: 0.75rem;" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label font-weight-bold" style="font-size: 0.85rem;">Data Limite (Opcional)</label>
                                <InputDate class="form-control form-control-sm" @bind-Value="Model.DeadlineUtc" data-testid="input-fundraiser-deadline" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer" style="border-top: 1px solid var(--border-color, #e2e8f0);">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseAsync">Cancelar</button>
                        <button type="submit" class="btn btn-success btn-sm font-weight-bold" disabled="@IsSubmitting" data-testid="btn-submit-fundraiser">
                            @if (IsSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Criando...</span>
                            }
                            else
                            {
                                <span>🚀 Criar Arrecadação</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<FundraiserDto> OnFundraiserCreated { get; set; }

    private CreateFundraiserDto Model { get; set; } = new();
    private bool IsSubmitting { get; set; }
    private string? ErrorMessage { get; set; }

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            Model = new CreateFundraiserDto();
            ErrorMessage = null;
        }
    }

    private async Task HandleSubmitAsync()
    {
        IsSubmitting = true;
        ErrorMessage = null;

        try
        {
            var result = await FinancialApiService.CreateFundraiserAsync(Model);
            if (result != null)
            {
                if (OnFundraiserCreated.HasDelegate)
                {
                    await OnFundraiserCreated.InvokeAsync(result);
                }
                await CloseAsync();
            }
            else
            {
                ErrorMessage = "Não foi possível criar a arrecadação. Verifique os dados.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao criar vaquinha: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task CloseAsync()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
}
