@namespace BabaPlay.Web.Components.Financial
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@inject IFinancialApiService FinancialApiService
@inject IJSRuntime JSRuntime

@if (IsOpen && Invoice != null)
{
    <div class="modal-backdrop fade show app-modal-backdrop" data-testid="pix-modal-backdrop"></div>
    <div class="modal fade show d-block app-modal" tabindex="-1" data-testid="pix-payment-modal">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold">
                        <i class="bi bi-qr-code me-2" aria-hidden="true"></i>
                        Pagamento via Pix - Baba Play
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseAsync" aria-label="Fechar"></button>
                </div>

                <div class="modal-body text-center">
                    @if (IsLoading)
                    {
                        <div class="py-4" data-testid="pix-loading">
                            <LoadingSpinner Message="Gerando chave Pix para pagamento..." />
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="alert alert-danger text-start" data-testid="pix-error-alert">
                            <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>
                            @ErrorMessage
                        </div>
                    }
                    else if (IsPaid)
                    {
                        <div class="py-3" data-testid="pix-success-alert">
                            <div class="pix-success-icon" aria-hidden="true">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <h4 class="font-weight-bold">Pagamento Confirmado!</h4>
                            <p class="text-muted mb-3">A sua fatura foi baixada com sucesso no sistema.</p>
                            <button type="button" class="btn btn-success font-weight-bold" @onclick="CloseAsync">Concluir</button>
                        </div>
                    }
                    else if (PixDetails != null)
                    {
                        <div class="mb-3">
                            <span class="text-muted small">Valor a pagar</span>
                            <div class="pix-amount amount-income" data-testid="pix-amount">
                                @Invoice.OpenAmount.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))
                            </div>
                            <div class="text-muted small">
                                Competência: @Invoice.Month.ToString("D2")/@Invoice.Year | Vencimento: @Invoice.DueDateUtc.ToLocalTime().ToString("dd/MM/yyyy")
                            </div>
                        </div>

                        <div class="pix-qr-box mb-3" data-testid="qr-code-box">
                            <div class="pix-qr-placeholder">
                                <i class="bi bi-phone" aria-hidden="true"></i>
                                <span>Escaneie o QR Code</span>
                                <small>Pix Instantâneo</small>
                            </div>
                        </div>

                        <div class="mb-3 text-start">
                            <label class="form-label filters-toolbar__label" for="input-pix-copia-cola">Código Pix Copia e Cola</label>
                            <div class="input-group">
                                <input id="input-pix-copia-cola" type="text" class="form-control form-control-sm font-monospace" value="@PixDetails.QrCodeCopyAndPaste" readonly data-testid="input-pix-copia-cola" />
                                <button type="button" class="btn btn-primary btn-sm font-weight-bold" @onclick="CopyPixCodeAsync" data-testid="btn-copy-pix">
                                    @if (IsCopied)
                                    {
                                        <i class="bi bi-check-lg me-1" aria-hidden="true"></i>
                                        <span>Copiado!</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-clipboard me-1" aria-hidden="true"></i>
                                        <span>Copiar</span>
                                    }
                                </button>
                            </div>
                            @if (IsCopied)
                            {
                                <div class="text-success mt-1 small font-weight-bold" data-testid="copied-feedback">
                                    Código Pix copiado para a área de transferência!
                                </div>
                            }
                        </div>

                        <div class="alert alert-info py-2 small text-start mb-0" data-testid="pix-expiry-info">
                            <i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>
                            Chave Pix válida por 30 minutos (Expira às @PixDetails.ExpiresAtUtc.ToLocalTime().ToString("HH:mm")).
                        </div>
                    }
                </div>

                @if (!IsPaid && PixDetails != null)
                {
                    <div class="modal-footer justify-content-between">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseAsync">Fechar</button>
                        <button type="button" class="btn btn-success font-weight-bold" @onclick="ConfirmPaymentAsync" disabled="@IsConfirming" data-testid="btn-confirm-pix-payment">
                            @if (IsConfirming)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Verificando...</span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>
                                <span>Já Paguei / Confirmar Pix</span>
                            }
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public InvoiceDto? Invoice { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnPaymentConfirmed { get; set; }

    private PixPaymentDetailsDto? PixDetails { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsCopied { get; set; }
    private bool IsConfirming { get; set; }
    private bool IsPaid { get; set; }
    private string? ErrorMessage { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && Invoice != null && PixDetails == null && !IsPaid)
        {
            await LoadPixDetailsAsync();
        }
        else if (!IsOpen)
        {
            PixDetails = null;
            IsPaid = false;
            IsCopied = false;
            ErrorMessage = null;
        }
    }

    private async Task LoadPixDetailsAsync()
    {
        if (Invoice == null) return;

        IsLoading = true;
        ErrorMessage = null;

        try
        {
            PixDetails = await FinancialApiService.GetPixPaymentAsync(Invoice.Id);
            if (PixDetails == null)
            {
                ErrorMessage = "Não foi possível gerar a cobrança Pix para esta fatura.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao gerar Pix: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task CopyPixCodeAsync()
    {
        if (PixDetails == null) return;

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", PixDetails.QrCodeCopyAndPaste);
            IsCopied = true;
        }
        catch
        {
            IsCopied = true;
        }
    }

    private async Task ConfirmPaymentAsync()
    {
        if (Invoice == null || PixDetails == null) return;

        IsConfirming = true;
        ErrorMessage = null;

        try
        {
            var success = await FinancialApiService.ConfirmPixPaymentAsync(Invoice.Id, PixDetails.TxId);
            if (success)
            {
                IsPaid = true;
                if (OnPaymentConfirmed.HasDelegate)
                {
                    await OnPaymentConfirmed.InvokeAsync();
                }
            }
            else
            {
                ErrorMessage = "Não foi possível confirmar o pagamento. Tente novamente.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao confirmar pagamento: {ex.Message}";
        }
        finally
        {
            IsConfirming = false;
        }
    }

    private async Task CloseAsync()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
}
