@namespace BabaPlay.Web.Components.Financial
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@inject IFinancialApiService FinancialApiService
@inject IJSRuntime JSRuntime

@if (IsOpen && Invoice != null)
{
    <div class="modal-backdrop fade show" style="display: block; background: rgba(0,0,0,0.5);" data-testid="pix-modal-backdrop"></div>
    <div class="modal fade show" tabindex="-1" style="display: block;" data-testid="pix-payment-modal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 12px; border: none; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
                <div class="modal-header" style="border-bottom: 1px solid var(--border-color, #e2e8f0);">
                    <h5 class="modal-title font-weight-bold" style="color: var(--text-main);">
                        💳 Pagamento via Pix - Baba Play
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseAsync" aria-label="Close"></button>
                </div>

                <div class="modal-body text-center p-4">
                    @if (IsLoading)
                    {
                        <div class="py-4" data-testid="pix-loading">
                            <LoadingSpinner Message="Gerando chave Pix para pagamento..." />
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="alert alert-danger" data-testid="pix-error-alert">
                            @ErrorMessage
                        </div>
                    }
                    else if (IsPaid)
                    {
                        <div class="py-3" data-testid="pix-success-alert">
                            <div style="font-size: 3.5rem; color: #10b981; margin-bottom: 0.5rem;">✅</div>
                            <h4 class="font-weight-bold" style="color: var(--text-main);">Pagamento Confirmado!</h4>
                            <p class="text-muted">A sua fatura foi baixada com sucesso no sistema.</p>
                            <button class="btn btn-success font-weight-bold mt-2" @onclick="CloseAsync">Concluir</button>
                        </div>
                    }
                    else if (PixDetails != null)
                    {
                        <div class="mb-3">
                            <span class="text-muted" style="font-size: 0.875rem;">Valor a pagar</span>
                            <div class="font-weight-bold" style="font-size: 2rem; color: #10b981;" data-testid="pix-amount">
                                @Invoice.OpenAmount.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))
                            </div>
                            <div style="font-size: 0.75rem; color: var(--text-muted);">
                                Competência: @Invoice.Month.ToString("D2")/@Invoice.Year | Vencimento: @Invoice.DueDateUtc.ToLocalTime().ToString("dd/MM/yyyy")
                            </div>
                        </div>

                        <!-- Synthetic QR Code Graphic Box -->
                        <div class="card p-3 mb-3 d-inline-block" style="background: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 8px;" data-testid="qr-code-box">
                            <div style="width: 160px; height: 160px; margin: 0 auto; background: #0f172a; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #ffffff; flex-direction: column; font-size: 0.75rem;">
                                <div style="font-size: 2.5rem; margin-bottom: 0.25rem;">📱</div>
                                <span>Escaneie o QR Code</span>
                                <span style="font-size: 0.65rem; color: #94a3b8;">(Pix Instantâneo)</span>
                            </div>
                        </div>

                        <div class="mb-3 text-start">
                            <label class="form-label font-weight-bold mb-1" style="font-size: 0.8rem;">Código Pix Copia e Cola:</label>
                            <div class="input-group">
                                <input type="text" class="form-control form-control-sm font-monospace" value="@PixDetails.QrCodeCopyAndPaste" readonly data-testid="input-pix-copia-cola" />
                                <button class="btn btn-primary btn-sm font-weight-bold" @onclick="CopyPixCodeAsync" data-testid="btn-copy-pix">
                                    @(IsCopied ? "✓ Copiado!" : "📋 Copiar")
                                </button>
                            </div>
                            @if (IsCopied)
                            {
                                <div class="text-success mt-1" style="font-size: 0.75rem; font-weight: 600;" data-testid="copied-feedback">
                                    ✓ Código Pix copiado para a área de transferência!
                                </div>
                            }
                        </div>

                        <div class="alert alert-info py-2" style="font-size: 0.75rem;" data-testid="pix-expiry-info">
                            ⏳ Chave Pix válida por 30 minutos (Expira às @PixDetails.ExpiresAtUtc.ToLocalTime().ToString("HH:mm")).
                        </div>
                    }
                </div>

                @if (!IsPaid && PixDetails != null)
                {
                    <div class="modal-footer" style="border-top: 1px solid var(--border-color, #e2e8f0); justify-content: space-between;">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseAsync">Fechar</button>
                        <button type="button" class="btn btn-success btn-sm font-weight-bold" @onclick="ConfirmPaymentAsync" disabled="@IsConfirming" data-testid="btn-confirm-pix-payment">
                            @if (IsConfirming)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Verificando...</span>
                            }
                            else
                            {
                                <span>✓ Já Paguei / Confirmar Pix</span>
                            }
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public InvoiceDto? Invoice { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnPaymentConfirmed { get; set; }

    private PixPaymentDetailsDto? PixDetails { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsCopied { get; set; }
    private bool IsConfirming { get; set; }
    private bool IsPaid { get; set; }
    private string? ErrorMessage { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && Invoice != null && PixDetails == null && !IsPaid)
        {
            await LoadPixDetailsAsync();
        }
        else if (!IsOpen)
        {
            PixDetails = null;
            IsPaid = false;
            IsCopied = false;
            ErrorMessage = null;
        }
    }

    private async Task LoadPixDetailsAsync()
    {
        if (Invoice == null) return;

        IsLoading = true;
        ErrorMessage = null;

        try
        {
            PixDetails = await FinancialApiService.GetPixPaymentAsync(Invoice.Id);
            if (PixDetails == null)
            {
                ErrorMessage = "Não foi possível gerar a cobrança Pix para esta fatura.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao gerar Pix: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task CopyPixCodeAsync()
    {
        if (PixDetails == null) return;

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", PixDetails.QrCodeCopyAndPaste);
            IsCopied = true;
        }
        catch
        {
            IsCopied = true; // Fallback simulation for tests or browsers without clipboard permission
        }
    }

    private async Task ConfirmPaymentAsync()
    {
        if (Invoice == null || PixDetails == null) return;

        IsConfirming = true;
        ErrorMessage = null;

        try
        {
            var success = await FinancialApiService.ConfirmPixPaymentAsync(Invoice.Id, PixDetails.TxId);
            if (success)
            {
                IsPaid = true;
                if (OnPaymentConfirmed.HasDelegate)
                {
                    await OnPaymentConfirmed.InvokeAsync();
                }
            }
            else
            {
                ErrorMessage = "Não foi possível confirmar o pagamento. Tente novamente.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao confirmar pagamento: {ex.Message}";
        }
        finally
        {
            IsConfirming = false;
        }
    }

    private async Task CloseAsync()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
}
