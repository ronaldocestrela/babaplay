@namespace BabaPlay.Web.Components.Financial
@using BabaPlay.Web.Models

@if (Member != null)
{
    <tr data-testid="defaulter-row">
        <td class="font-weight-bold" data-testid="defaulter-name">
            @Member.PlayerName
        </td>

        <td class="d-none d-md-table-cell text-center">
            <span class="badge badge-secondary" data-testid="overdue-count-badge">
                @Member.OverdueInvoicesCount @(Member.OverdueInvoicesCount == 1 ? "fatura" : "faturas")
            </span>
            <div class="text-muted small mt-1">
                @string.Join(", ", Member.OverdueCompetences)
            </div>
        </td>

        <td class="text-end font-weight-bold amount-expense" data-testid="defaulter-amount">
            @Member.TotalOverdueAmount.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))
        </td>

        <td class="d-none d-lg-table-cell text-center">
            @if (Member.MaxDaysOverdue <= 30)
            {
                <span class="badge badge-warning" data-testid="risk-badge-leve">
                    Leve (@Member.MaxDaysOverdue d)
                </span>
            }
            else if (Member.MaxDaysOverdue <= 60)
            {
                <span class="badge badge-warning font-weight-bold" data-testid="risk-badge-medio">
                    Médio (@Member.MaxDaysOverdue d)
                </span>
            }
            else
            {
                <span class="badge badge-danger" data-testid="risk-badge-critico">
                    Crítico (@Member.MaxDaysOverdue d)
                </span>
            }
        </td>

        <td class="text-center">
            <button class="btn btn-outline-primary btn-sm font-weight-bold"
                    @onclick="SendReminderAsync"
                    disabled="@IsSending"
                    data-testid="btn-send-reminder">
                @if (IsSending)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Enviando...</span>
                }
                else
                {
                    <i class="bi bi-bell me-1" aria-hidden="true"></i>
                    <span>Enviar Lembrete</span>
                }
            </button>
        </td>
    </tr>
}

@code {
    [Parameter] public DefaulterMemberDto Member { get; set; } = default!;
    [Parameter] public EventCallback<Guid> OnSendReminder { get; set; }

    private bool IsSending { get; set; }

    private async Task SendReminderAsync()
    {
        if (Member == null) return;

        IsSending = true;
        try
        {
            if (OnSendReminder.HasDelegate)
            {
                await OnSendReminder.InvokeAsync(Member.PlayerId);
            }
        }
        finally
        {
            IsSending = false;
        }
    }
}
