@namespace BabaPlay.Web.Components.Financial

<div class="stat-card financial-kpi-card" data-testid="financial-kpi-card">
    <div class="stat-card__header">
        <span class="stat-card__label">@Title</span>
        @if (!string.IsNullOrEmpty(Icon))
        {
            <span class="stat-card__icon" aria-hidden="true">
                <i class="bi @Icon"></i>
            </span>
        }
    </div>

    <div class="stat-card__value financial-kpi-card__value financial-kpi-card__value--@ValueTone">
        @FormatCurrency(Amount)
    </div>

    <div class="financial-kpi-card__footer">
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <span class="stat-card__subtitle">@Subtitle</span>
        }
        @if (!string.IsNullOrEmpty(BadgeText))
        {
            <span class="badge @BadgeColorClass">@BadgeText</span>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public decimal Amount { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>Bootstrap Icons class without the "bi " prefix (e.g. "bi-wallet2").</summary>
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? BadgeText { get; set; }
    [Parameter] public string BadgeColorClass { get; set; } = "badge-info";
    [Parameter] public string? ValueColor { get; set; }

    private string ValueTone => ValueColor switch
    {
        "success" => "success",
        "danger" => "danger",
        "warning" => "warning",
        _ => "default"
    };

    private static string FormatCurrency(decimal value) => value.ToString("C2", new System.Globalization.CultureInfo("pt-BR"));
}
