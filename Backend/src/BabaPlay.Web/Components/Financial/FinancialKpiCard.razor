@namespace BabaPlay.Web.Components.Financial

<div class="stat-card financial-kpi-card" data-testid="financial-kpi-card">
    <div style="display: flex; align-items: center; justify-content: space-between;">
        <span style="font-size: 0.875rem; color: var(--text-muted); font-weight: 600;">@Title</span>
        @if (!string.IsNullOrEmpty(Icon))
        {
            <span class="kpi-icon" style="font-size: 1.25rem;">@Icon</span>
        }
    </div>

    <div class="kpi-value" style="font-size: 1.75rem; font-weight: 800; margin-top: 0.5rem; color: @GetColorStyle();">
        @FormatCurrency(Amount)
    </div>

    <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 0.5rem;">
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <span class="kpi-subtitle" style="font-size: 0.75rem; color: var(--text-muted);">@Subtitle</span>
        }
        @if (!string.IsNullOrEmpty(BadgeText))
        {
            <span class="badge @BadgeColorClass" style="font-size: 0.75rem; font-weight: 600; padding: 0.2rem 0.5rem; border-radius: 4px;">
                @BadgeText
            </span>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public decimal Amount { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? BadgeText { get; set; }
    [Parameter] public string BadgeColorClass { get; set; } = "badge-info";
    [Parameter] public string? ValueColor { get; set; }

    private string GetColorStyle() => ValueColor switch
    {
        "success" => "var(--success-color, #10b981)",
        "danger" => "var(--danger-color, #ef4444)",
        "warning" => "var(--warning-color, #f59e0b)",
        _ => !string.IsNullOrEmpty(ValueColor) ? ValueColor : "var(--text-main, #0f172a)"
    };

    private static string FormatCurrency(decimal value) => value.ToString("C2", new System.Globalization.CultureInfo("pt-BR"));
}
