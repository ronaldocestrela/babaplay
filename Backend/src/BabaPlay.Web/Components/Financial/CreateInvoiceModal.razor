@namespace BabaPlay.Web.Components.Financial
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@inject IFinancialApiService FinancialApiService

@if (IsOpen)
{
    <div class="modal-backdrop fade show app-modal-backdrop" data-testid="create-invoice-modal-backdrop"></div>
    <div class="modal fade show d-block app-modal" tabindex="-1" data-testid="create-invoice-modal">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold">
                        <i class="bi bi-receipt me-2" aria-hidden="true"></i>
                        Emitir Nova Cobrança
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseAsync" aria-label="Fechar"></button>
                </div>

                <EditForm Model="FormModel" OnValidSubmit="HandleSubmitAsync">
                    <DataAnnotationsValidator />

                    <div class="modal-body">
                        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                        {
                            <div class="alert alert-danger p-2 small mb-3" role="alert" data-testid="modal-error-alert">
                                <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>
                                @ErrorMessage
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label filters-toolbar__label" for="create-invoice-player">Atleta *</label>
                            <InputSelect id="create-invoice-player" @bind-Value="FormModel.PlayerId" class="form-select" data-testid="select-player">
                                <option value="@Guid.Empty">-- Selecione o Atleta --</option>
                                @if (Players != null)
                                {
                                    @foreach (var player in Players)
                                    {
                                        <option value="@player.Id">
                                            @player.Name @(!string.IsNullOrEmpty(player.Nickname) ? $"({player.Nickname})" : "")
                                        </option>
                                    }
                                }
                            </InputSelect>
                            <ValidationMessage For="() => FormModel.PlayerId" class="text-danger small" />
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label filters-toolbar__label" for="create-invoice-year">Ano Competência *</label>
                                <InputNumber id="create-invoice-year" @bind-Value="FormModel.Year" class="form-control" data-testid="input-year" />
                                <ValidationMessage For="() => FormModel.Year" class="text-danger small" />
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label filters-toolbar__label" for="create-invoice-month">Mês Competência *</label>
                                <InputNumber id="create-invoice-month" @bind-Value="FormModel.Month" class="form-control" data-testid="input-month" />
                                <ValidationMessage For="() => FormModel.Month" class="text-danger small" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label filters-toolbar__label" for="create-invoice-amount">Valor (R$) *</label>
                                <InputNumber id="create-invoice-amount" @bind-Value="FormModel.Amount" class="form-control" step="0.01" data-testid="input-amount" />
                                <ValidationMessage For="() => FormModel.Amount" class="text-danger small" />
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label filters-toolbar__label" for="create-invoice-due">Vencimento *</label>
                                <InputDate id="create-invoice-due" @bind-Value="FormModel.DueDateUtc" class="form-control" data-testid="input-due-date" />
                                <ValidationMessage For="() => FormModel.DueDateUtc" class="text-danger small" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label filters-toolbar__label" for="create-invoice-notes">Descrição / Observações</label>
                            <InputTextArea id="create-invoice-notes" @bind-Value="FormModel.Notes" class="form-control" rows="2" placeholder="Ex: Mensalidade de Maio" data-testid="input-notes" />
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseAsync">Cancelar</button>
                        <button type="submit" class="btn btn-outline-primary" disabled="@IsSubmitting" data-testid="btn-submit-invoice">
                            @if (IsSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Gerando...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-lg me-1" aria-hidden="true"></i>
                                <span>Confirmar Emissão</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<InvoiceDto> OnInvoiceCreated { get; set; }
    [Parameter] public List<PlayerDto>? Players { get; set; }

    private CreateInvoiceDto FormModel { get; set; } = new();
    private bool IsSubmitting { get; set; }
    private string? ErrorMessage { get; set; }

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            FormModel = new CreateInvoiceDto
            {
                Year = DateTime.UtcNow.Year,
                Month = DateTime.UtcNow.Month,
                Amount = 50.00m,
                DueDateUtc = DateTime.UtcNow.Date.AddDays(7)
            };
            ErrorMessage = null;
        }
    }

    private async Task CloseAsync()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task HandleSubmitAsync()
    {
        if (FormModel.PlayerId == Guid.Empty)
        {
            ErrorMessage = "Selecione um atleta válido.";
            return;
        }

        IsSubmitting = true;
        ErrorMessage = null;

        try
        {
            var created = await FinancialApiService.CreateInvoiceAsync(FormModel);
            if (created != null)
            {
                if (OnInvoiceCreated.HasDelegate)
                {
                    await OnInvoiceCreated.InvokeAsync(created);
                }
                await CloseAsync();
            }
            else
            {
                ErrorMessage = "Não foi possível gerar a cobrança. Verifique se já existe fatura para a competência ou tente novamente.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao gerar cobrança: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}
