@namespace BabaPlay.Web.Components.Financial

<div class="row g-3 mb-4" data-testid="statement-summary-cards">
    <div class="col-12 col-md-4">
        <div class="stat-card financial-kpi-accent financial-kpi-accent--success" data-testid="card-total-incomes">
            <div class="stat-card__label text-uppercase">
                <i class="bi bi-arrow-down-circle me-1" aria-hidden="true"></i>
                Total Arrecadado (Receitas)
            </div>
            <div class="stat-card__value amount-income" data-testid="val-total-incomes">
                @FormatCurrency(TotalIncomes)
            </div>
            <div class="stat-card__subtitle">Mensalidades e receitas do período</div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="stat-card financial-kpi-accent financial-kpi-accent--danger" data-testid="card-total-expenses">
            <div class="stat-card__label text-uppercase">
                <i class="bi bi-arrow-up-circle me-1" aria-hidden="true"></i>
                Total Gasto (Despesas)
            </div>
            <div class="stat-card__value amount-expense" data-testid="val-total-expenses">
                @FormatCurrency(TotalExpenses)
            </div>
            <div class="stat-card__subtitle">Aluguel de quadras e despesas</div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="stat-card financial-kpi-accent @(NetBalance >= 0 ? "financial-kpi-accent--info" : "financial-kpi-accent--danger")" data-testid="card-net-balance">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="stat-card__label text-uppercase mb-0">
                    <i class="bi bi-scales me-1" aria-hidden="true"></i>
                    Saldo Transparente
                </span>
                @if (NetBalance >= 0)
                {
                    <span class="badge badge-success" data-testid="badge-superavit">Superávit</span>
                }
                else
                {
                    <span class="badge badge-danger" data-testid="badge-deficit">Déficit</span>
                }
            </div>
            <div class="stat-card__value @(NetBalance >= 0 ? "amount-income" : "amount-expense")" data-testid="val-net-balance">
                @FormatCurrency(NetBalance)
            </div>
            <div class="stat-card__subtitle">Resultado líquido do caixa</div>
        </div>
    </div>
</div>

@code {
    [Parameter] public decimal TotalIncomes { get; set; }
    [Parameter] public decimal TotalExpenses { get; set; }
    [Parameter] public decimal NetBalance { get; set; }

    private static string FormatCurrency(decimal val) => val.ToString("C2", new System.Globalization.CultureInfo("pt-BR"));
}
