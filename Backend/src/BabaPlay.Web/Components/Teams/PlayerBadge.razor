@namespace BabaPlay.Web.Components.Teams
@using BabaPlay.Web.Models

<div class="player-badge" data-testid="player-badge-@Player.PlayerId">
    <div class="d-flex align-items-center justify-content-between gap-2">
        <div class="d-flex align-items-center min-w-0">
            <div class="player-badge__avatar me-2" aria-hidden="true">
                @GetInitials(Player.Name)
            </div>
            <div class="min-w-0">
                <div class="player-badge__name" data-testid="player-name">@Player.Name</div>
                <div class="d-flex align-items-center gap-1 flex-wrap">
                    <span class="badge badge-secondary" data-testid="player-position">@Player.PositionName</span>
                    <span class="player-badge__stars" data-testid="player-stars" title="@($"{Player.RatingStars} estrelas")">
                        @RenderStars(Player.RatingStars)
                    </span>
                </div>
            </div>
        </div>

        <div class="btn-group btn-group-sm flex-shrink-0">
            @if (CanMoveLeft)
            {
                <button type="button"
                        class="btn btn-sm btn-outline-secondary player-badge__move"
                        @onclick="() => OnMoveLeft.InvokeAsync(Player)"
                        title="Mover para time anterior"
                        aria-label="Mover para time anterior"
                        data-testid="btn-move-left">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                </button>
            }
            @if (CanMoveRight)
            {
                <button type="button"
                        class="btn btn-sm btn-outline-secondary player-badge__move"
                        @onclick="() => OnMoveRight.InvokeAsync(Player)"
                        title="Mover para próximo time"
                        aria-label="Mover para próximo time"
                        data-testid="btn-move-right">
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public DrawnPlayerDto Player { get; set; } = null!;
    [Parameter] public bool CanMoveLeft { get; set; }
    [Parameter] public bool CanMoveRight { get; set; }
    [Parameter] public EventCallback<DrawnPlayerDto> OnMoveLeft { get; set; }
    [Parameter] public EventCallback<DrawnPlayerDto> OnMoveRight { get; set; }

    private static string RenderStars(int count)
    {
        count = Math.Max(1, Math.Min(5, count));
        return new string('★', count);
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "A";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..1].ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }
}
