@namespace BabaPlay.Web.Components.Teams
@using BabaPlay.Web.Models
@using BabaPlay.Web.Components.Common

<div class="widget-card team-column h-100 mb-0" data-testid="team-column-@Team.TeamId">
    <div class="widget-card__header team-column__header">
        <div>
            <h3 class="widget-card__title mb-0" data-testid="team-name">
                @Team.Name
            </h3>
            <div class="text-muted small" data-testid="team-count">
                @Team.Players.Count atletas escalados
            </div>
        </div>
        <div class="text-end">
            <span class="badge @Team.BadgeClass mb-1" data-testid="team-rating">
                <i class="bi bi-star-fill me-1" aria-hidden="true"></i>@Team.AverageRating.ToString("F1")
            </span>
        </div>
    </div>

    <div class="team-column__players flex-grow-1 overflow-auto pe-1">
        @if (Team.Players.Count == 0)
        {
            <EmptyState IconClass="bi-people"
                        Title="Nenhum jogador neste time."
                        TestId="empty-team" />
        }
        else
        {
            @foreach (var player in Team.Players)
            {
                <PlayerBadge Player="player"
                             CanMoveLeft="CanMoveLeft"
                             CanMoveRight="CanMoveRight"
                             OnMoveLeft="() => OnMovePlayer.InvokeAsync((player, -1))"
                             OnMoveRight="() => OnMovePlayer.InvokeAsync((player, 1))" />
            }
        }
    </div>
</div>

@code {
    [Parameter] public DrawnTeamDto Team { get; set; } = null!;
    [Parameter] public bool CanMoveLeft { get; set; }
    [Parameter] public bool CanMoveRight { get; set; }
    [Parameter] public EventCallback<(DrawnPlayerDto Player, int Direction)> OnMovePlayer { get; set; }
}
