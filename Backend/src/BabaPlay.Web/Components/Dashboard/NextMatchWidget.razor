@namespace BabaPlay.Web.Components.Dashboard
@using BabaPlay.Web.Models
@using BabaPlay.Web.Components.Common

<div class="widget-card next-match-widget" data-testid="next-match-widget">
    <div class="widget-card__header">
        <h3 class="widget-card__title">
            <i class="bi bi-dribbble" aria-hidden="true"></i>
            Próxima Partida
        </h3>
        @if (NextMatch != null)
        {
            <span class="badge @(NextMatch.IsOpenForRsvp ? "badge-success" : "badge-secondary")">
                @(NextMatch.IsOpenForRsvp ? "RSVP Aberto" : "RSVP Encerrado")
            </span>
        }
    </div>

    @if (NextMatch == null)
    {
        <EmptyState IconClass="bi-calendar-x"
                    Title="Nenhum baba agendado no momento"
                    Hint="Fique atento aos comunicados da diretoria para os próximos horários."
                    TestId="no-upcoming-match" />
    }
    else
    {
        <div class="match-info mb-3">
            <h4 class="h6 font-weight-bold mb-1">@NextMatch.Title</h4>
            <div class="d-flex flex-wrap text-muted small gap-3">
                <div><i class="bi bi-calendar3 me-1" aria-hidden="true"></i>@NextMatch.Date.ToString("dd/MM/yyyy HH:mm")</div>
                <div><i class="bi bi-geo-alt me-1" aria-hidden="true"></i>@NextMatch.Location</div>
            </div>
        </div>

        <div class="attendance-progress mb-3">
            <div class="d-flex justify-content-between small mb-1">
                <span>Confirmados</span>
                <span class="font-weight-bold">@NextMatch.ConfirmedCount / @NextMatch.MaxPlayers vagas</span>
            </div>
            <div class="progress rsvp-progress">
                <div class="progress-bar bg-success rsvp-progress__bar"
                     role="progressbar"
                     style="width: @(CalculatePercentage())%;"
                     aria-valuenow="@NextMatch.ConfirmedCount"
                     aria-valuemin="0"
                     aria-valuemax="@NextMatch.MaxPlayers">
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center pt-2 border-top gap-2">
            <div class="rsvp-status small">
                Status:
                @if (NextMatch.UserRsvpStatus == "Confirmed")
                {
                    <span class="badge badge-success ms-1" data-testid="user-rsvp-badge">Vou jogar!</span>
                }
                else if (NextMatch.UserRsvpStatus == "Declined")
                {
                    <span class="badge badge-danger ms-1" data-testid="user-rsvp-badge">Não vou</span>
                }
                else if (NextMatch.UserRsvpStatus == "Waitlist")
                {
                    <span class="badge badge-warning ms-1" data-testid="user-rsvp-badge">Lista de Espera</span>
                }
                else
                {
                    <span class="badge badge-light ms-1" data-testid="user-rsvp-badge">Não respondido</span>
                }
            </div>

            @if (NextMatch.IsOpenForRsvp)
            {
                <div class="rsvp-actions d-flex gap-2">
                    <button class="btn btn-sm btn-outline-success" @onclick="() => OnRsvpStatusChanged.InvokeAsync(true)">
                        Confirmar
                    </button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => OnRsvpStatusChanged.InvokeAsync(false)">
                        Ausente
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public NextMatchWidgetDto? NextMatch { get; set; }
    [Parameter] public EventCallback<bool> OnRsvpStatusChanged { get; set; }

    private int CalculatePercentage()
    {
        if (NextMatch == null || NextMatch.MaxPlayers <= 0) return 0;
        var pct = (int)Math.Round((double)NextMatch.ConfirmedCount / NextMatch.MaxPlayers * 100);
        return Math.Min(100, Math.Max(0, pct));
    }
}
