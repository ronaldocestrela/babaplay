@namespace BabaPlay.Web.Components.Dashboard

<div class="dashboard-skeleton" data-testid="dashboard-skeleton" aria-hidden="true">
    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="widget-card">
                <div class="skeleton skeleton-title mb-3"></div>
                <div class="skeleton skeleton-line mb-2"></div>
                <div class="skeleton skeleton-line skeleton-line--short mb-3"></div>
                <div class="skeleton skeleton-progress mb-3"></div>
                <div class="d-flex justify-content-between gap-2">
                    <div class="skeleton skeleton-badge"></div>
                    <div class="skeleton skeleton-button"></div>
                </div>
            </div>

            <div class="widget-card">
                <div class="skeleton skeleton-title mb-3"></div>
                <div class="stats-grid">
                    @for (var i = 0; i < 4; i++)
                    {
                        <div class="stat-card">
                            <div class="skeleton skeleton-line skeleton-line--short mb-2"></div>
                            <div class="skeleton skeleton-value mb-2"></div>
                            <div class="skeleton skeleton-line skeleton-line--tiny"></div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="widget-card">
                <div class="skeleton skeleton-title mb-3"></div>
                @for (var i = 0; i < 3; i++)
                {
                    <div class="mb-3 pb-3 border-bottom">
                        <div class="d-flex justify-content-between mb-2">
                            <div class="skeleton skeleton-badge"></div>
                            <div class="skeleton skeleton-line skeleton-line--tiny"></div>
                        </div>
                        <div class="skeleton skeleton-line mb-2"></div>
                        <div class="skeleton skeleton-line skeleton-line--short"></div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
