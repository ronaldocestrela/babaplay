@namespace BabaPlay.Web.Components.Dashboard
@using BabaPlay.Web.Models
@using BabaPlay.Web.Components.Common

<div class="widget-card recent-announcements-widget" data-testid="recent-announcements-widget">
    <h3 class="widget-card__title mb-3">
        <i class="bi bi-megaphone" aria-hidden="true"></i>
        Comunicados Recentes
    </h3>

    @if (Announcements == null || Announcements.Count == 0)
    {
        <EmptyState IconClass="bi-inbox"
                    Title="Nenhum comunicado recente publicado."
                    Hint="Os avisos da diretoria aparecerão aqui assim que forem publicados."
                    TestId="no-announcements" />
    }
    else
    {
        <div class="announcements-list">
            @foreach (var item in Announcements)
            {
                <div class="announcement-item pb-3 mb-3 border-bottom" key="@item.Id">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="badge badge-info">@item.Category</span>
                        <small class="text-muted">@item.PublishedAt.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                    <h4 class="h6 font-weight-bold mb-1">@item.Title</h4>
                    <p class="small text-secondary mb-1">@item.Summary</p>
                    <small class="text-muted">Por: @item.AuthorName</small>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<RecentAnnouncementDto> Announcements { get; set; } = new List<RecentAnnouncementDto>();
}
