@namespace BabaPlay.Web.Components.Common

<div class="stat-card">
    <div style="display: flex; align-items: center; justify-content: space-between;">
        <span style="font-size: 0.875rem; color: var(--text-muted); font-weight: 500;">@Title</span>
        @if (!string.IsNullOrEmpty(Icon))
        {
            <span style="font-size: 1.25rem;">@Icon</span>
        }
    </div>
    <div style="font-size: 1.75rem; font-weight: 700; color: var(--text-main); margin-top: 0.5rem;">
        @Value
    </div>
    @if (!string.IsNullOrEmpty(Subtitle))
    {
        <div style="font-size: 0.75rem; color: var(--primary-color); margin-top: 0.25rem;">
            @Subtitle
        </div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Icon { get; set; }
}
