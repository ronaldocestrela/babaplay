@namespace BabaPlay.Web.Components.Common

@if (IsVisible)
{
    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem;">
        <div class="loading-spinner"></div>
        @if (!string.IsNullOrEmpty(Message))
        {
            <p style="margin-top: 0.75rem; color: var(--text-muted); font-size: 0.875rem;">@Message</p>
        }
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; } = true;
    [Parameter] public string? Message { get; set; }
}
