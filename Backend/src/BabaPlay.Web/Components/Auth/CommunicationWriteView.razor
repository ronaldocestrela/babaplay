@namespace BabaPlay.Web.Components.Auth
@using BabaPlay.Application.Common
@inject TenantState TenantState
@implements IDisposable

@if (CanWriteCommunication)
{
    @ChildContent
}

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool CanWriteCommunication =>
        TenantState.IsOwner
        || TenantState.HasPermission(RbacCatalog.Permissions.CommunicationWrite);

    protected override void OnInitialized()
    {
        TenantState.OnChange += OnTenantChanged;
    }

    private void OnTenantChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        TenantState.OnChange -= OnTenantChanged;
    }
}
