@using Microsoft.AspNetCore.Components.Forms
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@inject ITenantApiService TenantApiService

<div class="widget-card" data-testid="tenant-general-settings-widget">
    <div class="widget-card__header">
        <h2 class="widget-card__title">
            <i class="bi bi-gear-fill" aria-hidden="true"></i>
            Configurações Gerais & Identidade
        </h2>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" data-testid="settings-error-alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
            @ErrorMessage
            <button type="button" class="btn-close" @onclick="() => ErrorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" data-testid="settings-success-alert">
            <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>
            @SuccessMessage
            <button type="button" class="btn-close" @onclick="() => SuccessMessage = null"></button>
        </div>
    }

    <EditForm Model="Model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label filters-toolbar__label" for="input-tenant-name">Nome da Associação <span class="text-danger">*</span></label>
                <InputText id="input-tenant-name" @bind-Value="Model.Name" class="form-control" placeholder="Ex: Baba das Galáxias FC" data-testid="input-tenant-name" />
                <ValidationMessage For="() => Model.Name" class="text-danger small" />
            </div>

            <div class="col-md-4">
                <label class="form-label filters-toolbar__label" for="input-players-per-team">Atletas por Time <span class="text-danger">*</span></label>
                <InputNumber id="input-players-per-team" @bind-Value="Model.PlayersPerTeam" class="form-control" min="2" max="22" data-testid="input-players-per-team" />
                <ValidationMessage For="() => Model.PlayersPerTeam" class="text-danger small" />
                <small class="text-muted d-block mt-1">Usado como padrão no sorteio de times.</small>
            </div>

            <div class="col-12">
                <label class="form-label filters-toolbar__label" for="input-tenant-logo">Escudo / Logo da Associação</label>
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    @if (!string.IsNullOrWhiteSpace(CurrentLogoUrl))
                    {
                        <img src="@CurrentLogoUrl" alt="Escudo Atual" class="tenant-logo-preview" data-testid="tenant-logo-preview" />
                    }
                    else
                    {
                        <div class="tenant-logo-placeholder" data-testid="tenant-logo-placeholder">
                            <i class="bi bi-shield-fill" aria-hidden="true"></i>
                        </div>
                    }
                    <div class="flex-grow-1">
                        <InputFile id="input-tenant-logo" OnChange="HandleFileSelected" class="form-control" accept="image/*" data-testid="input-tenant-logo" />
                        <small class="text-muted d-block mt-1">Formatos aceitos: PNG, JPG ou WEBP. Tamanho máximo: 5 MB.</small>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <hr class="settings-section-divider" />
                <h3 class="settings-section-title">
                    <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                    Endereço da Sede / Campo Principal
                </h3>
            </div>

            <div class="col-md-8">
                <label class="form-label filters-toolbar__label" for="input-street">Logradouro / Rua</label>
                <InputText id="input-street" @bind-Value="Model.Street" class="form-control" placeholder="Ex: Av. dos Esportes" data-testid="input-street" />
            </div>

            <div class="col-md-4">
                <label class="form-label filters-toolbar__label" for="input-number">Número</label>
                <InputText id="input-number" @bind-Value="Model.Number" class="form-control" placeholder="Ex: 100" data-testid="input-number" />
            </div>

            <div class="col-md-4">
                <label class="form-label filters-toolbar__label" for="input-neighborhood">Bairro</label>
                <InputText id="input-neighborhood" @bind-Value="Model.Neighborhood" class="form-control" placeholder="Ex: Centro" data-testid="input-neighborhood" />
            </div>

            <div class="col-md-5">
                <label class="form-label filters-toolbar__label" for="input-city">Cidade</label>
                <InputText id="input-city" @bind-Value="Model.City" class="form-control" placeholder="Ex: Salvador" data-testid="input-city" />
            </div>

            <div class="col-md-3">
                <label class="form-label filters-toolbar__label" for="input-state">UF / Estado</label>
                <InputText id="input-state" @bind-Value="Model.State" class="form-control" placeholder="Ex: BA" data-testid="input-state" />
            </div>

            <div class="col-md-4">
                <label class="form-label filters-toolbar__label" for="input-zipcode">CEP</label>
                <InputText id="input-zipcode" @bind-Value="Model.ZipCode" class="form-control" placeholder="Ex: 40000-000" data-testid="input-zipcode" />
            </div>

            <div class="col-md-4">
                <label class="form-label filters-toolbar__label" for="input-latitude">Latitude</label>
                <InputNumber id="input-latitude" @bind-Value="Model.AssociationLatitude" class="form-control" placeholder="-12.9714" step="any" data-testid="input-latitude" />
            </div>

            <div class="col-md-4">
                <label class="form-label filters-toolbar__label" for="input-longitude">Longitude</label>
                <InputNumber id="input-longitude" @bind-Value="Model.AssociationLongitude" class="form-control" placeholder="-38.5014" step="any" data-testid="input-longitude" />
            </div>

            <div class="col-12 mt-2 text-end">
                <button type="submit" class="btn btn-primary px-4" disabled="@IsSubmitting" data-testid="btn-save-general-settings">
                    @if (IsSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Salvando...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg me-1" aria-hidden="true"></i>
                        <span>Salvar Alterações</span>
                    }
                </button>
            </div>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public TenantSettingsDto? InitialSettings { get; set; }

    [Parameter]
    public EventCallback<TenantSettingsDto> OnSettingsUpdated { get; set; }

    private UpdateTenantSettingsDto Model { get; set; } = new();
    private string? CurrentLogoUrl { get; set; }
    private IBrowserFile? SelectedLogoFile { get; set; }
    private bool IsSubmitting { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }

    protected override void OnParametersSet()
    {
        if (InitialSettings != null)
        {
            Model = new UpdateTenantSettingsDto
            {
                Name = InitialSettings.Name,
                PlayersPerTeam = InitialSettings.PlayersPerTeam > 0 ? InitialSettings.PlayersPerTeam : 10,
                Street = InitialSettings.Street,
                Number = InitialSettings.Number,
                Neighborhood = InitialSettings.Neighborhood,
                City = InitialSettings.City,
                State = InitialSettings.State,
                ZipCode = InitialSettings.ZipCode,
                AssociationLatitude = InitialSettings.AssociationLatitude,
                AssociationLongitude = InitialSettings.AssociationLongitude
            };
            CurrentLogoUrl = InitialSettings.LogoPath;
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        SelectedLogoFile = e.File;
    }

    private async Task HandleSubmit()
    {
        IsSubmitting = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            var updatedSettings = await TenantApiService.UpdateSettingsAsync(Model, SelectedLogoFile);
            if (updatedSettings != null)
            {
                SuccessMessage = "Configurações salvas com sucesso!";
                CurrentLogoUrl = updatedSettings.LogoPath;
                SelectedLogoFile = null;
                if (OnSettingsUpdated.HasDelegate)
                {
                    await OnSettingsUpdated.InvokeAsync(updatedSettings);
                }
            }
            else
            {
                ErrorMessage = "Não foi possível salvar as configurações. Verifique os dados e tente novamente.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao salvar configurações: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}
