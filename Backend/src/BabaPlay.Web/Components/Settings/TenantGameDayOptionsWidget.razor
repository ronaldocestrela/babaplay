@using Microsoft.AspNetCore.Components.Forms
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@using BabaPlay.Web.Components.Common
@inject ITenantApiService TenantApiService

<div class="gameday-options" data-testid="tenant-game-day-options-widget">
    <div class="page-header gameday-options__header">
        <div>
            <h2 class="page-header__title">
                <i class="bi bi-calendar-week-fill me-2 text-primary-light" aria-hidden="true"></i>
                <span class="text-gradient">Dias Fixos do Baba</span>
            </h2>
            <p class="page-header__subtitle">Agenda recorrente semanal usada no agendamento automático dos babas.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button"
                    class="btn btn-outline-primary btn-sm"
                    @onclick="LoadOptionsAsync"
                    disabled="@IsLoading"
                    data-testid="btn-refresh-gameday-options">
                @if (IsRefreshing)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Atualizando...</span>
                }
                else
                {
                    <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>
                    <span>Atualizar</span>
                }
            </button>
            <button type="button"
                    class="btn btn-sm @(ShowAddForm ? "btn-outline-secondary" : "btn-outline-primary")"
                    @onclick="ToggleAddForm"
                    data-testid="btn-toggle-add-option">
                <i class="bi @(ShowAddForm ? "bi-x-lg" : "bi-plus-lg") me-1" aria-hidden="true"></i>
                @(ShowAddForm ? "Cancelar" : "Novo Dia Fixo")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" data-testid="gameday-options-error-alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
            @ErrorMessage
            <button type="button" class="btn-close" @onclick="() => ErrorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" data-testid="gameday-options-success-alert">
            <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>
            @SuccessMessage
            <button type="button" class="btn-close" @onclick="() => SuccessMessage = null"></button>
        </div>
    }

    @if (ShowAddForm)
    {
        <div class="widget-card filters-toolbar mb-4" data-testid="add-gameday-option-form">
            <h3 class="settings-section-title mb-3">
                <i class="bi bi-plus-circle" aria-hidden="true"></i>
                Adicionar Novo Dia Fixo
            </h3>
            <EditForm Model="NewOptionModel" OnValidSubmit="HandleCreateOption">
                <DataAnnotationsValidator />
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-5">
                        <label class="form-label filters-toolbar__label" for="select-day-of-week">Dia da Semana</label>
                        <InputSelect id="select-day-of-week" @bind-Value="NewOptionModel.DayOfWeek" class="form-select" data-testid="select-day-of-week">
                            <option value="@DayOfWeek.Sunday">Domingo</option>
                            <option value="@DayOfWeek.Monday">Segunda-feira</option>
                            <option value="@DayOfWeek.Tuesday">Terça-feira</option>
                            <option value="@DayOfWeek.Wednesday">Quarta-feira</option>
                            <option value="@DayOfWeek.Thursday">Quinta-feira</option>
                            <option value="@DayOfWeek.Friday">Sexta-feira</option>
                            <option value="@DayOfWeek.Saturday">Sábado</option>
                        </InputSelect>
                    </div>
                    <div class="col-12 col-sm-6 col-md-4">
                        <label class="form-label filters-toolbar__label" for="input-start-time">Horário de Início</label>
                        <input id="input-start-time" type="time" class="form-control" value="@NewOptionTimeInput" @onchange="OnTimeInputChanged" data-testid="input-start-time" />
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <button type="submit" class="btn btn-success w-100" disabled="@IsSubmitting" data-testid="btn-submit-gameday-option">
                            @if (IsSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Adicionando...</span>
                            }
                            else
                            {
                                <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>
                                <span>Adicionar</span>
                            }
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    }

    @if (IsInitialLoading)
    {
        <LoadingSpinner Message="Carregando dias fixos..." />
    }
    else if (Options.Count == 0)
    {
        <EmptyState IsPageLevel="true"
                    IconClass="bi-calendar-x"
                    Title="Nenhum dia fixo cadastrado"
                    Hint="Cadastre os dias e horários recorrentes dos babas desta associação."
                    TestId="empty-gameday-options">
            <button type="button" class="btn btn-outline-primary" @onclick="OpenAddForm">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Cadastrar primeiro dia fixo
            </button>
        </EmptyState>
    }
    else
    {
        <div class="list-content @(IsRefreshing ? "list-content--refreshing" : null)">
            <p class="list-summary text-muted small mb-3">
                Exibindo <strong>@Options.Count</strong> dia(s) fixo(s) —
                <strong>@Options.Count(o => o.IsActive)</strong> ativo(s).
            </p>

            <div class="widget-card overflow-hidden p-0">
                <div class="table-responsive d-none d-md-block">
                    <table class="table table-hover align-middle mb-0 financial-table" data-testid="gameday-options-table">
                        <thead>
                            <tr>
                                <th>Dia da Semana</th>
                                <th>Horário Local</th>
                                <th>Status</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Options)
                            {
                                <tr data-testid="gameday-option-row-@item.Id">
                                    <td>
                                        <span class="font-weight-bold">@TranslateDayOfWeek(item.DayOfWeek)</span>
                                    </td>
                                    <td>
                                        <i class="bi bi-clock me-1 text-muted" aria-hidden="true"></i>
                                        @item.LocalStartTime.ToString("HH:mm")
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge badge-success" data-testid="status-active-@item.Id">
                                                <i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i> Ativo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary" data-testid="status-inactive-@item.Id">
                                                <i class="bi bi-dash-circle-fill me-1" aria-hidden="true"></i> Inativo
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button type="button"
                                                class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                @onclick="() => ToggleStatus(item)"
                                                data-testid="btn-toggle-status-@item.Id">
                                            <i class="bi @(item.IsActive ? "bi-pause-circle" : "bi-play-circle") me-1" aria-hidden="true"></i>
                                            @(item.IsActive ? "Desativar" : "Ativar")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="gameday-options__cards d-md-none" data-testid="gameday-options-cards">
                    @foreach (var item in Options)
                    {
                        <div class="gameday-option-card" data-testid="gameday-option-row-@item.Id">
                            <div class="gameday-option-card__main">
                                <div class="gameday-option-card__day">@TranslateDayOfWeek(item.DayOfWeek)</div>
                                <div class="gameday-option-card__time text-muted">
                                    <i class="bi bi-clock me-1" aria-hidden="true"></i>
                                    @item.LocalStartTime.ToString("HH:mm")
                                </div>
                            </div>
                            <div class="gameday-option-card__actions">
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-success" data-testid="status-active-@item.Id">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary" data-testid="status-inactive-@item.Id">Inativo</span>
                                }
                                <button type="button"
                                        class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                        @onclick="() => ToggleStatus(item)"
                                        data-testid="btn-toggle-status-@item.Id">
                                    <i class="bi @(item.IsActive ? "bi-pause-circle" : "bi-play-circle") me-1" aria-hidden="true"></i>
                                    @(item.IsActive ? "Desativar" : "Ativar")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<TenantGameDayOptionDto> Options { get; set; } = new();
    private CreateTenantGameDayOptionDto NewOptionModel { get; set; } = new();
    private string NewOptionTimeInput { get; set; } = "08:00";
    private bool ShowAddForm { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool HasLoadedOnce { get; set; }
    private bool IsSubmitting { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }

    private bool IsInitialLoading => IsLoading && !HasLoadedOnce;
    private bool IsRefreshing => IsLoading && HasLoadedOnce;

    protected override async Task OnInitializedAsync()
    {
        await LoadOptionsAsync();
    }

    private async Task LoadOptionsAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var result = await TenantApiService.GetGameDayOptionsAsync();
            Options = result?.ToList() ?? new List<TenantGameDayOptionDto>();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao carregar dias fixos: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            HasLoadedOnce = true;
        }
    }

    private void ToggleAddForm()
    {
        ShowAddForm = !ShowAddForm;
        ErrorMessage = null;
        SuccessMessage = null;
    }

    private void OpenAddForm()
    {
        ShowAddForm = true;
        ErrorMessage = null;
        SuccessMessage = null;
    }

    private void OnTimeInputChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(val) && TimeOnly.TryParse(val, out var time))
        {
            NewOptionTimeInput = val;
            NewOptionModel.LocalStartTime = time;
        }
    }

    private async Task HandleCreateOption()
    {
        IsSubmitting = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            var created = await TenantApiService.CreateGameDayOptionAsync(NewOptionModel);
            if (created != null)
            {
                SuccessMessage = "Dia fixo adicionado com sucesso!";
                ShowAddForm = false;
                NewOptionModel = new CreateTenantGameDayOptionDto();
                NewOptionTimeInput = "08:00";
                await LoadOptionsAsync();
            }
            else
            {
                ErrorMessage = "Este dia fixo e horário já existe ou não pôde ser cadastrado.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao salvar dia fixo: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task ToggleStatus(TenantGameDayOptionDto item)
    {
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            var updated = await TenantApiService.ChangeGameDayOptionStatusAsync(item.Id, !item.IsActive);
            if (updated != null)
            {
                SuccessMessage = $"Status alterado para {(updated.IsActive ? "Ativo" : "Inativo")}.";
                await LoadOptionsAsync();
            }
            else
            {
                ErrorMessage = "Não foi possível alterar o status da opção.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao alterar status: {ex.Message}";
        }
    }

    private string TranslateDayOfWeek(DayOfWeek day) => day switch
    {
        DayOfWeek.Sunday => "Domingo",
        DayOfWeek.Monday => "Segunda-feira",
        DayOfWeek.Tuesday => "Terça-feira",
        DayOfWeek.Wednesday => "Quarta-feira",
        DayOfWeek.Thursday => "Quinta-feira",
        DayOfWeek.Friday => "Sexta-feira",
        DayOfWeek.Saturday => "Sábado",
        _ => day.ToString()
    };
}
