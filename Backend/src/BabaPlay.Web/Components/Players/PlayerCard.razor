@namespace BabaPlay.Web.Components.Players
@using BabaPlay.Web.Models

<div class="player-card @(Player.IsActive ? "" : "player-card--inactive")" data-testid="player-card-@Player.Id">
    <div class="player-card__header">
        <div class="player-card__avatar-wrap">
            @if (!string.IsNullOrWhiteSpace(Player.PhotoUrl))
            {
                <img src="@Player.PhotoUrl" alt="@Player.Name" class="player-card__avatar" />
            }
            else
            {
                <div class="player-card__avatar-fallback">@GetInitials(Player.Name)</div>
            }
            @if (Player.JerseyNumber.HasValue)
            {
                <span class="player-card__jersey">#@Player.JerseyNumber.Value</span>
            }
        </div>

        <span class="badge @(Player.IsActive ? "badge-success" : "badge-secondary")">
            @(Player.IsActive ? "Ativo" : "Inativo")
        </span>
    </div>

    <div class="player-card__body">
        <h3 class="player-card__name">@Player.Name</h3>
        @if (!string.IsNullOrWhiteSpace(Player.Nickname))
        {
            <p class="player-card__nickname">"@Player.Nickname"</p>
        }

        <dl class="player-card__details">
            <div class="player-card__detail">
                <dt>Posição</dt>
                <dd>
                    <span class="badge badge-secondary">
                        @(string.IsNullOrWhiteSpace(Player.PrimaryPositionName) ? "Não definida" : Player.PrimaryPositionName)
                    </span>
                </dd>
            </div>
            <div class="player-card__detail">
                <dt>Pé preferido</dt>
                <dd>@TranslateFoot(Player.PreferredFoot)</dd>
            </div>
            <div class="player-card__detail">
                <dt>Perfil</dt>
                <dd>
                    <span class="badge @GetRoleBadgeClass(Player.RoleName)">
                        @(string.IsNullOrWhiteSpace(Player.RoleName) ? "Atleta" : Player.RoleName)
                    </span>
                </dd>
            </div>
        </dl>
    </div>

    <div class="player-card__actions">
        <button class="btn btn-outline-primary btn-sm w-100 btn-edit-player" @onclick="() => OnEdit.InvokeAsync(Player)">
            <i class="bi bi-pencil me-1" aria-hidden="true"></i> Editar atleta
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public PlayerDto Player { get; set; } = default!;

    [Parameter]
    public EventCallback<PlayerDto> OnEdit { get; set; }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "AP";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private static string TranslateFoot(string? foot) => foot switch
    {
        "Right" => "Direito",
        "Left" => "Esquerdo",
        "Both" => "Ambidestro",
        _ => "Não informado"
    };

    private static string GetRoleBadgeClass(string? roleName) => roleName?.ToLower() switch
    {
        "admin" or "administrador" => "badge-warning",
        "treinador" or "coach" => "badge-info",
        _ => "badge-primary"
    };
}
