@using BabaPlay.Web.Models

<div class="player-card @(Player.IsActive ? "" : "inactive")" data-testid="player-card-@Player.Id">
    <div class="player-card-header">
        <div class="avatar-container">
            @if (!string.IsNullOrWhiteSpace(Player.PhotoUrl))
            {
                <img src="@Player.PhotoUrl" alt="@Player.Name" class="player-avatar" />
            }
            else
            {
                <div class="player-avatar-fallback">
                    @GetInitials(Player.Name)
                </div>
            }
            @if (Player.JerseyNumber.HasValue)
            {
                <span class="jersey-number-badge">#@Player.JerseyNumber.Value</span>
            }
        </div>

        <div class="status-indicator">
            <span class="badge @(Player.IsActive ? "badge-success" : "badge-secondary")">
                @(Player.IsActive ? "Ativo" : "Inativo")
            </span>
        </div>
    </div>

    <div class="player-card-body">
        <h3 class="player-name">@Player.Name</h3>
        @if (!string.IsNullOrWhiteSpace(Player.Nickname))
        {
            <p class="player-nickname">"@Player.Nickname"</p>
        }

        <div class="player-details">
            <div class="detail-item">
                <span class="detail-label">Posição:</span>
                <span class="detail-value position-badge">@(string.IsNullOrWhiteSpace(Player.PrimaryPositionName) ? "Não definida" : Player.PrimaryPositionName)</span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Pé Preferido:</span>
                <span class="detail-value">@TranslateFoot(Player.PreferredFoot)</span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Perfil:</span>
                <span class="detail-value role-badge @GetRoleBadgeClass(Player.RoleName)">
                    @(string.IsNullOrWhiteSpace(Player.RoleName) ? "Atleta" : Player.RoleName)
                </span>
            </div>
        </div>
    </div>

    <div class="player-card-actions">
        <button class="btn btn-primary btn-sm btn-edit-player" @onclick="() => OnEdit.InvokeAsync(Player)">
            <i class="bi bi-pencil"></i> Editar Atleta
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public PlayerDto Player { get; set; } = default!;

    [Parameter]
    public EventCallback<PlayerDto> OnEdit { get; set; }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "AP";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private string TranslateFoot(string? foot) => foot switch
    {
        "Right" => "Direito",
        "Left" => "Esquerdo",
        "Both" => "Ambidestro",
        _ => "Não informado"
    };

    private string GetRoleBadgeClass(string? roleName) => roleName?.ToLower() switch
    {
        "admin" or "administrador" => "badge-admin",
        "treinador" or "coach" => "badge-coach",
        _ => "badge-player"
    };
}
