@namespace BabaPlay.Web.Components.Communication
@using BabaPlay.Web.Components.Auth
@using BabaPlay.Web.Models

@if (Poll != null)
{
    <div class="widget-card poll-card"
         data-testid="poll-card"
         @attributes="AdditionalAttributes">

        <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                @if (Poll.IsClosed)
                {
                    <span class="badge badge-secondary" data-testid="badge-closed">Encerrada</span>
                }
                else if (Poll.HasVoted)
                {
                    <span class="badge badge-success" data-testid="badge-voted">Voto Computado</span>
                }
                else
                {
                    <span class="badge badge-primary" data-testid="badge-open">Enquete Aberta</span>
                }

                <span class="badge badge-light" data-testid="badge-total-votes">
                    <i class="bi bi-bar-chart me-1" aria-hidden="true"></i>
                    @Poll.TotalVotes voto(s)
                </span>
            </div>

            <small class="text-muted text-nowrap">
                Por: <strong>@Poll.AuthorName</strong>
            </small>
        </div>

        <h2 class="widget-card__title mb-1" data-testid="poll-title">
            <i class="bi bi-ui-checks-grid" aria-hidden="true"></i>
            @Poll.Title
        </h2>

        @if (!string.IsNullOrWhiteSpace(Poll.Description))
        {
            <p class="text-muted mb-3" data-testid="poll-description">
                @Poll.Description
            </p>
        }

        <hr class="poll-card__divider" />

        @if (!Poll.HasVoted && !Poll.IsClosed)
        {
            <div class="mb-3" data-testid="vote-form">
                @foreach (var option in Poll.Options)
                {
                    <div class="poll-option @(SelectedOptionId == option.Id ? "poll-option--selected" : null)"
                         @onclick="() => SelectedOptionId = option.Id"
                         data-testid="option-select-row">
                        <input class="form-check-input"
                               type="radio"
                               name="pollOptions_@Poll.Id"
                               id="opt_@option.Id"
                               value="@option.Id"
                               checked="@(SelectedOptionId == option.Id)"
                               @onchange="() => SelectedOptionId = option.Id"
                               data-testid="radio-option" />
                        <label class="form-check-label font-weight-bold" for="opt_@option.Id">
                            @option.Text
                        </label>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <button type="button"
                        class="btn btn-sm btn-primary font-weight-bold"
                        disabled="@(SelectedOptionId == null || _isSubmitting)"
                        @onclick="HandleSubmitVoteAsync"
                        data-testid="btn-submit-vote">
                    @if (_isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Enviando…</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-square me-1" aria-hidden="true"></i>
                        <span>Confirmar Voto</span>
                    }
                </button>

                <CommunicationWriteView>
                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            @onclick="HandleClosePollAsync"
                            disabled="@_isClosing"
                            data-testid="btn-close-poll">
                        <i class="bi bi-lock me-1" aria-hidden="true"></i>
                        Encerrar Enquete
                    </button>
                </CommunicationWriteView>
            </div>
        }
        else
        {
            <div class="mb-3" data-testid="poll-results">
                @foreach (var option in Poll.Options)
                {
                    var isMyChoice = Poll.VotedOptionId == option.Id;

                    <div class="poll-result @(isMyChoice ? "poll-result--mine" : null)" data-testid="result-row">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="font-weight-bold">
                                @option.Text
                                @if (isMyChoice)
                                {
                                    <span class="badge badge-success ms-1" data-testid="badge-my-choice">Seu voto</span>
                                }
                            </span>
                            <span class="text-muted font-weight-bold" data-testid="option-percentage">
                                @option.Percentage% <small class="fw-normal">(@option.VotesCount)</small>
                            </span>
                        </div>
                        <div class="progress financial-collection-progress">
                            <div class="progress-bar @(isMyChoice ? "financial-collection-progress__bar--success" : "financial-collection-progress__bar--primary")"
                                 role="progressbar"
                                 style="width: @(Math.Min(100, option.Percentage))%"
                                 aria-valuenow="@option.Percentage"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                            </div>
                        </div>
                    </div>
                }
            </div>

            <CommunicationWriteView>
                @if (!Poll.IsClosed)
                {
                    <div class="text-end">
                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                @onclick="HandleClosePollAsync"
                                disabled="@_isClosing"
                                data-testid="btn-close-poll">
                            <i class="bi bi-lock me-1" aria-hidden="true"></i>
                            Encerrar Enquete
                        </button>
                    </div>
                }
            </CommunicationWriteView>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public PollDto Poll { get; set; } = null!;
    [Parameter] public EventCallback<Guid> OnVoteSubmitted { get; set; }
    [Parameter] public EventCallback OnPollClosed { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private Guid? SelectedOptionId { get; set; }
    private bool _isSubmitting = false;
    private bool _isClosing = false;

    private async Task HandleSubmitVoteAsync()
    {
        if (SelectedOptionId is null) return;
        _isSubmitting = true;
        await OnVoteSubmitted.InvokeAsync(SelectedOptionId.Value);
        _isSubmitting = false;
    }

    private async Task HandleClosePollAsync()
    {
        _isClosing = true;
        await OnPollClosed.InvokeAsync();
        _isClosing = false;
    }
}
