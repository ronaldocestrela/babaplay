@namespace BabaPlay.Web.Components.Communication
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@inject ICommunicationApiService CommunicationApiService

@if (IsOpen)
{
    <div class="modal-backdrop fade show app-modal-backdrop" data-testid="create-announcement-backdrop"></div>
    <div class="modal fade show d-block app-modal" tabindex="-1" data-testid="create-announcement-modal">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold">
                        <i class="bi bi-megaphone me-2" aria-hidden="true"></i>
                        Publicar Novo Comunicado
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseAsync" aria-label="Fechar" data-testid="btn-close-modal"></button>
                </div>

                <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync" data-testid="form-create-announcement">
                    <DataAnnotationsValidator />

                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger p-2 small mb-3" role="alert" data-testid="modal-error-alert">
                                <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>
                                @ErrorMessage
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label filters-toolbar__label" for="input-announcement-title">Título *</label>
                            <InputText id="input-announcement-title"
                                       class="form-control"
                                       placeholder="Ex: Informativo sobre mudança de horário"
                                       @bind-Value="Model.Title"
                                       data-testid="input-announcement-title" />
                            <ValidationMessage For="() => Model.Title" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label filters-toolbar__label" for="input-announcement-content">Conteúdo *</label>
                            <InputTextArea id="input-announcement-content"
                                           class="form-control"
                                           rows="5"
                                           placeholder="Escreva o comunicado completo aqui..."
                                           @bind-Value="Model.Content"
                                           data-testid="input-announcement-content" />
                            <ValidationMessage For="() => Model.Content" class="text-danger small" />
                            <small class="text-muted">@(Model.Content?.Length ?? 0) / 5000 caracteres</small>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label filters-toolbar__label" for="input-announcement-tags">Tags (Opcional)</label>
                                <InputText id="input-announcement-tags"
                                           class="form-control"
                                           placeholder="Ex: importante, horário, uniforme"
                                           @bind-Value="Model.Tags"
                                           data-testid="input-announcement-tags" />
                                <ValidationMessage For="() => Model.Tags" class="text-danger small" />
                                <small class="text-muted">Separe com vírgulas</small>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label filters-toolbar__label" for="input-announcement-expiry">Expira em (Opcional)</label>
                                <InputDate id="input-announcement-expiry"
                                           class="form-control"
                                           @bind-Value="Model.ExpiresAtUtc"
                                           data-testid="input-announcement-expiry" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="CloseAsync"
                                disabled="@_isLoading"
                                data-testid="btn-cancel">
                            Cancelar
                        </button>
                        <button type="submit"
                                class="btn btn-success"
                                disabled="@_isLoading"
                                data-testid="btn-submit-announcement">
                            @if (_isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Publicando…</span>
                            }
                            else
                            {
                                <i class="bi bi-megaphone me-1" aria-hidden="true"></i>
                                <span>Publicar</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; } = false;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<AnnouncementDto> OnCreated { get; set; }

    private CreateAnnouncementDto Model { get; set; } = new();
    private bool _isLoading = false;
    private string? ErrorMessage;

    private async Task HandleSubmitAsync()
    {
        _isLoading = true;
        ErrorMessage = null;

        try
        {
            var result = await CommunicationApiService.CreateAnnouncementAsync(Model);
            if (result is null)
            {
                ErrorMessage = "Não foi possível publicar o comunicado. Verifique sua conexão ou permissões.";
                return;
            }

            Model = new();
            await OnCreated.InvokeAsync(result);
            await OnClose.InvokeAsync();
        }
        catch
        {
            ErrorMessage = "Erro inesperado ao publicar o comunicado. Tente novamente.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CloseAsync()
    {
        Model = new();
        ErrorMessage = null;
        await OnClose.InvokeAsync();
    }
}
