@namespace BabaPlay.Web.Components.Communication
@using BabaPlay.Web.Models

@if (Announcement != null)
{
    <div class="card shadow-sm mb-3 announcement-card @(Announcement.IsRead ? "" : "announcement-unread")"
         style="border-radius: 12px; border-left: 4px solid @(Announcement.IsNew ? "var(--color-new, #10b981)" : "var(--border-color, #e2e8f0)"); background: var(--bg-surface, #ffffff);"
         data-testid="announcement-card"
         @attributes="AdditionalAttributes">

        <div class="card-body p-4">

            <!-- Header: Título + Badges -->
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    @if (Announcement.IsNew)
                    {
                        <span class="badge bg-success badge-new pulse-badge"
                              style="font-size: 0.7rem; letter-spacing: 0.03em;"
                              data-testid="badge-new">
                            🆕 Novo
                        </span>
                    }
                    @if (!Announcement.IsRead)
                    {
                        <span class="badge"
                              style="background-color: #3b82f6; font-size: 0.7rem;"
                              data-testid="badge-unread">
                            ✉ Não lido
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary"
                              style="font-size: 0.65rem; opacity: 0.7;"
                              data-testid="badge-read">
                            ✔ Lido
                        </span>
                    }
                </div>

                <small class="text-muted" style="font-size: 0.78rem; white-space: nowrap;">
                    @(Announcement.PublishedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
                </small>
            </div>

            <!-- Título -->
            <h5 class="font-weight-bold mb-1" style="color: var(--text-main);" data-testid="announcement-title">
                📢 @Announcement.Title
            </h5>

            <!-- Autor -->
            <small class="text-muted d-block mb-3" style="font-size: 0.8rem;" data-testid="announcement-author">
                Por: <strong>@Announcement.AuthorName</strong>
            </small>

            <!-- Conteúdo -->
            <div style="font-size: 0.9rem; line-height: 1.6; color: var(--text-muted);" data-testid="announcement-content">
                @if (IsExpanded || Announcement.Content.Length <= 200)
                {
                    @Announcement.Content
                }
                else
                {
                    @(Announcement.Content[..200])
                    <span>… </span>
                }
            </div>

            @if (Announcement.Content.Length > 200)
            {
                <button class="btn btn-link btn-sm p-0 mt-1"
                        style="font-size: 0.8rem;"
                        @onclick="ToggleExpand"
                        data-testid="btn-expand">
                    @(IsExpanded ? "Ver menos" : "Ver mais")
                </button>
            }

            <!-- Tags -->
            @if (!string.IsNullOrWhiteSpace(Announcement.Tags))
            {
                <div class="mt-3 d-flex flex-wrap gap-1" data-testid="announcement-tags">
                    @foreach (var tag in Announcement.Tags.Split(',', System.StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="badge"
                              style="background: var(--bg-muted, #f1f5f9); color: var(--text-muted); font-size: 0.72rem; border-radius: 20px; padding: 3px 10px;">
                            #@tag.Trim()
                        </span>
                    }
                </div>
            }

            <!-- Expiração -->
            @if (Announcement.ExpiresAtUtc.HasValue)
            {
                <small class="text-warning d-block mt-2" style="font-size: 0.78rem;" data-testid="announcement-expiry">
                    ⏰ Válido até: @Announcement.ExpiresAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy")
                </small>
            }

            <!-- Ação: Marcar como lido -->
            @if (!Announcement.IsRead)
            {
                <div class="mt-3">
                    <button class="btn btn-sm btn-outline-success"
                            style="font-size: 0.82rem; border-radius: 8px;"
                            disabled="@_isMarkingRead"
                            @onclick="MarkAsReadAsync"
                            data-testid="btn-mark-read">
                        @if (_isMarkingRead)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        ✔ Marcar como lido
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public AnnouncementDto Announcement { get; set; } = null!;
    [Parameter] public EventCallback OnRead { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsExpanded { get; set; } = false;
    private bool _isMarkingRead = false;

    private void ToggleExpand() => IsExpanded = !IsExpanded;

    private async Task MarkAsReadAsync()
    {
        _isMarkingRead = true;
        await OnRead.InvokeAsync();
        _isMarkingRead = false;
    }
}
