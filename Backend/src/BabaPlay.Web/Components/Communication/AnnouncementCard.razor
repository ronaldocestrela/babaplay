@namespace BabaPlay.Web.Components.Communication
@using BabaPlay.Web.Models

@if (Announcement != null)
{
    <div class="widget-card announcement-card @(Announcement.IsRead ? "announcement-card--read" : "announcement-card--unread") @(Announcement.IsNew ? "announcement-card--new" : null)"
         data-testid="announcement-card"
         @attributes="AdditionalAttributes">

        <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                @if (Announcement.IsNew)
                {
                    <span class="badge badge-success" data-testid="badge-new">Novo</span>
                }
                @if (!Announcement.IsRead)
                {
                    <span class="badge badge-info" data-testid="badge-unread">Não lido</span>
                }
                else
                {
                    <span class="badge badge-secondary" data-testid="badge-read">Lido</span>
                }
            </div>
            <small class="text-muted text-nowrap">
                @(Announcement.PublishedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
            </small>
        </div>

        <h2 class="widget-card__title mb-1" data-testid="announcement-title">
            <i class="bi bi-megaphone" aria-hidden="true"></i>
            @Announcement.Title
        </h2>

        <small class="text-muted d-block mb-3" data-testid="announcement-author">
            Por: <strong>@Announcement.AuthorName</strong>
        </small>

        <div class="announcement-card__content" data-testid="announcement-content">
            @if (IsExpanded || Announcement.Content.Length <= 200)
            {
                @Announcement.Content
            }
            else
            {
                @(Announcement.Content[..200])
                <span>… </span>
            }
        </div>

        @if (Announcement.Content.Length > 200)
        {
            <button type="button"
                    class="btn btn-link btn-sm p-0 mt-1"
                    @onclick="ToggleExpand"
                    data-testid="btn-expand">
                @(IsExpanded ? "Ver menos" : "Ver mais")
            </button>
        }

        @if (!string.IsNullOrWhiteSpace(Announcement.Tags))
        {
            <div class="mt-3 d-flex flex-wrap gap-1" data-testid="announcement-tags">
                @foreach (var tag in Announcement.Tags.Split(',', System.StringSplitOptions.RemoveEmptyEntries))
                {
                    <span class="badge badge-secondary">#@tag.Trim()</span>
                }
            </div>
        }

        @if (Announcement.ExpiresAtUtc.HasValue)
        {
            <small class="d-block mt-2 text-warning" data-testid="announcement-expiry">
                <i class="bi bi-clock me-1" aria-hidden="true"></i>
                Válido até: @Announcement.ExpiresAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy")
            </small>
        }

        @if (!Announcement.IsRead)
        {
            <div class="mt-3">
                <button type="button"
                        class="btn btn-sm btn-outline-success"
                        disabled="@_isMarkingRead"
                        @onclick="MarkAsReadAsync"
                        data-testid="btn-mark-read">
                    @if (_isMarkingRead)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    }
                    <i class="bi bi-check-lg me-1" aria-hidden="true"></i>
                    Marcar como lido
                </button>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public AnnouncementDto Announcement { get; set; } = null!;
    [Parameter] public EventCallback OnRead { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsExpanded { get; set; } = false;
    private bool _isMarkingRead = false;

    private void ToggleExpand() => IsExpanded = !IsExpanded;

    private async Task MarkAsReadAsync()
    {
        _isMarkingRead = true;
        await OnRead.InvokeAsync();
        _isMarkingRead = false;
    }
}
