@namespace BabaPlay.Web.Components.Communication
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@inject ICommunicationApiService CommunicationApiService

@if (IsOpen)
{
    <div class="modal-backdrop fade show app-modal-backdrop" data-testid="create-poll-backdrop"></div>
    <div class="modal fade show d-block app-modal" tabindex="-1" data-testid="create-poll-modal">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold">
                        <i class="bi bi-ui-checks-grid me-2" aria-hidden="true"></i>
                        Criar Nova Enquete
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseAsync" aria-label="Fechar" data-testid="btn-close-modal"></button>
                </div>

                <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync" data-testid="form-create-poll">
                    <DataAnnotationsValidator />

                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger p-2 small mb-3" role="alert" data-testid="modal-error-alert">
                                <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>
                                @ErrorMessage
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label filters-toolbar__label" for="input-poll-title">Título da Enquete *</label>
                            <InputText id="input-poll-title"
                                       class="form-control"
                                       placeholder="Ex: Qual o local preferido para o churrasco?"
                                       @bind-Value="Model.Title"
                                       data-testid="input-poll-title" />
                            <ValidationMessage For="() => Model.Title" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label filters-toolbar__label" for="input-poll-description">Descrição / Regras (Opcional)</label>
                            <InputTextArea id="input-poll-description"
                                           class="form-control"
                                           rows="2"
                                           placeholder="Ex: A opção mais votada até sexta-feira será a escolhida."
                                           @bind-Value="Model.Description"
                                           data-testid="input-poll-description" />
                            <ValidationMessage For="() => Model.Description" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label filters-toolbar__label" for="input-poll-expiry">Data de Encerramento (Opcional)</label>
                            <InputDate id="input-poll-expiry"
                                       class="form-control"
                                       @bind-Value="Model.ExpiresAtUtc"
                                       data-testid="input-poll-expiry" />
                        </div>

                        <div class="mb-1">
                            <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
                                <label class="form-label filters-toolbar__label mb-0">Opções de Escolha * (Mínimo 2)</label>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        @onclick="AddOptionInput"
                                        disabled="@(Model.Options.Count >= 10)"
                                        data-testid="btn-add-option-input">
                                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                                    Adicionar Opção
                                </button>
                            </div>

                            @for (var i = 0; i < Model.Options.Count; i++)
                            {
                                var index = i;
                                <div class="input-group mb-2" data-testid="option-input-group">
                                    <span class="input-group-text">@(index + 1)</span>
                                    <input class="form-control"
                                           placeholder="Descreva a opção..."
                                           value="@Model.Options[index]"
                                           @onchange="(e) => UpdateOptionText(index, e.Value?.ToString())"
                                           data-testid="input-option-text" />
                                    @if (Model.Options.Count > 2)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-danger"
                                                @onclick="() => RemoveOptionInput(index)"
                                                aria-label="Remover opção"
                                                data-testid="btn-remove-option">
                                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="CloseAsync"
                                disabled="@_isLoading"
                                data-testid="btn-cancel">
                            Cancelar
                        </button>
                        <button type="submit"
                                class="btn btn-success"
                                disabled="@_isLoading"
                                data-testid="btn-submit-poll">
                            @if (_isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Criando…</span>
                            }
                            else
                            {
                                <i class="bi bi-ui-checks-grid me-1" aria-hidden="true"></i>
                                <span>Criar Enquete</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; } = false;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<PollDto> OnCreated { get; set; }

    private CreatePollDto Model { get; set; } = new();
    private bool _isLoading = false;
    private string? ErrorMessage;

    private void AddOptionInput()
    {
        if (Model.Options.Count < 10)
        {
            Model.Options.Add("");
        }
    }

    private void RemoveOptionInput(int index)
    {
        if (Model.Options.Count > 2 && index >= 0 && index < Model.Options.Count)
        {
            Model.Options.RemoveAt(index);
        }
    }

    private void UpdateOptionText(int index, string? value)
    {
        if (index >= 0 && index < Model.Options.Count)
        {
            Model.Options[index] = value ?? "";
        }
    }

    private async Task HandleSubmitAsync()
    {
        var validOptions = Model.Options.Where(o => !string.IsNullOrWhiteSpace(o)).ToList();
        if (validOptions.Count < 2)
        {
            ErrorMessage = "Preencha pelo menos 2 opções distintas para a enquete.";
            return;
        }

        _isLoading = true;
        ErrorMessage = null;

        try
        {
            Model.Options = validOptions;
            var result = await CommunicationApiService.CreatePollAsync(Model);
            if (result is null)
            {
                ErrorMessage = "Não foi possível criar a enquete. Verifique os dados ou permissões.";
                return;
            }

            Model = new();
            await OnCreated.InvokeAsync(result);
            await OnClose.InvokeAsync();
        }
        catch
        {
            ErrorMessage = "Erro inesperado ao criar enquete. Tente novamente.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CloseAsync()
    {
        Model = new();
        ErrorMessage = null;
        await OnClose.InvokeAsync();
    }
}
