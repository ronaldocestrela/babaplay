@namespace BabaPlay.Web.Components.Communication
@using BabaPlay.Web.Models
@using BabaPlay.Web.Services.Http
@inject ICommunicationApiService CommunicationApiService

@if (IsOpen)
{
    <div class="modal-backdrop fade show" style="display: block; background: rgba(0,0,0,0.5);" data-testid="create-poll-backdrop"></div>
    <div class="modal fade show" tabindex="-1" style="display: block;" data-testid="create-poll-modal">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content" style="border-radius: 12px; border: none; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">

                <div class="modal-header" style="border-bottom: 1px solid var(--border-color, #e2e8f0);">
                    <h5 class="modal-title font-weight-bold" style="color: var(--text-main);">
                        📊 Criar Nova Enquete
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseAsync" aria-label="Fechar" data-testid="btn-close-modal"></button>
                </div>

                <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync" data-testid="form-create-poll">
                    <DataAnnotationsValidator />

                    <div class="modal-body p-4">

                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger mb-3" role="alert" data-testid="modal-error-alert">
                                ⚠️ @ErrorMessage
                            </div>
                        }

                        <!-- Título -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold" style="font-size: 0.85rem;">Título da Enquete *</label>
                            <InputText class="form-control form-control-sm"
                                       placeholder="Ex: Qual o local preferido para o churrasco?"
                                       @bind-Value="Model.Title"
                                       data-testid="input-poll-title" />
                            <ValidationMessage For="() => Model.Title" class="text-danger" style="font-size: 0.75rem;" />
                        </div>

                        <!-- Descrição -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold" style="font-size: 0.85rem;">Descrição / Regras (Opcional)</label>
                            <InputTextArea class="form-control form-control-sm"
                                          rows="2"
                                          placeholder="Ex: A opção mais votada até sexta-feira será a escolhida."
                                          @bind-Value="Model.Description"
                                          data-testid="input-poll-description" />
                            <ValidationMessage For="() => Model.Description" class="text-danger" style="font-size: 0.75rem;" />
                        </div>

                        <!-- Data Limite -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold" style="font-size: 0.85rem;">Data de Encerramento (Opcional)</label>
                            <InputDate class="form-control form-control-sm"
                                       @bind-Value="Model.ExpiresAtUtc"
                                       data-testid="input-poll-expiry" />
                        </div>

                        <!-- Opções Dinâmicas -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-semibold mb-0" style="font-size: 0.85rem;">Opções de Escolha * (Mínimo 2)</label>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary py-0"
                                        style="font-size: 0.78rem;"
                                        @onclick="AddOptionInput"
                                        disabled="@(Model.Options.Count >= 10)"
                                        data-testid="btn-add-option-input">
                                    + Adicionar Opção
                                </button>
                            </div>

                            @for (var i = 0; i < Model.Options.Count; i++)
                            {
                                var index = i;
                                <div class="input-group input-group-sm mb-2" data-testid="option-input-group">
                                    <span class="input-group-text" style="font-size: 0.8rem;">@(index + 1)</span>
                                    <input class="form-control"
                                           placeholder="Descreva a opção..."
                                           value="@Model.Options[index]"
                                           @onchange="(e) => UpdateOptionText(index, e.Value?.ToString())"
                                           data-testid="input-option-text" />
                                    @if (Model.Options.Count > 2)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-danger"
                                                @onclick="() => RemoveOptionInput(index)"
                                                data-testid="btn-remove-option">
                                            ✕
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                    </div>

                    <div class="modal-footer" style="border-top: 1px solid var(--border-color, #e2e8f0);">
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                @onclick="CloseAsync"
                                disabled="@_isLoading"
                                data-testid="btn-cancel">
                            Cancelar
                        </button>
                        <button type="submit"
                                class="btn btn-sm btn-success"
                                style="border-radius: 8px; min-width: 120px;"
                                disabled="@_isLoading"
                                data-testid="btn-submit-poll">
                            @if (_isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Criando…</span>
                            }
                            else
                            {
                                <span>📊 Criar Enquete</span>
                            }
                        </button>
                    </div>

                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; } = false;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<PollDto> OnCreated { get; set; }

    private CreatePollDto Model { get; set; } = new();
    private bool _isLoading = false;
    private string? ErrorMessage;

    private void AddOptionInput()
    {
        if (Model.Options.Count < 10)
        {
            Model.Options.Add("");
        }
    }

    private void RemoveOptionInput(int index)
    {
        if (Model.Options.Count > 2 && index >= 0 && index < Model.Options.Count)
        {
            Model.Options.RemoveAt(index);
        }
    }

    private void UpdateOptionText(int index, string? value)
    {
        if (index >= 0 && index < Model.Options.Count)
        {
            Model.Options[index] = value ?? "";
        }
    }

    private async Task HandleSubmitAsync()
    {
        var validOptions = Model.Options.Where(o => !string.IsNullOrWhiteSpace(o)).ToList();
        if (validOptions.Count < 2)
        {
            ErrorMessage = "Preencha pelo menos 2 opções distintas para a enquete.";
            return;
        }

        _isLoading = true;
        ErrorMessage = null;

        try
        {
            Model.Options = validOptions;
            var result = await CommunicationApiService.CreatePollAsync(Model);
            if (result is null)
            {
                ErrorMessage = "Não foi possível criar a enquete. Verifique os dados ou permissões.";
                return;
            }

            Model = new();
            await OnCreated.InvokeAsync(result);
            await OnClose.InvokeAsync();
        }
        catch
        {
            ErrorMessage = "Erro inesperado ao criar enquete. Tente novamente.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CloseAsync()
    {
        Model = new();
        ErrorMessage = null;
        await OnClose.InvokeAsync();
    }
}
