@namespace BabaPlay.Web.Components.Matches
@using BabaPlay.Web.Models

@if (IsOpen)
{
    <div class="modal-backdrop fade show app-modal-backdrop"></div>
    <div class="modal fade show d-block app-modal" tabindex="-1" data-testid="match-modal">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold">
                        <i class="bi bi-calendar-plus me-2" aria-hidden="true"></i>
                        @(IsEditing ? "Editar agendamento de baba" : "Novo agendamento de baba")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="OnClose" aria-label="Fechar" data-testid="btn-close-modal"></button>
                </div>
                <EditForm Model="Model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                        {
                            <div class="alert alert-danger p-2 small mb-3" role="alert" data-testid="modal-error-alert">
                                <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>
                                @ErrorMessage
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label filters-toolbar__label" for="match-modal-name">Nome do baba / evento</label>
                            <InputText id="match-modal-name" class="form-control" @bind-Value="Model.Name" placeholder="Ex: Baba de terça à noite" data-testid="input-match-name" />
                            <ValidationMessage For="() => Model.Name" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label filters-toolbar__label" for="match-modal-date">Data e hora</label>
                            <input id="match-modal-date"
                                   type="datetime-local"
                                   class="form-control"
                                   value="@Model.ScheduledAt.ToString("yyyy-MM-ddTHH:mm")"
                                   @onchange="OnScheduledAtChanged"
                                   data-testid="input-match-date" />
                            <ValidationMessage For="() => Model.ScheduledAt" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label filters-toolbar__label" for="match-modal-location">Local / arena</label>
                            <InputText id="match-modal-location" class="form-control" @bind-Value="Model.Location" placeholder="Ex: Arena Parque Esportivo — Campo 2" data-testid="input-match-location" />
                            <ValidationMessage For="() => Model.Location" class="text-danger small" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label filters-toolbar__label" for="match-modal-max-players">Vagas / limite de atletas</label>
                                <InputNumber id="match-modal-max-players" class="form-control" @bind-Value="Model.MaxPlayers" data-testid="input-match-max-players" />
                                <ValidationMessage For="() => Model.MaxPlayers" class="text-danger small" />
                            </div>
                            @if (!IsEditing)
                            {
                                <div class="col-md-6 mb-3">
                                    <label class="form-label filters-toolbar__label" for="match-modal-status">Status inicial</label>
                                    <InputSelect id="match-modal-status"
                                                 class="form-select"
                                                 @bind-Value="Model.Status"
                                                 data-testid="input-match-status">
                                        <option value="Confirmed">Agendado (aberto para confirmações)</option>
                                        <option value="Completed">Concluído (já realizado / histórico)</option>
                                        <option value="Pending">Pendente (rascunho)</option>
                                    </InputSelect>
                                    <ValidationMessage For="() => Model.Status" class="text-danger small" />
                                </div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label filters-toolbar__label" for="match-modal-description">Observações / regras</label>
                            <InputTextArea id="match-modal-description" class="form-control" @bind-Value="Model.Description" rows="3" placeholder="Instruções para os atletas (ex: chegar 15 min antes)" data-testid="input-match-description" />
                            <ValidationMessage For="() => Model.Description" class="text-danger small" />
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="OnClose" data-testid="btn-cancel-modal">Cancelar</button>
                        <button type="submit" class="btn btn-outline-primary" data-testid="btn-save-match">
                            @(IsEditing ? "Salvar alterações" : (Model.ScheduledAt < DateTime.Now ? "Registrar histórico" : "Agendar baba"))
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public ScheduleGameDayDto Model { get; set; } = new();
    [Parameter] public EventCallback<ScheduleGameDayDto> OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string? ErrorMessage { get; set; }

    private void OnScheduledAtChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var parsedDate))
        {
            Model.ScheduledAt = parsedDate;
        }
    }

    private async Task HandleSubmit()
    {
        ErrorMessage = null;

        if (Model.ScheduledAt < DateTime.Now.AddYears(-10))
        {
            ErrorMessage = "A data e hora do agendamento não podem ser anteriores a 10 anos.";
            return;
        }

        await OnSave.InvokeAsync(Model);
    }
}
