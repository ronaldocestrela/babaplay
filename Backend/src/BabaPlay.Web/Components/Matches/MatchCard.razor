@namespace BabaPlay.Web.Components.Matches
@using BabaPlay.Web.Models

<div class="match-card card card-custom shadow-sm h-100 p-3" data-testid="match-card-@Match.Id">
    <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
            <h3 class="h6 font-weight-bold mb-1 text-dark" data-testid="match-title">
                @(string.IsNullOrWhiteSpace(Match.GameDayName) ? "Baba Sem Nome" : Match.GameDayName)
            </h3>
            <div class="text-muted small">
                <i class="bi bi-calendar-event me-1"></i> @Match.ScheduledAt.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>
        <span class="badge @GetStatusBadgeClass(Match.Status)" data-testid="match-status-badge">
            @GetStatusDisplayName(Match.Status)
        </span>
    </div>

    <div class="match-details my-2 small">
        @if (!string.IsNullOrWhiteSpace(Match.Location))
        {
            <div class="text-secondary mb-1">
                <i class="bi bi-geo-alt-fill me-1 text-danger"></i> @Match.Location
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Match.HomeTeamName) && !string.IsNullOrWhiteSpace(Match.AwayTeamName))
        {
            <div class="fw-bold my-2 p-2 bg-light rounded text-center">
                <span>@Match.HomeTeamName</span>
                <span class="text-muted mx-2">VS</span>
                <span>@Match.AwayTeamName</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Match.Description))
        {
            <div class="text-muted italic text-truncate mb-2" title="@Match.Description">
                @Match.Description
            </div>
        }
    </div>

    <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
        <div class="vagas-count small text-muted">
            <i class="bi bi-people-fill me-1"></i>
            <span class="fw-bold text-dark">@Match.ConfirmedCount</span> / @Match.MaxPlayers vagas
        </div>

        <div class="match-actions btn-group btn-group-sm">
            <button class="btn btn-outline-primary btn-edit-match" @onclick="() => OnEdit.InvokeAsync(Match)" title="Editar Partida" data-testid="btn-edit-match">
                <i class="bi bi-pencil"></i>
            </button>
            <button class="btn btn-outline-secondary btn-status-match" @onclick="() => OnChangeStatus.InvokeAsync(Match)" title="Alterar Status" data-testid="btn-status-match">
                <i class="bi bi-arrow-repeat"></i>
            </button>
            <button class="btn btn-outline-danger btn-delete-match" @onclick="() => OnDelete.InvokeAsync(Match)" title="Excluir Partida" data-testid="btn-delete-match">
                <i class="bi bi-trash"></i>
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public MatchDto Match { get; set; } = null!;
    [Parameter] public EventCallback<MatchDto> OnEdit { get; set; }
    [Parameter] public EventCallback<MatchDto> OnChangeStatus { get; set; }
    [Parameter] public EventCallback<MatchDto> OnDelete { get; set; }

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "Pending" => "bg-warning text-dark",
        "Scheduled" or "Confirmed" => "bg-primary text-white",
        "InProgress" => "bg-info text-white",
        "Completed" => "bg-success text-white",
        "Cancelled" => "bg-danger text-white",
        _ => "bg-secondary text-white"
    };

    private static string GetStatusDisplayName(string status) => status switch
    {
        "Pending" => "Pendente",
        "Scheduled" or "Confirmed" => "Agendado",
        "InProgress" => "Em Andamento",
        "Completed" => "Concluído",
        "Cancelled" => "Cancelado",
        _ => status
    };
}
