@namespace BabaPlay.Web.Components.Matches
@using BabaPlay.Web.Models

<div class="match-card" data-testid="match-card-@Match.Id">
    <div class="match-card__header">
        <div>
            <h3 class="match-card__title" data-testid="match-title">
                @(string.IsNullOrWhiteSpace(Match.GameDayName) ? "Baba sem nome" : Match.GameDayName)
            </h3>
            <div class="match-card__datetime text-muted small">
                <i class="bi bi-calendar-event me-1" aria-hidden="true"></i>
                @Match.ScheduledAt.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>
        <span class="badge @GetStatusBadgeClass(Match.Status)" data-testid="match-status-badge">
            @GetStatusDisplayName(Match.Status)
        </span>
    </div>

    <div class="match-card__body">
        @if (!string.IsNullOrWhiteSpace(Match.Location))
        {
            <div class="match-card__location text-muted small mb-2">
                <i class="bi bi-geo-alt me-1" aria-hidden="true"></i> @Match.Location
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Match.HomeTeamName) && !string.IsNullOrWhiteSpace(Match.AwayTeamName))
        {
            <div class="match-card__versus">
                <span>@Match.HomeTeamName</span>
                <span class="match-card__versus-sep">vs</span>
                <span>@Match.AwayTeamName</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Match.Description))
        {
            <p class="match-card__description text-muted small mb-0" title="@Match.Description">
                @Match.Description
            </p>
        }
    </div>

    <div class="match-card__footer">
        <div class="vagas-count small text-muted">
            <i class="bi bi-people-fill me-1" aria-hidden="true"></i>
            <span class="font-weight-bold">@Match.ConfirmedCount</span> / @Match.MaxPlayers vagas
        </div>

        <div class="match-actions btn-group btn-group-sm">
            <button class="btn btn-outline-primary btn-edit-match"
                    @onclick="() => OnEdit.InvokeAsync(Match)"
                    title="Editar partida"
                    aria-label="Editar partida"
                    data-testid="btn-edit-match">
                <i class="bi bi-pencil" aria-hidden="true"></i>
            </button>
            <button class="btn @(Match.Status == "Pending" ? "btn-outline-success" : "btn-outline-secondary") btn-status-match"
                    @onclick="() => OnChangeStatus.InvokeAsync(Match)"
                    title="@GetStatusActionTitle(Match.Status)"
                    aria-label="@GetStatusActionTitle(Match.Status)"
                    data-testid="btn-status-match">
                <i class="bi @(Match.Status == "Pending" ? "bi-check-circle" : "bi-arrow-repeat")" aria-hidden="true"></i>
            </button>
            <button class="btn btn-outline-danger btn-delete-match"
                    @onclick="() => OnDelete.InvokeAsync(Match)"
                    title="Excluir partida"
                    aria-label="Excluir partida"
                    data-testid="btn-delete-match">
                <i class="bi bi-trash" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public MatchDto Match { get; set; } = null!;
    [Parameter] public EventCallback<MatchDto> OnEdit { get; set; }
    [Parameter] public EventCallback<MatchDto> OnChangeStatus { get; set; }
    [Parameter] public EventCallback<MatchDto> OnDelete { get; set; }

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "Pending" => "badge-warning",
        "Scheduled" or "Confirmed" => "badge-primary",
        "InProgress" => "badge-info",
        "Completed" => "badge-success",
        "Cancelled" => "badge-danger",
        _ => "badge-secondary"
    };

    private static string GetStatusDisplayName(string status) => status switch
    {
        "Pending" => "Pendente",
        "Scheduled" or "Confirmed" => "Agendado",
        "InProgress" => "Em andamento",
        "Completed" => "Concluído",
        "Cancelled" => "Cancelado",
        _ => status
    };

    private static string GetStatusActionTitle(string status) => status switch
    {
        "Pending" => "Confirmar agendamento",
        "Confirmed" => "Marcar como concluído",
        _ => "Alterar status"
    };
}
