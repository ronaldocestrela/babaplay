@namespace BabaPlay.Web.Components.Matches

<div class="match-list-skeleton" data-testid="match-list-skeleton" aria-hidden="true">
    <div class="widget-card mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-md-6">
                <div class="d-flex gap-2 flex-wrap">
                    @for (var i = 0; i < 4; i++)
                    {
                        <div class="skeleton skeleton-badge"></div>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <div class="skeleton skeleton-line"></div>
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @for (var i = 0; i < 6; i++)
        {
            <div class="col">
                <div class="match-card match-card--skeleton">
                    <div class="skeleton skeleton-line mb-2"></div>
                    <div class="skeleton skeleton-line skeleton-line--short mb-3"></div>
                    <div class="skeleton skeleton-line skeleton-line--tiny mb-2"></div>
                    <div class="skeleton skeleton-line skeleton-line--tiny mb-3"></div>
                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <div class="skeleton skeleton-line skeleton-line--tiny"></div>
                        <div class="skeleton skeleton-button"></div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
